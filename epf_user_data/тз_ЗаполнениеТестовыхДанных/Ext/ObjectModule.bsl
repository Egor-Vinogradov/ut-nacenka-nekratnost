// Стенд для проверки расширения ТестовоеЗаданиеПользователь.
// Фрагменты видов цен, установки цен, сегментов, соглашений и покупателей
// взяты из полного расширения, команда «тз Заполнить уровни и цены»
// (тз_УровниПокупателейСервер). Виды номенклатуры и единица «шт» — из
// «тз Настроить наценку за некратность», без упаковок. Остаток, перемещение в зал
// и розничная цена РМК дописываются здесь: вид цен берётся так же, как в полном
// расширении (индивидуальный вид цен формата или склада, иначе розничный).
// Объекты расширения вызываются по имени: внешняя обработка собирается
// в контексте основной конфигурации, прямые имена расширения там не компилируются.
// Первоначальная настройка не копируется: это тз_НаценкаЗаНекратностьВызовСервера.ПервоначальнаяНастройка.

#Область ПрограммныйИнтерфейс

// Идемпотентно готовит стенд. «Обновлено» и «создано» только при фактической записи.
//
// Параметры:
//  ВыполнитьНастройку - Булево - вызвать первоначальную настройку, если она ещё не выполнена.
//
// Возвращаемое значение:
//  Строка - протокол. Отказ до записи данных начинается с «Отказ.».
//
Функция ЗаполнитьДанные(ВыполнитьНастройку) Экспорт
	
	ТекстОтказа = ТекстОтказаДоЗаполнения();
	Если Не ПустаяСтрока(ТекстОтказа) Тогда
		Возврат ТекстОтказа;
	КонецЕсли;
	
	Протокол = Новый Массив;
	ВыполнитьПервоначальнуюНастройку(ВыполнитьНастройку, Протокол);
	
	Штука = ОбеспечитьШтуку(Протокол);
	ВидОбои = ОбеспечитьВидНоменклатуры("Обои (тест)", Штука, Протокол);
	ВидОтходы = ОбеспечитьВидНоменклатуры("Брак и отходы (тест)", Штука, Протокол);
	Если ЗначениеЗаполнено(ВидОбои) Тогда
		ОбеспечитьНоменклатуру("Обои тест", ВидОбои, Протокол);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидОтходы) Тогда
		ОбеспечитьНоменклатуру("Отходы тест", ВидОтходы, Протокол);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидОбои) Тогда
		ЗаписатьКратность(ВидОбои, 4, Протокол);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидОтходы) Тогда
		УдалитьКратность(ВидОтходы, Протокол);
	КонецЕсли;
	
	Валюта = ВалютаРубль(Протокол);
	Бронза = УровеньПоИмени("Бронзовый");
	Серебро = УровеньПоИмени("Серебряный");
	Золото = УровеньПоИмени("Золотой");
	
	ВидБронза = ОбеспечитьВидЦены("Бронзовая (тест)", "tzTestBronze", Валюта, Протокол);
	ВидСеребро = ОбеспечитьВидЦены("Серебряная (тест)", "tzTestSilver", Валюта, Протокол);
	ВидЗолото = ОбеспечитьВидЦены("Золотая (тест)", "tzTestGold", Валюта, Протокол);
	УстановитьЦены(ВидБронза, ВидСеребро, ВидЗолото, Валюта, Протокол);
	
	СегментБронза = ОбеспечитьСегмент("Бронзовые (тест)", Протокол);
	СегментСеребро = ОбеспечитьСегмент("Серебряные (тест)", Протокол);
	СегментЗолото = ОбеспечитьСегмент("Золотые (тест)", Протокол);
	
	Организация = ОрганизацияСтенда(Протокол);
	СоглашениеБронза = ОбеспечитьСоглашение("Бронзовое (тест)", ВидБронза, СегментБронза, Валюта, Организация, Протокол);
	СоглашениеСеребро = ОбеспечитьСоглашение("Серебряное (тест)", ВидСеребро, СегментСеребро, Валюта, Организация, Протокол);
	СоглашениеЗолото = ОбеспечитьСоглашение("Золотое (тест)", ВидЗолото, СегментЗолото, Валюта, Организация, Протокол);
	
	ЗаписатьСсылкиУровня(Бронза, СоглашениеБронза, ВидБронза, Протокол);
	ЗаписатьСсылкиУровня(Серебро, СоглашениеСеребро, ВидСеребро, Протокол);
	ЗаписатьСсылкиУровня(Золото, СоглашениеЗолото, ВидЗолото, Протокол);
	
	ЗаписатьУровеньИНН("7701000033", Золото, Протокол);
	Протокол.Добавить("ИНН 7701000019 в регистр не пишется: нового клиента без строки ИНН расширение оставляет бронзовым.");
	
	ОбеспечитьПокупателя("Клиент Золото (тест)", "7701000033", Золото, Протокол);
	ОбеспечитьПокупателя("Клиент Бронза (тест)", "7701000019", Бронза, Протокол);
	
	ОбеспечитьОстаткиИРозничнуюЦену(Организация, Валюта, Протокол);
	
	Протокол.Добавить("Если в базе есть другие автоматические скидки, выполните «тз Наценка поверх скидок (перестроить группы)».");
	Протокол.Добавить("РМК: рабочее место настраивается вручную. Настройки РМК → рабочее место текущего сеанса → касса «Фискальный регистратор (Торговый зал)», оборудование — эмулятор ККТ.");
	
	Возврат СтрСоединить(Протокол, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстОтказаДоЗаполнения()
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат "Отказ. Заполнение доступно только полноправному пользователю. Войдите под пользователем с полными правами.";
	КонецЕсли;
	
	ИмяРасширения = "ТестовоеЗаданиеПользователь";
	Найдено = Ложь;
	Активно = Ложь;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Если Расширение.Имя = ИмяРасширения Тогда
			Найдено = Истина;
			Активно = Расширение.Активно;
		КонецЕсли;
	КонецЦикла;
	
	Если Не Найдено Тогда
		Возврат "Отказ. Расширение ТестовоеЗаданиеПользователь к этой базе не подключено.";
	КонецЕсли;
	Если Не Активно Тогда
		Возврат "Отказ. Расширение ТестовоеЗаданиеПользователь подключено, но не активно.";
	КонецЕсли;
	
	Если Метаданные.ОбщиеМодули.Найти("тз_НаценкаЗаНекратностьВызовСервера") = Неопределено
		Или Метаданные.РегистрыСведений.Найти("тз_КратностьПродажи") = Неопределено
		Или Метаданные.РегистрыСведений.Найти("тз_СоглашенияУровней") = Неопределено
		Или Метаданные.Перечисления.Найти("тз_УровниПокупателей") = Неопределено Тогда
		Возврат "Отказ. Объекты расширения ТестовоеЗаданиеПользователь в метаданных не найдены. Проверьте, что расширение активно.";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ВыполнитьПервоначальнуюНастройку(ВыполнитьНастройку, Протокол)
	
	Если Не ВыполнитьНастройку Тогда
		Протокол.Добавить("Первоначальная настройка: пропущена флажком.");
		Возврат;
	КонецЕсли;
	
	Если ПервоначальнаяНастройкаВыполнена() Тогда
		Протокол.Добавить("Первоначальная настройка: без изменений.");
		Возврат;
	КонецЕсли;
	
	Попытка
		// Та же экспортная функция, что у команды «тз Первоначальная настройка».
		МодульНаценки = ОбщегоНазначения.ОбщийМодуль("тз_НаценкаЗаНекратностьВызовСервера");
		Протокол.Добавить(МодульНаценки.ПервоначальнаяНастройка());
	Исключение
		Протокол.Добавить("Первоначальная настройка: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ПервоначальнаяНастройкаВыполнена()
	
	Попытка
		Если Константы.ИспользоватьАвтоматическиеСкидкиВПродажах.Получить() <> Истина Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Константы.тз_ПроцентНаценкиЗаНекратность.Получить()) Тогда
			Возврат Ложь;
		КонецЕсли;
		Скидка = Константы.тз_СкидкаНаценкаЗаНекратность.Получить();
		Если Не ЗначениеЗаполнено(Скидка) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НайтиОбработкуНаценки()) Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат ДействиеСкидкиУжеЕсть(Скидка);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция НайтиОбработкуНаценки()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбъекта", "тз_РасчетНаценкиЗаНекратность");
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обработки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
	|ГДЕ
	|	Обработки.ИмяОбъекта = &ИмяОбъекта
	|	И НЕ Обработки.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	
КонецФункции

Функция ДействиеСкидкиУжеЕсть(Скидка)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("СкидкаНаценка", Скидка);
	Запрос.УстановитьПараметр("Источник", Справочники.Склады.ПустаяСсылка());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Срез.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ДействиеСкидокНаценок.СрезПоследних(
	|			&ТекущаяДата,
	|			СкидкаНаценка = &СкидкаНаценка
	|				И Источник = &Источник) КАК Срез";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий() И Выборка.Статус = Перечисления.СтатусыДействияСкидок.Действует;
	
КонецФункции

Функция УровеньПоИмени(ИмяЗначения)
	
	Если ИмяЗначения <> "Бронзовый" И ИмяЗначения <> "Серебряный" И ИмяЗначения <> "Золотой" Тогда
		ВызватьИсключение "Неизвестное имя уровня: " + ИмяЗначения;
	КонецЕсли;
	Возврат Вычислить("Перечисления.тз_УровниПокупателей." + ИмяЗначения);
	
КонецФункции

Функция МодульУровней()
	
	Возврат ОбщегоНазначения.ОбщийМодуль("тз_УровниПокупателейСервер");
	
КонецФункции

Функция РегистрРасширения(Имя)
	
	Возврат РегистрыСведений[Имя];
	
КонецФункции

Функция СтатусЗаписи(ЭтоНовый, Изменено)
	
	Если Не Изменено Тогда
		Возврат "без изменений";
	ИначеЕсли ЭтоНовый Тогда
		Возврат "создано";
	КонецЕсли;
	Возврат "обновлено";
	
КонецФункции

Функция УстановитьРеквизит(Объект, Имя, Значение)
	
	Если Объект[Имя] <> Значение Тогда
		Объект[Имя] = Значение;
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

Функция ОбеспечитьШтуку(Протокол)
	
	Штука = НайтиШтуку();
	Если ЗначениеЗаполнено(Штука) Тогда
		Протокол.Добавить("Единица «шт»: без изменений.");
		Возврат Штука;
	КонецЕсли;
	
	Попытка
		Объект = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
		Объект.Владелец = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения;
		Объект.Наименование = "шт";
		Объект.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
		Объект.Записать();
		Протокол.Добавить("Единица «шт»: создано.");
		Возврат Объект.Ссылка;
	Исключение
		Протокол.Добавить("Единица «шт»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция НайтиШтуку()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Единицы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК Единицы
	|ГДЕ
	|	Единицы.Владелец = &Владелец
	|	И НЕ Единицы.ПометкаУдаления
	|	И Единицы.ТипИзмеряемойВеличины <> ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Упаковка)
	|	И (Единицы.Наименование = ""шт""
	|		ИЛИ Единицы.Наименование = ""Штука"")";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	
КонецФункции

Функция ОбеспечитьВидНоменклатуры(Наименование, Единица, Протокол)
	
	Если Не ЗначениеЗаполнено(Единица) Тогда
		Протокол.Добавить("Вид номенклатуры «" + Наименование + "»: пропуск, нет единицы «шт».");
		Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		Ссылка = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(Наименование, Истина);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		НеИспользоватьКлюч = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
		Изменено = ЭтоНовый;
		Изменено = УстановитьРеквизит(Объект, "Наименование", Наименование) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ТипНоменклатуры", Перечисления.ТипыНоменклатуры.Товар) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ИспользованиеХарактеристик",
			Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВариантОформленияПродажи",
			Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ЕдиницаИзмерения", Единица) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ЕдиницаДляОтчетов", Единица) Или Изменено;
		// ПередЗаписью вида обнуляет коэффициент, когда единица отчётов совпадает с единицей хранения.
		Если Объект.ЕдиницаДляОтчетов <> Объект.ЕдиницаИзмерения Тогда
			Изменено = УстановитьРеквизит(Объект, "КоэффициентЕдиницыДляОтчетов", 1) Или Изменено;
		КонецЕсли;
		Изменено = УстановитьРеквизит(Объект, "ИспользоватьУпаковки", Ложь) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ИспользоватьСерии", Ложь) Или Изменено;
		// Исправление 6 этапа 4: пустой ключ даёт NULL в запросе цены, срез с пустой характеристикой не находится.
		Изменено = УстановитьРеквизит(Объект, "НастройкиКлючаЦенПоХарактеристике", НеИспользоватьКлюч) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "НастройкиКлючаЦенПоСерии", НеИспользоватьКлюч) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "НастройкиКлючаЦенПоУпаковке", НеИспользоватьКлюч) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "СтавкаНДС", УчетНДСУП.СтавкаНДСОсновнойСтраны()) Или Изменено;
		
		Если Справочники.ГруппыДоступаНоменклатуры.ИспользуютсяГруппыДоступа()
			И Не ЗначениеЗаполнено(Объект.ГруппаДоступа) Тогда
			ГруппаДоступа = Справочники.ГруппыДоступаНоменклатуры.ПолучитьГруппуДоступаПоУмолчанию(Объект);
			Если ЗначениеЗаполнено(ГруппаДоступа) Тогда
				Объект.ГруппаДоступа = ГруппаДоступа;
				Изменено = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если Изменено Тогда
			Объект.Записать();
			Протокол.Добавить("Вид номенклатуры «" + Наименование + "»: " + СтатусЗаписи(ЭтоНовый, Истина) + ".");
			Возврат Объект.Ссылка;
		КонецЕсли;
		
		Протокол.Добавить("Вид номенклатуры «" + Наименование + "»: без изменений.");
		Возврат Ссылка;
	Исключение
		Протокол.Добавить("Вид номенклатуры «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Процедура ОбеспечитьНоменклатуру(Наименование, Вид, Протокол)
	
	Попытка
		Ссылка = Справочники.Номенклатура.НайтиПоНаименованию(Наименование, Истина);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если Не ЭтоНовый Тогда
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "НаименованиеПолное, ВидНоменклатуры, ЭтоГруппа");
			Если Не Реквизиты.ЭтоГруппа
				И Реквизиты.НаименованиеПолное = Наименование
				И Реквизиты.ВидНоменклатуры = Вид Тогда
				Протокол.Добавить("Номенклатура «" + Наименование + "»: без изменений.");
				Возврат;
			КонецЕсли;
			Объект = Ссылка.ПолучитьОбъект();
		Иначе
			Объект = Справочники.Номенклатура.СоздатьЭлемент();
		КонецЕсли;
		
		Объект.Наименование = Наименование;
		Объект.НаименованиеПолное = Наименование;
		Объект.ВидНоменклатуры = Вид;
		Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Объект);
		Объект.Записать();
		Протокол.Добавить("Номенклатура «" + Наименование + "»: " + СтатусЗаписи(ЭтоНовый, Истина) + ".");
	Исключение
		Протокол.Добавить("Номенклатура «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьКратность(Вид, Кратность, Протокол)
	
	Попытка
		Менеджер = РегистрРасширения("тз_КратностьПродажи").СоздатьМенеджерЗаписи();
		Менеджер.ВидНоменклатуры = Вид;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() И Менеджер.Кратность = Кратность Тогда
			Протокол.Добавить("Кратность «" + Вид + "»: без изменений, " + Кратность + ".");
			Возврат;
		КонецЕсли;
		ЭтоНовый = Не Менеджер.Выбран();
		Менеджер.ВидНоменклатуры = Вид;
		Менеджер.Кратность = Кратность;
		Менеджер.Записать();
		Протокол.Добавить("Кратность «" + Вид + "»: " + СтатусЗаписи(ЭтоНовый, Истина) + ", " + Кратность + ".");
	Исключение
		Протокол.Добавить("Кратность «" + Вид + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьКратность(Вид, Протокол)
	
	Попытка
		Менеджер = РегистрРасширения("тз_КратностьПродажи").СоздатьМенеджерЗаписи();
		Менеджер.ВидНоменклатуры = Вид;
		Менеджер.Прочитать();
		Если Не Менеджер.Выбран() Тогда
			Протокол.Добавить("Кратность «" + Вид + "»: без изменений, записи нет.");
			Возврат;
		КонецЕсли;
		Менеджер.Удалить();
		Протокол.Добавить("Кратность «" + Вид + "»: обновлено, запись удалена.");
	Исключение
		Протокол.Добавить("Кратность «" + Вид + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ВалютаРубль(Протокол)
	
	Ссылка = Справочники.Валюты.НайтиПоКоду("643");
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Ссылка = Справочники.Валюты.НайтиПоНаименованию("RUB", Истина);
	КонецЕсли;
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Протокол.Добавить("Валюта: " + Ссылка + " (RUB, код 643).");
		Возврат Ссылка;
	КонецЕсли;
	Протокол.Добавить("Валюта RUB: не найдена, виды цен и соглашения не заполняются.");
	Возврат Справочники.Валюты.ПустаяСсылка();
	
КонецФункции

Функция ОбеспечитьВидЦены(Наименование, Идентификатор, Валюта, Протокол)
	
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Протокол.Добавить("Вид цен «" + Наименование + "»: пропуск, нет валюты RUB.");
		Возврат Справочники.ВидыЦен.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		Ссылка = Справочники.ВидыЦен.НайтиПоНаименованию(Наименование, Истина);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.ВидыЦен.СоздатьЭлемент();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Изменено = ЭтоНовый;
		Изменено = УстановитьРеквизит(Объект, "Наименование", Наименование) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Идентификатор", Идентификатор) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "СпособЗаданияЦены", Перечисления.СпособыЗаданияЦен.Вручную) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "БазовыйВидЦены", Справочники.ВидыЦен.ПустаяСсылка()) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Наценка", 0) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Статус", Перечисления.СтатусыДействияВидовЦен.Действует) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВалютаЦены", Валюта) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ИспользоватьПриПродаже", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ИспользоватьПриОптовойПродаже", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ИспользоватьПриРозничнойПродаже", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВспомогательнаяЦена", Ложь) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "УстанавливатьЦенуПриВводеНаОсновании", Ложь) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Округлять", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВариантОкругления", Перечисления.ВариантыОкругления.ПоАрифметическимПравилам) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ТочностьОкругления", 0.01) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ЦенаВключаетНДС", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "СхемаКомпоновкиДанных", "Типовой") Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВариантУказанияСтавокНДС",
			Перечисления.ВариантыУказанияСтавокНДСВПрайсЛисте.НеУказыватьСтавкиНДС) Или Изменено;
		
		Если ПравилаОкругленияОтличаются(Объект) Тогда
			Объект.ПравилаОкругленияЦены.Очистить();
			Правило = Объект.ПравилаОкругленияЦены.Добавить();
			Правило.НижняяГраницаДиапазонаЦен = 0;
			Правило.ТочностьОкругления = 0.01;
			Правило.ПсихологическоеОкругление = 0;
			Изменено = Истина;
		КонецЕсли;
		
		Если Объект.ВлияющиеВидыЦен.Количество() > 0 Тогда
			Объект.ВлияющиеВидыЦен.Очистить();
			Изменено = Истина;
		КонецЕсли;
		
		Если Изменено Тогда
			Объект.Записать();
			Протокол.Добавить("Вид цен «" + Наименование + "»: " + СтатусЗаписи(ЭтоНовый, Истина) + ".");
			Возврат Объект.Ссылка;
		КонецЕсли;
		
		Протокол.Добавить("Вид цен «" + Наименование + "»: без изменений.");
		Возврат Ссылка;
	Исключение
		Протокол.Добавить("Вид цен «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.ВидыЦен.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция ПравилаОкругленияОтличаются(Объект)
	
	Если Объект.ПравилаОкругленияЦены.Количество() <> 1 Тогда
		Возврат Истина;
	КонецЕсли;
	Правило = Объект.ПравилаОкругленияЦены[0];
	Возврат Правило.НижняяГраницаДиапазонаЦен <> 0
		Или Правило.ТочностьОкругления <> 0.01
		Или Правило.ПсихологическоеОкругление <> 0;
	
КонецФункции

Процедура УстановитьЦены(ВидБронза, ВидСеребро, ВидЗолото, Валюта, Протокол)
	
	Если Не ЗначениеЗаполнено(ВидБронза) Или Не ЗначениеЗаполнено(ВидСеребро) Или Не ЗначениеЗаполнено(ВидЗолото) Тогда
		Протокол.Добавить("Цены: пропуск, вид цен не создан.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Протокол.Добавить("Цены: пропуск, нет валюты RUB.");
		Возврат;
	КонецЕсли;
	
	Имена = Новый Массив;
	Имена.Добавить("Обои тест");
	Имена.Добавить("Отходы тест");
	
	Номенклатура = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Ссылка = Справочники.Номенклатура.НайтиПоНаименованию(Имя, Истина);
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Протокол.Добавить("Цены: нет номенклатуры «" + Имя + "».");
			Возврат;
		КонецЕсли;
		Номенклатура.Добавить(Ссылка);
	КонецЦикла;
	
	ВыровнятьКлючиЦенообразования(Номенклатура, Протокол);
	
	Цены = Новый Массив;
	ДобавитьЦену(Цены, Номенклатура, ВидБронза, ОкруглитьЦенуВида(1000, ВидБронза));
	ДобавитьЦену(Цены, Номенклатура, ВидСеребро, ОкруглитьЦенуВида(930, ВидСеребро));
	ДобавитьЦену(Цены, Номенклатура, ВидЗолото, ОкруглитьЦенуВида(850, ВидЗолото));
	
	Если ЦеныУжеУстановлены(Цены) Тогда
		Протокол.Добавить("Цены: без изменений. Бронзовая (тест) 1000, Серебряная (тест) 930, Золотая (тест) 850.");
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗаписатьДокументЦен(Цены, Валюта);
		Протокол.Добавить("Цены: создано. Бронзовая (тест) 1000, Серебряная (тест) 930, Золотая (тест) 850.");
	Исключение
		Протокол.Добавить("Цены: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ОкруглитьЦенуВида(Цена, ВидЦены)
	
	Цена = Окр(Цена, 2);
	ОбъектВида = ВидЦены.ПолучитьОбъект();
	Возврат УстановкаЦенКлиентСервер.ОкруглитьЦену(Цена, ОбъектВида);
	
КонецФункции

Процедура ДобавитьЦену(Цены, Номенклатура, ВидЦены, Цена)
	
	Для Каждого Элемент Из Номенклатура Цикл
		Цены.Добавить(Новый Структура("Номенклатура, ВидЦены, Цена", Элемент, ВидЦены, Цена));
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыровнятьКлючиЦенообразования(Номенклатура, Протокол)
	
	НеИспользовать = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
	Виды = Новый Соответствие;
	Для Каждого Элемент Из Номенклатура Цикл
		Вид = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент, "ВидНоменклатуры");
		Если ЗначениеЗаполнено(Вид) Тогда
			Виды.Вставить(Вид, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлементВида Из Виды Цикл
		Попытка
			Объект = ЭлементВида.Ключ.ПолучитьОбъект();
			Изменено = УстановитьРеквизит(Объект, "НастройкиКлючаЦенПоХарактеристике", НеИспользовать);
			Изменено = УстановитьРеквизит(Объект, "НастройкиКлючаЦенПоСерии", НеИспользовать) Или Изменено;
			Изменено = УстановитьРеквизит(Объект, "НастройкиКлючаЦенПоУпаковке", НеИспользовать) Или Изменено;
			Если Изменено Тогда
				Объект.Записать();
				Протокол.Добавить("Ключи ценообразования вида «" + Объект.Наименование + "»: обновлено, Не использовать.");
			Иначе
				Протокол.Добавить("Ключи ценообразования вида «" + Объект.Наименование + "»: без изменений.");
			КонецЕсли;
		Исключение
			Протокол.Добавить("Ключи ценообразования: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Функция ЦеныУжеУстановлены(Цены)
	
	Ценообразование25 = ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25();
	Для Каждого СтрокаЦены Из Цены Цикл
		Текущая = ТекущаяЦена(СтрокаЦены.Номенклатура, СтрокаЦены.ВидЦены, Ценообразование25);
		Если Текущая = Неопределено Или Окр(Текущая - СтрокаЦены.Цена, 2) <> 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

Функция ТекущаяЦена(Номенклатура, ВидЦены, Ценообразование25)
	
	Запрос = Новый Запрос;
	Если Ценообразование25 Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Цены.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(
		|			,
		|			Номенклатура = &Номенклатура
		|				И ВидЦены = &ВидЦены
		|				И ХарактеристикаЦО = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)
		|				И СерияЦО = ЗНАЧЕНИЕ(Справочник.СерииНоменклатурыДляЦенообразования.ПустаяСсылка)
		|				И УпаковкаЦО = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК Цены";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Цены.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			,
		|			Номенклатура = &Номенклатура
		|				И ВидЦены = &ВидЦены
		|				И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Цены";
	КонецЕсли;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаписатьДокументЦен(Цены, Валюта)
	
	Документ = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Статус = Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован;
	Документ.Согласован = Истина;
	Документ.Комментарий = "тз Заполнение тестовых данных";
	Если Метаданные.Документы.УстановкаЦенНоменклатуры.Реквизиты.Найти("Ответственный") <> Неопределено Тогда
		Документ.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	Виды = Новый Массив;
	Ценообразование25 = ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25();
	Для Каждого СтрокаЦены Из Цены Цикл
		Если Виды.Найти(СтрокаЦены.ВидЦены) = Неопределено Тогда
			Виды.Добавить(СтрокаЦены.ВидЦены);
			СтрокаВида = Документ.ВидыЦен.Добавить();
			СтрокаВида.ВидЦены = СтрокаЦены.ВидЦены;
		КонецЕсли;
		Если Ценообразование25 Тогда
			СтрокаТовара = Документ.Товары2_5.Добавить();
			СтрокаТовара.Номенклатура = СтрокаЦены.Номенклатура;
			СтрокаТовара.ХарактеристикаЦО = Справочники.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка();
			СтрокаТовара.СерияЦО = Справочники.СерииНоменклатурыДляЦенообразования.ПустаяСсылка();
			СтрокаТовара.УпаковкаЦО = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
			СтрокаТовара.ВидЦены = СтрокаЦены.ВидЦены;
			СтрокаТовара.Цена = СтрокаЦены.Цена;
			СтрокаТовара.Валюта = Валюта;
			СтрокаТовара.ЦенаИзмененаВручную = Истина;
		Иначе
			СтрокаТовара = Документ.Товары.Добавить();
			СтрокаТовара.Номенклатура = СтрокаЦены.Номенклатура;
			СтрокаТовара.ВидЦены = СтрокаЦены.ВидЦены;
			СтрокаТовара.Цена = СтрокаЦены.Цена;
			СтрокаТовара.Валюта = Валюта;
			СтрокаТовара.ЦенаИзмененаВручную = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Функция ОбеспечитьСегмент(Наименование, Протокол)
	
	Попытка
		Ссылка = Справочники.СегментыПартнеров.НайтиПоНаименованию(Наименование, Истина);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.СегментыПартнеров.СоздатьЭлемент();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		Изменено = ЭтоНовый;
		Изменено = УстановитьРеквизит(Объект, "Наименование", Наименование) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "СпособФормирования",
			Перечисления.СпособыФормированияСегментов.ФормироватьВручную) Или Изменено;
		Если Изменено Тогда
			Объект.Записать();
			Протокол.Добавить("Сегмент «" + Наименование + "»: " + СтатусЗаписи(ЭтоНовый, Истина) + ".");
			Возврат Объект.Ссылка;
		КонецЕсли;
		Протокол.Добавить("Сегмент «" + Наименование + "»: без изменений.");
		Возврат Ссылка;
	Исключение
		Протокол.Добавить("Сегмент «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.СегментыПартнеров.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция ОрганизацияСтенда(Протокол)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|	И Организации.Наименование ПОДОБНО ""%Комплексный%""";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Протокол.Добавить("Организация: " + Выборка.Ссылка + ".");
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Протокол.Добавить("Организация: " + Выборка.Ссылка + ". Торговый дом «Комплексный» не найден, взята первая без пометки удаления.");
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Протокол.Добавить("Организация: не найдена, соглашения не заполняются.");
	Возврат Справочники.Организации.ПустаяСсылка();
	
КонецФункции

Функция ОбеспечитьСоглашение(Наименование, ВидЦен, Сегмент, Валюта, Организация, Протокол)
	
	Если Не ЗначениеЗаполнено(ВидЦен) Или Не ЗначениеЗаполнено(Сегмент) Или Не ЗначениеЗаполнено(Валюта) Тогда
		Протокол.Добавить("Соглашение «" + Наименование + "»: пропуск, нет вида цен, сегмента или валюты.");
		Возврат Справочники.СоглашенияСКлиентами.ПустаяСсылка();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Протокол.Добавить("Соглашение «" + Наименование + "»: пропуск, нет организации.");
		Возврат Справочники.СоглашенияСКлиентами.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		Ссылка = Справочники.СоглашенияСКлиентами.НайтиПоНаименованию(Наименование, Истина);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.СоглашенияСКлиентами.СоздатьЭлемент();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Изменено = ЭтоНовый;
		Изменено = УстановитьРеквизит(Объект, "Наименование", Наименование) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Типовое", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ХозяйственнаяОперация",
			Перечисления.ХозяйственныеОперации.РеализацияКлиенту) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Статус", Перечисления.СтатусыСоглашенийСКлиентами.Действует) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Валюта", Валюта) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВалютаВзаиморасчетов", Валюта) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ИспользуютсяДоговорыКонтрагентов", Ложь) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ПорядокРасчетов", Перечисления.ПорядокРасчетов.ПоЗаказамНакладным) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВидЦен", ВидЦен) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ИндивидуальныйВидЦены", Справочники.ВидыЦен.ПустаяСсылка()) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "СегментПартнеров", Сегмент) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ЦенаВключаетНДС", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Согласован", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Организация", Организация) Или Изменено;
		
		График = ГрафикОплатыПоУмолчанию();
		Если ЗначениеЗаполнено(График) Тогда
			Изменено = УстановитьРеквизит(Объект, "ГрафикОплаты", График) Или Изменено;
		КонецЕсли;
		
		Если Изменено Тогда
			Объект.ЗаполнитьСлужебныеРеквизитыДляОграниченияДоступа();
			Объект.Записать();
			Протокол.Добавить("Соглашение «" + Наименование + "»: " + СтатусЗаписи(ЭтоНовый, Истина) + ".");
			Возврат Объект.Ссылка;
		КонецЕсли;
		Протокол.Добавить("Соглашение «" + Наименование + "»: без изменений.");
		Возврат Ссылка;
	Исключение
		Протокол.Добавить("Соглашение «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.СоглашенияСКлиентами.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция ГрафикОплатыПоУмолчанию()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Графики.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГрафикиОплаты КАК Графики
	|ГДЕ
	|	НЕ Графики.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ГрафикиОплаты.ПустаяСсылка();
	
КонецФункции

Процедура ЗаписатьСсылкиУровня(Уровень, Соглашение, ВидЦены, Протокол)
	
	Если Не ЗначениеЗаполнено(Уровень) Или Не ЗначениеЗаполнено(Соглашение) Или Не ЗначениеЗаполнено(ВидЦены) Тогда
		Протокол.Добавить("Соглашение уровня «" + Строка(Уровень) + "»: пропуск, нет ссылки.");
		Возврат;
	КонецЕсли;
	
	Попытка
		Менеджер = РегистрРасширения("тз_СоглашенияУровней").СоздатьМенеджерЗаписи();
		Менеджер.Уровень = Уровень;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() И Менеджер.Соглашение = Соглашение И Менеджер.ВидЦены = ВидЦены Тогда
			Протокол.Добавить("Соглашение уровня «" + Строка(Уровень) + "»: без изменений.");
			Возврат;
		КонецЕсли;
		ЭтоНовый = Не Менеджер.Выбран();
		Менеджер.Уровень = Уровень;
		Менеджер.Соглашение = Соглашение;
		Менеджер.ВидЦены = ВидЦены;
		Менеджер.Записать();
		Протокол.Добавить("Соглашение уровня «" + Строка(Уровень) + "»: " + СтатусЗаписи(ЭтоНовый, Истина) + ".");
	Исключение
		Протокол.Добавить("Соглашение уровня «" + Строка(Уровень) + "»: ошибка: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьУровеньИНН(ИНН, Уровень, Протокол)
	
	Попытка
		Менеджер = РегистрРасширения("тз_УровниПокупателейПоИНН").СоздатьМенеджерЗаписи();
		Менеджер.ИНН = ИНН;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() И Менеджер.Уровень = Уровень Тогда
			Протокол.Добавить("ИНН " + ИНН + ": без изменений, " + Строка(Уровень) + ".");
			Возврат;
		КонецЕсли;
		ЭтоНовый = Не Менеджер.Выбран();
		Менеджер.ИНН = ИНН;
		Менеджер.Уровень = Уровень;
		Менеджер.Записать();
		Протокол.Добавить("ИНН " + ИНН + ": " + СтатусЗаписи(ЭтоНовый, Истина) + ", " + Строка(Уровень) + ".");
	Исключение
		Протокол.Добавить("ИНН " + ИНН + ": ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбеспечитьПокупателя(Наименование, ИНН, ОжидаемыйУровень, Протокол)
	
	// Регистр тз_УровниПартнеров отсюда не пишется.
	// Новый партнёр-клиент получает бронзовый в ПриЗаписи расширения,
	// запись контрагента вызывает ПрименитьУровеньПоИНН.
	Попытка
		Партнер = Справочники.Партнеры.НайтиПоНаименованию(Наименование, Истина);
		ПартнерНовый = Не ЗначениеЗаполнено(Партнер);
		Если ПартнерНовый Тогда
			Объект = Справочники.Партнеры.СоздатьЭлемент();
			Объект.Наименование = Наименование;
			Объект.НаименованиеПолное = Наименование;
			Объект.Клиент = Истина;
			Объект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
			Объект.ДатаРегистрации = ТекущаяДатаСеанса();
			Объект.ОсновнойМенеджер = Пользователи.ТекущийПользователь();
			ЗаполнитьГруппуДоступаПартнера(Объект);
			Объект.Записать();
			Партнер = Объект.Ссылка;
			Протокол.Добавить("Партнёр «" + Наименование + "»: создано.");
		Иначе
			Протокол.Добавить("Партнёр «" + Наименование + "»: без изменений.");
		КонецЕсли;
		
		Контрагент = НайтиКонтрагентаПартнера(Партнер);
		КонтрагентНовый = Не ЗначениеЗаполнено(Контрагент);
		Если КонтрагентНовый Тогда
			ОбъектКонтрагента = Справочники.Контрагенты.СоздатьЭлемент();
		Иначе
			ОбъектКонтрагента = Контрагент.ПолучитьОбъект();
		КонецЕсли;
		
		Изменено = КонтрагентНовый;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "Наименование", Наименование) Или Изменено;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "НаименованиеПолное", Наименование) Или Изменено;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "Партнер", Партнер) Или Изменено;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "ЮрФизЛицо", Перечисления.ЮрФизЛицо.ЮрЛицо) Или Изменено;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "ИНН", ИНН) Или Изменено;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "КПП", "770101001") Или Изменено;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "ОбособленноеПодразделение", Ложь) Или Изменено;
		Если Не ЗначениеЗаполнено(ОбъектКонтрагента.СтранаРегистрации) Тогда
			ОбъектКонтрагента.СтранаРегистрации = ЗначениеНастроекКлиентСерверПовтИсп.ОсновнаяСтрана();
			Изменено = Истина;
		КонецЕсли;
		
		Если Изменено Тогда
			ОбъектКонтрагента.Записать();
			Протокол.Добавить("Контрагент «" + Наименование + "»: " + СтатусЗаписи(КонтрагентНовый, Истина)
				+ ". ИНН " + ИНН + ".");
		Иначе
			Протокол.Добавить("Контрагент «" + Наименование + "»: без изменений.");
		КонецЕсли;
		
		// Регистр уровней не пишем менеджером записи. Те же вызовы, что у обработчиков
		// расширения: бронзовый новому клиенту без записи и уровень по ИНН контрагента.
		// Повторный вызов при уже верном уровне ничего не записывает.
		МодульУровней = МодульУровней();
		СостояниеДо = МодульУровней.СостояниеУровня(Партнер);
		Если Не СостояниеДо.ЕстьЗапись Тогда
			МодульУровней.УстановитьУровеньПартнера(Партнер, УровеньПоИмени("Бронзовый"), Ложь);
		КонецЕсли;
		МодульУровней.ПрименитьУровеньПоИНН(Контрагент);
		
		Факт = МодульУровней.СостояниеУровня(Партнер);
		Если Факт.Уровень = ОжидаемыйУровень И Не Факт.ЗаданВручную Тогда
			Протокол.Добавить("Уровень «" + Наименование + "»: " + Строка(Факт.Уровень) + ".");
		ИначеЕсли Факт.ЗаданВручную Тогда
			Протокол.Добавить("Уровень «" + Наименование + "»: оставлен ручной " + Строка(Факт.Уровень) + ".");
		Иначе
			Протокол.Добавить("Уровень «" + Наименование + "»: ожидался " + Строка(ОжидаемыйУровень)
				+ ", фактически " + Строка(Факт.Уровень) + ".");
		КонецЕсли;
	Исключение
		Протокол.Добавить("Покупатель «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьГруппуДоступаПартнера(Объект)
	
	Если Не Справочники.ГруппыДоступаПартнеров.ИспользуютсяГруппыДоступа() Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ГруппаДоступа) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Группы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГруппыДоступаПартнеров КАК Группы
	|ГДЕ
	|	НЕ Группы.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.ГруппаДоступа = Выборка.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиКонтрагентаПартнера(Партнер)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Партнер = &Партнер
	|	И НЕ Контрагенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

Процедура ОбеспечитьОстаткиИРозничнуюЦену(Организация, Валюта, Протокол)
	
	Номенклатура = НоменклатураСтенда(Протокол);
	Если Номенклатура = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СкладОпт = ОптовыйСкладБезОрдерногоПоступления();
	КассаРМК = КассаРМКДляСтенда();
	СкладРозницы = ?(КассаРМК = Неопределено, Справочники.Склады.ПустаяСсылка(), КассаРМК.Склад);
	
	Если Не ЗначениеЗаполнено(СкладОпт) Тогда
		Протокол.Добавить("Поступление: пропуск, оптовый склад без ордерной схемы при поступлении не найден.");
	Иначе
		ОбеспечитьПоступление(СкладОпт, СкладРозницы, Организация, Номенклатура, Протокол);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СкладРозницы) Тогда
		Протокол.Добавить("Перемещение: пропуск, касса в настройках РМК не найдена.");
		Протокол.Добавить("Розничная цена: пропуск, касса в настройках РМК не найдена.");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СкладОпт) Тогда
		ОбеспечитьПеремещение(СкладОпт, СкладРозницы, Организация, Номенклатура, Протокол);
	Иначе
		Протокол.Добавить("Перемещение: пропуск, нет оптового склада-отправителя.");
	КонецЕсли;
	
	УстановитьРозничнуюЦенуРМК(СкладРозницы, КассаРМК.Касса, Номенклатура, Валюта, Протокол);
	
КонецПроцедуры

Функция НоменклатураСтенда(Протокол)
	
	Имена = Новый Массив;
	Имена.Добавить("Обои тест");
	Имена.Добавить("Отходы тест");
	Результат = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Ссылка = Справочники.Номенклатура.НайтиПоНаименованию(Имя, Истина);
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Протокол.Добавить("Остатки: пропуск, нет номенклатуры «" + Имя + "».");
			Возврат Неопределено;
		КонецЕсли;
		Результат.Добавить(Ссылка);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция ОптовыйСкладБезОрдерногоПоступления()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.ПометкаУдаления
	|	И НЕ Склады.ЭтоГруппа
	|	И Склады.ТипСклада = ЗНАЧЕНИЕ(Перечисление.ТипыСкладов.ОптовыйСклад)
	|	И НЕ Склады.ИспользоватьОрдернуюСхемуПриПоступлении
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Склады.Наименование = ""Склад Филиала ДС""
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	Склады.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Склады.ПустаяСсылка();
	
КонецФункции

Функция КассаРМКДляСтенда()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Кассы.Ссылка КАК Касса,
	|	Кассы.Наименование КАК ИмяКассы,
	|	Кассы.Склад КАК Склад,
	|	Кассы.Склад.Наименование КАК ИмяСклада
	|ИЗ
	|	Справочник.НастройкиРМК.КассыККМ КАК СтрокиНастроек
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КассыККМ КАК Кассы
	|		ПО СтрокиНастроек.КассаККМ = Кассы.Ссылка
	|ГДЕ
	|	НЕ СтрокиНастроек.Ссылка.ПометкаУдаления
	|	И НЕ Кассы.ПометкаУдаления
	|	И Кассы.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();
	Выбранная = Неопределено;
	Пока Выборка.Следующий() Цикл
		Подходит = Выборка.ИмяСклада = "Торговый зал"
			Или СтрНайти(Выборка.ИмяКассы, "Торговый зал") > 0;
		Если Выбранная = Неопределено Или Подходит Тогда
			Выбранная = Новый Структура("Касса, Склад", Выборка.Касса, Выборка.Склад);
			Если Подходит Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Выбранная;
	
КонецФункции

Процедура ОбеспечитьПоступление(СкладОпт, СкладРозницы, Организация, Номенклатура, Протокол)
	
	Нужно = Новый Соответствие;
	Нужно.Вставить(Номенклатура[0], 40);
	Нужно.Вставить(Номенклатура[1], 20);
	Склады = Новый Массив;
	Склады.Добавить(СкладОпт);
	Если ЗначениеЗаполнено(СкладРозницы) Тогда
		Склады.Добавить(СкладРозницы);
	КонецЕсли;
	Остатки = ОстаткиНоменклатуры(Номенклатура, Склады);
	Строки = СтрокиНедостачи(Нужно, Остатки);
	Если Строки.Количество() = 0 Тогда
		Протокол.Добавить("Поступление: без изменений, остаток уже есть. Склад «" + СкладОпт + "».");
		Возврат;
	КонецЕсли;
	
	Соглашение = НайтиСоглашениеПоставщика(Организация);
	Если Не ЗначениеЗаполнено(Соглашение) Тогда
		Протокол.Добавить("Поступление: пропуск, действующее соглашение демо-поставщика не найдено.");
		Возврат;
	КонецЕсли;
	
	Попытка
		Документ = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
		Документ.Дата = ТекущаяДатаСеанса();
		Документ.Заполнить(Соглашение);
		Документ.Склад = СкладОпт;
		Документ.ПоступлениеПоЗаказам = Ложь;
		Документ.Комментарий = "тз Заполнение тестовых данных";
		Документ.Товары.Очистить();
		СуммаДокумента = 0;
		Для Каждого СтрокаНужды Из Строки Цикл
			ДобавитьСтрокуПоступления(Документ, СтрокаНужды.Номенклатура, СтрокаНужды.Количество, СкладОпт);
			СуммаДокумента = СуммаДокумента + Документ.Товары[Документ.Товары.Количество() - 1].СуммаСНДС;
		КонецЦикла;
		Документ.СуммаДокумента = СуммаДокумента;
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Протокол.Добавить("Поступление: создано. Склад «" + СкладОпт + "», поставщик «"
			+ Документ.Партнер + "»: " + ТекстКоличеств(Строки) + ".");
	Исключение
		Протокол.Добавить("Поступление: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ДобавитьСтрокуПоступления(Документ, Номенклатура, Количество, Склад)
	
	Цена = 100;
	СтавкаНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "СтавкаНДС");
	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	КонецЕсли;
	Процент = УчетНДСПереопределяемый.ПолучитьСтавкуНДС(СтавкаНДС);
	Сумма = Окр(Цена * Количество, 2);
	Если Документ.ЦенаВключаетНДС Тогда
		СуммаНДС = Окр(Сумма * Процент / (100 + Процент), 2);
		СуммаСНДС = Сумма;
	Иначе
		СуммаНДС = Окр(Сумма * Процент / 100, 2);
		СуммаСНДС = Сумма + СуммаНДС;
	КонецЕсли;
	
	СтрокаТовара = Документ.Товары.Добавить();
	СтрокаТовара.Номенклатура = Номенклатура;
	СтрокаТовара.Количество = Количество;
	СтрокаТовара.КоличествоУпаковок = Количество;
	СтрокаТовара.Цена = Цена;
	СтрокаТовара.Сумма = Сумма;
	СтрокаТовара.СтавкаНДС = СтавкаНДС;
	СтрокаТовара.СуммаНДС = СуммаНДС;
	СтрокаТовара.СуммаСНДС = СуммаСНДС;
	СтрокаТовара.Склад = Склад;
	
КонецПроцедуры

Процедура ОбеспечитьПеремещение(СкладОпт, СкладРозницы, Организация, Номенклатура, Протокол)
	
	Нужно = Новый Соответствие;
	Нужно.Вставить(Номенклатура[0], 20);
	Нужно.Вставить(Номенклатура[1], 10);
	СкладыРозницы = Новый Массив;
	СкладыРозницы.Добавить(СкладРозницы);
	ОстатокЗала = ОстаткиНоменклатуры(Номенклатура, СкладыРозницы);
	Строки = СтрокиНедостачи(Нужно, ОстатокЗала);
	Если Строки.Количество() = 0 Тогда
		Протокол.Добавить("Перемещение: без изменений, остаток уже есть. Склад «" + СкладРозницы + "».");
		Возврат;
	КонецЕсли;
	
	СкладыОпта = Новый Массив;
	СкладыОпта.Добавить(СкладОпт);
	ОстатокОпта = ОстаткиНоменклатуры(Номенклатура, СкладыОпта);
	Для Каждого СтрокаНужды Из Строки Цикл
		Есть = ОстатокОпта.Получить(СтрокаНужды.Номенклатура);
		Если Есть = Неопределено Или Есть < СтрокаНужды.Количество Тогда
			Протокол.Добавить("Перемещение: пропуск, на складе «" + СкладОпт + "» недостаточно «"
				+ СтрокаНужды.Номенклатура + "»: нужно " + СтрокаНужды.Количество
				+ ", есть " + ?(Есть = Неопределено, 0, Есть) + ".");
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		Документ = Документы.ПеремещениеТоваров.СоздатьДокумент();
		Документ.Дата = ТекущаяДатаСеанса();
		Документ.Заполнить(Новый Структура);
		Если ЗначениеЗаполнено(Организация) Тогда
			Документ.Организация = Организация;
		КонецЕсли;
		Документ.СкладОтправитель = СкладОпт;
		Документ.СкладПолучатель = СкладРозницы;
		Документ.Статус = Перечисления.СтатусыПеремещенийТоваров.Принято;
		Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
		Документ.Комментарий = "тз Заполнение тестовых данных";
		Документ.Товары.Очистить();
		Для Каждого СтрокаНужды Из Строки Цикл
			СтрокаТовара = Документ.Товары.Добавить();
			СтрокаТовара.Номенклатура = СтрокаНужды.Номенклатура;
			СтрокаТовара.Количество = СтрокаНужды.Количество;
			СтрокаТовара.КоличествоУпаковок = СтрокаНужды.Количество;
		КонецЦикла;
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Протокол.Добавить("Перемещение: создано. «" + СкладОпт + "» → «" + СкладРозницы
			+ "», статус Принято: " + ТекстКоличеств(Строки) + ".");
	Исключение
		Протокол.Добавить("Перемещение: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьРозничнуюЦенуРМК(Склад, Касса, Номенклатура, Валюта, Протокол)
	
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Протокол.Добавить("Розничная цена: пропуск, нет валюты RUB.");
		Возврат;
	КонецЕсли;
	
	ВидЦены = ВидЦеныУсловийРозницы(Склад);
	Если Не ЗначениеЗаполнено(ВидЦены.ВидЦены) Тогда
		Протокол.Добавить("Розничная цена: пропуск, у склада «" + Склад
			+ "» кассы «" + Касса + "» вид цен условий розницы не заполнен.");
		Возврат;
	КонецЕсли;
	
	ВыровнятьКлючиЦенообразования(Номенклатура, Протокол);
	Цена = ОкруглитьЦенуВида(1000, ВидЦены.ВидЦены);
	Цены = Новый Массив;
	ДобавитьЦену(Цены, Номенклатура, ВидЦены.ВидЦены, Цена);
	Способ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЦены.ВидЦены, "СпособЗаданияЦены");
	Примечание = "";
	Если Способ <> Перечисления.СпособыЗаданияЦен.Вручную Тогда
		Примечание = " Записано в вычисляемый вид цен напрямую; регламент ОбновлениеЦен может пересчитать её от базового вида.";
	КонецЕсли;
	
	Если ЦеныУжеУстановлены(Цены) Тогда
		Протокол.Добавить("Розничная цена: без изменений. Вид цен «" + ВидЦены.ВидЦены
			+ "», источник " + ВидЦены.Источник + ", касса «" + Касса + "», " + Цена + "." + Примечание);
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗаписатьДокументЦен(Цены, Валюта);
		Протокол.Добавить("Розничная цена: создано. Вид цен «" + ВидЦены.ВидЦены
			+ "», источник " + ВидЦены.Источник + ", касса «" + Касса + "», " + Цена + "." + Примечание);
	Исключение
		Протокол.Добавить("Розничная цена: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ВидЦеныУсловийРозницы(Склад)
	
	// Тот же выбор, что у розничного заполнения чека:
	// объект хранения — формат магазина склада, иначе сам склад;
	// индивидуальный вид цен, иначе розничный.
	ОбъектХранения = АссортиментСерверПовтИсп.ФорматМагазинаПоСкладу(Склад, ТекущаяДатаСеанса());
	ЭтоФормат = ТипЗнч(ОбъектХранения) = Тип("СправочникСсылка.ФорматыМагазинов")
		И ЗначениеЗаполнено(ОбъектХранения);
	Если ЭтоФормат Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектХранения, "ИндивидуальныйВидЦены, РозничныйВидЦены");
		ИмяИсточника = "формат «" + Строка(ОбъектХранения) + "»";
	Иначе
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Склад, "ИндивидуальныйВидЦены, РозничныйВидЦены");
		ИмяИсточника = "склад «" + Строка(Склад) + "»";
	КонецЕсли;
	
	Результат = Новый Структура("ВидЦены, Источник", Справочники.ВидыЦен.ПустаяСсылка(), "");
	Если ЗначениеЗаполнено(Реквизиты.ИндивидуальныйВидЦены) Тогда
		Результат.ВидЦены = Реквизиты.ИндивидуальныйВидЦены;
		Результат.Источник = "индивидуальный вид цен, " + ИмяИсточника;
	Иначе
		Результат.ВидЦены = Реквизиты.РозничныйВидЦены;
		Результат.Источник = "розничный вид цен, " + ИмяИсточника;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Функция НайтиСоглашениеПоставщика(Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Соглашения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СоглашенияСПоставщиками КАК Соглашения
	|ГДЕ
	|	НЕ Соглашения.ПометкаУдаления
	|	И Соглашения.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСоглашенийСПоставщиками.Действует)
	|	И Соглашения.Партнер.Поставщик
	|	И НЕ Соглашения.Партнер.ПометкаУдаления
	|	И Соглашения.ХозяйственнаяОперация <> ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОказаниеАгентскихУслуг)
	|	И (&Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|		ИЛИ Соглашения.Организация = &Организация
	|		ИЛИ Соглашения.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Соглашения.Организация = &Организация
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	Соглашения.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.СоглашенияСПоставщиками.ПустаяСсылка();
	
КонецФункции

Функция ОстаткиНоменклатуры(Номенклатура, Склады)
	
	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склады", Склады);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.ВНаличииОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			,
	|			Номенклатура В (&Номенклатура)
	|				И Склад В (&Склады)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.Количество);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция СтрокиНедостачи(Нужно, Остатки)
	
	Строки = Новый Массив;
	Для Каждого Пара Из Нужно Цикл
		Есть = Остатки.Получить(Пара.Ключ);
		Если Есть = Неопределено Тогда
			Есть = 0;
		КонецЕсли;
		Недостача = Пара.Значение - Есть;
		Если Недостача > 0 Тогда
			Строки.Добавить(Новый Структура("Номенклатура, Количество", Пара.Ключ, Недостача));
		КонецЕсли;
	КонецЦикла;
	Возврат Строки;
	
КонецФункции

Функция ТекстКоличеств(Строки)
	
	Части = Новый Массив;
	Для Каждого СтрокаНужды Из Строки Цикл
		Части.Добавить(Строка(СтрокаНужды.Номенклатура) + " " + СтрокаНужды.Количество);
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");
	
КонецФункции

#КонецОбласти
