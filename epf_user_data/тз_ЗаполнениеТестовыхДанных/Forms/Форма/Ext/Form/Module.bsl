// Форма стенда. Автозапуск: параметр запуска «тз_автозаполнение» (команда /C или /Execute).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВыполнитьПервоначальнуюНастройку = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ПараметрЗапуска <> "тз_автозаполнение" Тогда
		Возврат;
	КонецЕсли;
	
	// Форму не показываем: заполнение, файл протокола, завершение сеанса.
	Отказ = Истина;
	Текст = "";
	Попытка
		Текст = ЗаполнитьНаСервере(Истина);
	Исключение
		Текст = "Отказ. " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Попытка
		ЗаписатьФайлПротокола(Текст);
	Исключение
		Текст = Текст + Символы.ПС + "Файл протокола не записан: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Протокол = ЗаполнитьНаСервере(ВыполнитьПервоначальнуюНастройку);
	Если СтрНачинаетсяС(Протокол, "Отказ.") Тогда
		ПоказатьПредупреждение(, Протокол);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьНаСервере(ВыполнитьНастройку)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.ЗаполнитьДанные(ВыполнитьНастройку);
	
КонецФункции

&НаСервере
Процедура ЗаписатьФайлПротокола(Текст)
	
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(Текст);
	Документ.Записать("D:\cursor\TestCoder\scripts\user_data_protocol.txt", КодировкаТекста.UTF8);
	
КонецПроцедуры
