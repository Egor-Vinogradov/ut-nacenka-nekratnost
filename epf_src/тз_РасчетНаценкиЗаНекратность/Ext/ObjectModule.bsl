#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Регистрационные данные вида «Расчет скидки (наценки)».
// Вид — ссылка перечисления, строковое представление этот вид не распознаёт.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = СкидкиНаценкиСервер.ПараметрыРегистрацииВнешнейОбработкиСкидкиНаценки(
		"Наценка за некратность упаковке (тз)",
		"Наценка на строки, если суммарное количество номенклатуры и характеристики не кратно упаковке.");
	ПараметрыРегистрации.Версия = "1.0";
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Точка вызова из СкидкиНаценкиСервер.РассчитатьСкидку.
//
Функция Рассчитать(СтрокаДерева, ПараметрыОбработки, Товары, ПараметрыРасчета) Экспорт
	
	Возврат тз_НаценкаЗаНекратностьСервер.РезультатРасчетаДляСкидок(СтрокаДерева, Товары, ПараметрыРасчета);
	
КонецФункции

// Список «Скидки (наценки)» вызывает метод без проверки наличия.
// Значение, отличное от «Начислить бонусные баллы», попадает в команды скидок.
//
Функция СпособПрименения() Экспорт
	
	Возврат Перечисления.СпособыПримененияСкидокНаценок.ПрименитьВМоментРасчетаСкидокНаценок;
	
КонецФункции

// Текст поля «Описание» в карточке скидки. Настройки не используются.
//
Функция ОписаниеДействия(Параметры) Экспорт
	
	Возврат "Наценка на строки, если суммарное количество номенклатуры и характеристики не кратно упаковке.";
	
КонецФункции

// Строка в списке выбора наименования скидки.
//
Функция Автонаименование(Параметры) Экспорт
	
	Возврат "Наценка за некратность упаковке";
	
КонецФункции

// Пустая строка скрывает кнопку настроек: отдельной формы нет.
//
Функция ИмяФормыНастроек() Экспорт
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#КонецЕсли
