#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Регистрационные данные вида «Расчет скидки (наценки)».
// Вид — ссылка перечисления, строковое представление этот вид не распознаёт.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = СкидкиНаценкиСервер.ПараметрыРегистрацииВнешнейОбработкиСкидкиНаценки(
		"Наценка за некратность упаковке (тз)",
		"Наценка на строки, если суммарное количество номенклатуры и характеристики не кратно упаковке.");
	ПараметрыРегистрации.Версия = "1.0";
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Точка вызова из СкидкиНаценкиСервер.РассчитатьСкидку.
//
Функция Рассчитать(СтрокаДерева, ПараметрыОбработки, Товары, ПараметрыРасчета) Экспорт
	
	Возврат тз_НаценкаЗаНекратностьСервер.РезультатРасчетаДляСкидок(СтрокаДерева, Товары, ПараметрыРасчета);
	
КонецФункции

#КонецОбласти

#КонецЕсли
