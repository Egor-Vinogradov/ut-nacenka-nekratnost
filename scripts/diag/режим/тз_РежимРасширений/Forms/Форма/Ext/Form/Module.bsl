&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Отказ = Истина;
	ЗаписатьРежимы(ПараметрЗапуска);
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРежимы(ИмяФайла)
	
	Строки = Новый Массив;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Строки.Добавить(Расширение.Имя
			+ " | версия=" + Расширение.Версия
			+ " | активно=" + Расширение.Активно
			+ " | безопасныйРежим=" + Расширение.БезопасныйРежим);
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		Строки.Добавить("Расширений нет.");
	КонецЕсли;
	
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(СтрСоединить(Строки, Символы.ПС));
	Документ.Записать(ИмяФайла, КодировкаТекста.UTF8);
	
КонецПроцедуры
