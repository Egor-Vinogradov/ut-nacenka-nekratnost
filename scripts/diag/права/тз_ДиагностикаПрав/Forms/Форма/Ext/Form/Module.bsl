&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Отказ = Истина;
	ЗаписатьРолиНаСервере();
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРолиНаСервере()
	
	ИмяПользователя = "Продажи (ГладилинаВМ)";
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	
	Строки = Новый Массив;
	Строки.Добавить("Сеанс: " + ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	Строки.Добавить("БезопасныйРежим обработки: " + БезопасныйРежим());
	Строки.Добавить("Новый пользователь ИБ этой диагностикой не создавался.");
	
	Если ПользовательИБ = Неопределено Тогда
		Строки.Добавить("Пользователь ИБ """ + ИмяПользователя + """ не найден.");
		ЗаписатьФайл(Строки);
		Возврат;
	КонецЕсли;
	
	Строки.Добавить("Пользователь ИБ: " + ПользовательИБ.Имя);
	Строки.Добавить("ПарольУстановлен: " + ПользовательИБ.ПарольУстановлен);
	Строки.Добавить("");
	Строки.Добавить("ДО повторного обновления профилей (исправление уже загружено, предыдущий сеанс Admin профили уже пересчитывал).");
	ДописатьПрава(Строки, ПользовательИБ);
	
	Строки.Добавить("");
	ОбновитьПрофили(Строки);
	
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Строки.Добавить("");
	Строки.Добавить("ПОСЛЕ обновления профилей.");
	ДописатьПрава(Строки, ПользовательИБ);
	
	Строки.Добавить("");
	Строки.Добавить("ДО исправления снимок ролей ИБ не снят: роль тз_ОсновнаяРоль в профили БСП не входила, чтение РегистрСведений.тз_КратностьПродажи у менеджера отсутствовало. Повторно это состояние не прочитать: роль переименована в тз_ОбщиеПрава и профили уже пересчитаны.");
	Строки.Добавить("Данные заказа, регистров и констант не записывались.");
	
	ЗаписатьФайл(Строки);
	
КонецПроцедуры

&НаСервере
Процедура ДописатьПрава(Строки, ПользовательИБ)
	
	Строки.Добавить("Роли пользователя ИБ:");
	ЕстьРольРасширения = Ложь;
	Для Каждого Роль Из ПользовательИБ.Роли Цикл
		Расширение = Роль.РасширениеКонфигурации();
		Если Расширение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЕстьРольРасширения = Истина;
		Строки.Добавить("  " + Роль.Имя + " | расширение " + Расширение.Имя);
	КонецЦикла;
	Если Не ЕстьРольРасширения Тогда
		Строки.Добавить("  ролей расширения нет.");
	КонецЕсли;
	
	Строки.Добавить("ПравоДоступа(Чтение) для этого пользователя ИБ:");
	ПроверитьЧтение(Строки, ПользовательИБ, Метаданные.РегистрыСведений.тз_КратностьПродажи);
	ПроверитьЧтение(Строки, ПользовательИБ, Метаданные.РегистрыСведений.тз_СоглашенияУровней);
	ПроверитьЧтение(Строки, ПользовательИБ, Метаданные.РегистрыСведений.тз_УровниПартнеров);
	ПроверитьЧтение(Строки, ПользовательИБ, Метаданные.РегистрыСведений.тз_УровниПокупателейПоИНН);
	ПроверитьЧтение(Строки, ПользовательИБ, Метаданные.Константы.тз_ПроцентНаценкиЗаНекратность);
	ПроверитьЧтение(Строки, ПользовательИБ, Метаданные.Константы.тз_СкидкаНаценкаЗаНекратность);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЧтение(Строки, ПользовательИБ, ОбъектМетаданных)
	
	Попытка
		Разрешено = ПравоДоступа("Чтение", ОбъектМетаданных, ПользовательИБ);
		Строки.Добавить("  " + ОбъектМетаданных.ПолноеИмя() + ": " + Разрешено);
	Исключение
		Строки.Добавить("  " + ОбъектМетаданных.ПолноеИмя() + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПрофили(Строки)
	
	Попытка
		Справочники.ПрофилиГруппДоступа.ОбновитьПоставляемыеПрофилиПоИзменениямКонфигурации();
		Справочники.ПрофилиГруппДоступа.ОбновитьНепоставляемыеПрофилиПоИзменениямКонфигурации();
		УправлениеДоступомСлужебный.ОбновитьРолиПользователей();
		Строки.Добавить("Повторное обновление профилей и ролей выполнено.");
	Исключение
		Строки.Добавить("Повторное обновление профилей: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьФайл(Строки)
	
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(СтрСоединить(Строки, Символы.ПС));
	Документ.Записать("D:\cursor\TestCoder\scripts\diag_roles.txt", КодировкаТекста.UTF8);
	
КонецПроцедуры
