&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Отказ = Истина;
	ДиагностикаНаСервере();
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ДиагностикаНаСервере()
	
	Строки = Новый Массив;
	Контекст = Новый Структура;
	Контекст.Вставить("Дата", ТекущаяДатаСеанса());
	Контекст.Вставить("Склад", Справочники.Склады.ПустаяСсылка());
	Контекст.Вставить("Касса", Справочники.КассыККМ.ПустаяСсылка());
	Контекст.Вставить("Валюта", Справочники.Валюты.ПустаяСсылка());
	Контекст.Вставить("ОбъектХранения", Неопределено);
	Контекст.Вставить("ВидЦенРМК", Справочники.ВидыЦен.ПустаяСсылка());
	Контекст.Вставить("ИсточникВидаЦен", "");
	Контекст.Вставить("ВидРозничная", Справочники.ВидыЦен.ПустаяСсылка());
	Контекст.Вставить("Номенклатура", НоменклатураТз());
	Строки.Добавить("Дата сеанса: " + Строка(Контекст.Дата));
	Строки.Добавить("ИспользуетсяЦенообразование25: " + Строка(ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25()));
	Строки.Добавить("ИспользоватьФорматыМагазинов: " + Строка(ПолучитьФункциональнуюОпцию("ИспользоватьФорматыМагазинов")));
	
	ВызватьБлок(Строки, "1. Склад", "БлокСклад", Контекст);
	ВызватьБлок(Строки, "2. Формат магазина", "БлокФормат", Контекст);
	ВызватьБлок(Строки, "3. Вид цен РМК", "БлокВидЦенРМК", Контекст);
	ВызватьБлок(Строки, "4. Реквизиты видов цен", "БлокРеквизитыВидовЦен", Контекст);
	ВызватьБлок(Строки, "5. Срезы цен", "БлокСрезы", Контекст);
	ВызватьБлок(Строки, "6. Установки цен", "БлокУстановки", Контекст);
	ВызватьБлок(Строки, "7. Цена функции РМК", "БлокЦенаРМК", Контекст);
	
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(СтрСоединить(Строки, Символы.ПС));
	Текст.Записать("D:\cursor\TestCoder\scripts\diag_retail.txt", КодировкаТекста.UTF8);
	
КонецПроцедуры

&НаСервере
Процедура ВызватьБлок(Строки, Заголовок, ИмяПроцедуры, Контекст)
	
	Строки.Добавить("");
	Строки.Добавить("=== " + Заголовок + " ===");
	Попытка
		Если ИмяПроцедуры = "БлокСклад" Тогда
			БлокСклад(Строки, Контекст);
		ИначеЕсли ИмяПроцедуры = "БлокФормат" Тогда
			БлокФормат(Строки, Контекст);
		ИначеЕсли ИмяПроцедуры = "БлокВидЦенРМК" Тогда
			БлокВидЦенРМК(Строки, Контекст);
		ИначеЕсли ИмяПроцедуры = "БлокРеквизитыВидовЦен" Тогда
			БлокРеквизитыВидовЦен(Строки, Контекст);
		ИначеЕсли ИмяПроцедуры = "БлокСрезы" Тогда
			БлокСрезы(Строки, Контекст);
		ИначеЕсли ИмяПроцедуры = "БлокУстановки" Тогда
			БлокУстановки(Строки, Контекст);
		ИначеЕсли ИмяПроцедуры = "БлокЦенаРМК" Тогда
			БлокЦенаРМК(Строки, Контекст);
		КонецЕсли;
	Исключение
		Строки.Добавить("Ошибка блока: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура БлокСклад(Строки, Контекст)
	
	Склад = Справочники.Склады.НайтиПоНаименованию("Торговый зал", Истина);
	Контекст.Склад = Склад;
	Строки.Добавить("Склад: " + ПредставлениеСсылки(Склад));
	Строки.Добавить("Реквизита Склады.ФорматМагазина нет.");
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Склад, "РозничныйВидЦены, ИндивидуальныйВидЦены, ТипСклада");
	Строки.Добавить("РозничныйВидЦены: " + ПредставлениеСсылки(Реквизиты.РозничныйВидЦены));
	Строки.Добавить("ИндивидуальныйВидЦены: " + ПредставлениеСсылки(Реквизиты.ИндивидуальныйВидЦены));
	Строки.Добавить("ТипСклада: " + Строка(Реквизиты.ТипСклада));
	
КонецПроцедуры

&НаСервере
Процедура БлокФормат(Строки, Контекст)
	
	Если Не ЗначениеЗаполнено(Контекст.Склад) Тогда
		Строки.Добавить("Склад не найден, формат не читается.");
		Возврат;
	КонецЕсли;
	ОбъектХранения = АссортиментСерверПовтИсп.ФорматМагазинаПоСкладу(Контекст.Склад, Контекст.Дата);
	Контекст.ОбъектХранения = ОбъектХранения;
	Строки.Добавить("ФорматМагазинаПоСкладу: " + ПредставлениеСсылки(ОбъектХранения)
		+ ", тип " + Строка(ТипЗнч(ОбъектХранения)));
	Если ТипЗнч(ОбъектХранения) <> Тип("СправочникСсылка.ФорматыМагазинов") Или Не ЗначениеЗаполнено(ОбъектХранения) Тогда
		Строки.Добавить("Формат магазина не задан, объект условий продаж — склад.");
		Возврат;
	КонецЕсли;
	Имена = "ПлощадьТорговогоЗалаМинимальная, ПлощадьТорговогоЗалаМаксимальная, КоличествоАссортиментныхПозиций, "
		+ "ЦелевоеМестоположение, ТехнологияРазмещенияТовараИОбслуживанияПокупателей, РозничныйВидЦены, "
		+ "ЦелевыеГруппыПокупателей, ВМагазинеПоддерживаетсяСборкаЗаказов, ВМагазинеПоддерживаетсяДоставкаСвоимиКурьерами, "
		+ "СпособСозданияРеализацииПриСборкеЗаказов, СпособФискализацииПриДоставке, СборкаИДоставкаВыполняетсяОднимСотрудником, "
		+ "КурьерыМогутНазначатьСебеЗаказы, СборщикиМогутНазначатьСебеЗаказы, НормативныйСрокДоставкиЗаказов, "
		+ "КурьерыИспользуютЭквайринговыеТерминалы, КурьерыИспользуютАвтономныеККТ, ГруппировкаТоваров, ИндивидуальныйВидЦены";
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектХранения, Имена);
	Для Каждого Элемент Из Реквизиты Цикл
		Строки.Добавить(Элемент.Ключ + ": " + Строка(Элемент.Значение));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура БлокВидЦенРМК(Строки, Контекст)
	
	Касса = Справочники.КассыККМ.НайтиПоНаименованию("Фискальный регистратор (Торговый зал)", Истина);
	Контекст.Касса = Касса;
	Строки.Добавить("Касса: " + ПредставлениеСсылки(Касса));
	Если Не ЗначениеЗаполнено(Касса) Тогда
		Возврат;
	КонецЕсли;
	РеквизитыКассы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Касса, "Склад, ТипКассы, ВалютаДенежныхСредств");
	Контекст.Валюта = РеквизитыКассы.ВалютаДенежныхСредств;
	Строки.Добавить("Касса.Склад: " + ПредставлениеСсылки(РеквизитыКассы.Склад));
	Строки.Добавить("Касса.ТипКассы: " + Строка(РеквизитыКассы.ТипКассы));
	Строки.Добавить("Касса.ВалютаДенежныхСредств: " + Строка(РеквизитыКассы.ВалютаДенежныхСредств));
	
	ОбъектХранения = АссортиментСерверПовтИсп.ФорматМагазинаПоСкладу(РеквизитыКассы.Склад, Контекст.Дата);
	Контекст.ОбъектХранения = ОбъектХранения;
	ЭтоФормат = ТипЗнч(ОбъектХранения) = Тип("СправочникСсылка.ФорматыМагазинов") И ЗначениеЗаполнено(ОбъектХранения);
	Строки.Добавить("ОбъектХраненияУсловийПродаж: " + ПредставлениеСсылки(ОбъектХранения)
		+ ", тип " + Строка(ТипЗнч(ОбъектХранения)));
	
	Индивидуальный = Справочники.ВидыЦен.ПустаяСсылка();
	Розничный = Справочники.ВидыЦен.ПустаяСсылка();
	Если ЭтоФормат Тогда
		РеквизитыИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектХранения, "ИндивидуальныйВидЦены, РозничныйВидЦены");
		Строки.Добавить("Источник видов цен: формат магазина.");
	Иначе
		РеквизитыИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыКассы.Склад, "ИндивидуальныйВидЦены, РозничныйВидЦены");
		Строки.Добавить("Источник видов цен: склад, формат не найден.");
	КонецЕсли;
	Индивидуальный = РеквизитыИсточника.ИндивидуальныйВидЦены;
	Розничный = РеквизитыИсточника.РозничныйВидЦены;
	Строки.Добавить("Приоритет 1, ИндивидуальныйВидЦены: " + ПредставлениеСсылки(Индивидуальный));
	Строки.Добавить("Приоритет 2, РозничныйВидЦены: " + ПредставлениеСсылки(Розничный));
	
	Номенклатура = Контекст.Номенклатура[0];
	Результат = ЦенаУсловийРозничныхПродаж(Номенклатура, Контекст.Дата, Контекст.Валюта, ОбъектХранения);
	Контекст.ВидЦенРМК = Результат.ВидЦены;
	Строки.Добавить("ЗаполнитьУсловияРозничныхПродаж.ВидЦены: " + ПредставлениеСсылки(Результат.ВидЦены));
	Строки.Добавить("ЗаполнитьУсловияРозничныхПродаж.Цена: " + Строка(Результат.Цена));
	Если Результат.ВидЦены = Индивидуальный И ЗначениеЗаполнено(Индивидуальный) Тогда
		Контекст.ИсточникВидаЦен = "индивидуальный вид цен объекта хранения, приоритет 1";
	ИначеЕсли Результат.ВидЦены = Розничный И ЗначениеЗаполнено(Розничный) Тогда
		Контекст.ИсточникВидаЦен = "розничный вид цен объекта хранения, приоритет 2";
	ИначеЕсли Не ЗначениеЗаполнено(Результат.ВидЦены) Тогда
		Контекст.ИсточникВидаЦен = "функция вернула пустой вид цен";
		Если ЗначениеЗаполнено(Индивидуальный) Тогда
			Контекст.ВидЦенРМК = Индивидуальный;
			Контекст.ИсточникВидаЦен = Контекст.ИсточникВидаЦен + "; для следующих блоков взят индивидуальный";
		ИначеЕсли ЗначениеЗаполнено(Розничный) Тогда
			Контекст.ВидЦенРМК = Розничный;
			Контекст.ИсточникВидаЦен = Контекст.ИсточникВидаЦен + "; для следующих блоков взят розничный";
		КонецЕсли;
	Иначе
		Контекст.ИсточникВидаЦен = "вид цен функции не совпал ни с индивидуальным, ни с розничным";
	КонецЕсли;
	Строки.Добавить("Источник выбранного вида: " + Контекст.ИсточникВидаЦен);
	
КонецПроцедуры

&НаСервере
Процедура БлокРеквизитыВидовЦен(Строки, Контекст)
	
	Контекст.ВидРозничная = Справочники.ВидыЦен.НайтиПоНаименованию("Розничная", Истина);
	ОписатьВидЦен(Строки, "Вид цен блока 3", Контекст.ВидЦенРМК);
	ОписатьВидЦен(Строки, "Вид цен «Розничная»", Контекст.ВидРозничная);
	Строки.Добавить("Блок 3 и «Розничная» — одна ссылка: " + Строка(Контекст.ВидЦенРМК = Контекст.ВидРозничная));
	
КонецПроцедуры

&НаСервере
Процедура БлокСрезы(Строки, Контекст)
	
	Виды = Новый Массив;
	Если ЗначениеЗаполнено(Контекст.ВидЦенРМК) Тогда
		Виды.Добавить(Контекст.ВидЦенРМК);
	КонецЕсли;
	Если ЗначениеЗаполнено(Контекст.ВидРозничная) И Виды.Найти(Контекст.ВидРозничная) = Неопределено Тогда
		Виды.Добавить(Контекст.ВидРозничная);
	КонецЕсли;
	Для Каждого ВидЦены Из Виды Цикл
		ДобавитьЗапрос(Строки, "ЦеныНоменклатуры25, " + Строка(ВидЦены),
			"ВЫБРАТЬ
			|	Цены.Период КАК Период,
			|	Цены.Регистратор КАК Регистратор,
			|	Цены.Номенклатура.Наименование КАК Номенклатура,
			|	Цены.ХарактеристикаЦО КАК ХарактеристикаЦО,
			|	Цены.СерияЦО КАК СерияЦО,
			|	Цены.УпаковкаЦО КАК УпаковкаЦО,
			|	Цены.Упаковка КАК Упаковка,
			|	Цены.ВидЦены КАК ВидЦены,
			|	Цены.Цена КАК Цена,
			|	Цены.Валюта КАК Валюта,
			|	Цены.СтавкаНДС КАК СтавкаНДС,
			|	Цены.МаркетинговоеМероприятие КАК МаркетинговоеМероприятие,
			|	Цены.Формула КАК Формула
			|ИЗ
			|	РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(
			|			,
			|			Номенклатура В (&Номенклатура)
			|				И ВидЦены = &ВидЦены) КАК Цены",
			Новый Структура("Номенклатура, ВидЦены", Контекст.Номенклатура, ВидЦены));
		ДобавитьЗапрос(Строки, "ЦеныНоменклатуры, " + Строка(ВидЦены),
			"ВЫБРАТЬ
			|	Цены.Период КАК Период,
			|	Цены.Регистратор КАК Регистратор,
			|	Цены.Номенклатура.Наименование КАК Номенклатура,
			|	Цены.Характеристика КАК Характеристика,
			|	Цены.Упаковка КАК Упаковка,
			|	Цены.ВидЦены КАК ВидЦены,
			|	Цены.Цена КАК Цена,
			|	Цены.Валюта КАК Валюта,
			|	Цены.Формула КАК Формула,
			|	Цены.МаркетинговоеМероприятие КАК МаркетинговоеМероприятие
			|ИЗ
			|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
			|			,
			|			Номенклатура В (&Номенклатура)
			|				И ВидЦены = &ВидЦены) КАК Цены",
			Новый Структура("Номенклатура, ВидЦены", Контекст.Номенклатура, ВидЦены));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура БлокУстановки(Строки, Контекст)
	
	ВидЦены = Контекст.ВидРозничная;
	ДобавитьЗапрос(Строки, "Товары2_5",
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Документ,
		|	Док.Дата КАК Дата,
		|	Док.Статус КАК Статус,
		|	Док.Проведен КАК Проведен,
		|	Док.Комментарий КАК Комментарий,
		|	Строки.НомерСтроки КАК НомерСтроки,
		|	Строки.Номенклатура.Наименование КАК Номенклатура,
		|	Строки.Цена КАК Цена,
		|	Строки.Валюта КАК Валюта,
		|	Строки.ХарактеристикаЦО КАК ХарактеристикаЦО,
		|	Строки.СерияЦО КАК СерияЦО,
		|	Строки.УпаковкаЦО КАК УпаковкаЦО,
		|	Строки.Упаковка КАК Упаковка,
		|	Строки.ЦенаИзмененаВручную КАК ЦенаИзмененаВручную
		|ИЗ
		|	Документ.УстановкаЦенНоменклатуры.Товары2_5 КАК Строки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УстановкаЦенНоменклатуры КАК Док
		|		ПО Строки.Ссылка = Док.Ссылка
		|ГДЕ
		|	Строки.Номенклатура В (&Номенклатура)
		|	И Строки.ВидЦены = &ВидЦены
		|	И ВЫРАЗИТЬ(Док.Комментарий КАК СТРОКА(100)) = &Комментарий",
		Новый Структура("Номенклатура, ВидЦены, Комментарий", Контекст.Номенклатура, ВидЦены, "тз Заполнить уровни и цены"));
	ДобавитьЗапрос(Строки, "Товары",
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Документ,
		|	Док.Дата КАК Дата,
		|	Док.Статус КАК Статус,
		|	Док.Проведен КАК Проведен,
		|	Док.Комментарий КАК Комментарий,
		|	Строки.НомерСтроки КАК НомерСтроки,
		|	Строки.Номенклатура.Наименование КАК Номенклатура,
		|	Строки.Цена КАК Цена,
		|	Строки.Валюта КАК Валюта,
		|	Строки.Характеристика КАК Характеристика,
		|	Строки.Упаковка КАК Упаковка,
		|	Строки.ЦенаИзмененаВручную КАК ЦенаИзмененаВручную
		|ИЗ
		|	Документ.УстановкаЦенНоменклатуры.Товары КАК Строки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УстановкаЦенНоменклатуры КАК Док
		|		ПО Строки.Ссылка = Док.Ссылка
		|ГДЕ
		|	Строки.Номенклатура В (&Номенклатура)
		|	И Строки.ВидЦены = &ВидЦены
		|	И ВЫРАЗИТЬ(Док.Комментарий КАК СТРОКА(100)) = &Комментарий",
		Новый Структура("Номенклатура, ВидЦены, Комментарий", Контекст.Номенклатура, ВидЦены, "тз Заполнить уровни и цены"));
	
КонецПроцедуры

&НаСервере
Процедура БлокЦенаРМК(Строки, Контекст)
	
	Номенклатура = Контекст.Номенклатура[0];
	Строки.Добавить("Номенклатура: " + ПредставлениеСсылки(Номенклатура));
	Строки.Добавить("Дата: " + Строка(Контекст.Дата));
	Строки.Добавить("Валюта: " + Строка(Контекст.Валюта));
	Строки.Добавить("Вид цен блока 3: " + ПредставлениеСсылки(Контекст.ВидЦенРМК));
	Строки.Добавить("Объект хранения: " + ПредставлениеСсылки(Контекст.ОбъектХранения));
	Результат = ЦенаУсловийРозничныхПродаж(Номенклатура, Контекст.Дата, Контекст.Валюта, Контекст.ОбъектХранения);
	Строки.Добавить("ЗаполнитьУсловияРозничныхПродаж.Цена: " + Строка(Результат.Цена));
	Строки.Добавить("ЗаполнитьУсловияРозничныхПродаж.ВидЦены: " + ПредставлениеСсылки(Результат.ВидЦены));
	ДобавитьЗапрос(Строки, "Ключ характеристики как в запросе РМК",
		"ВЫБРАТЬ
		|	Номенклатура.Наименование КАК Номенклатура,
		|	Номенклатура.ВидНоменклатуры.Наименование КАК ВидНоменклатуры,
		|	ПРЕДСТАВЛЕНИЕ(Номенклатура.ВидНоменклатуры.НастройкиКлючаЦенПоХарактеристике) КАК КлючХарактеристики,
		|	ПРЕДСТАВЛЕНИЕ(Номенклатура.ВидНоменклатуры.НастройкиКлючаЦенПоСерии) КАК КлючСерии,
		|	ПРЕДСТАВЛЕНИЕ(Номенклатура.ВидНоменклатуры.НастройкиКлючаЦенПоУпаковке) КАК КлючУпаковки,
		|	ВЫБОР
		|		КОГДА ВЫБОР
		|				КОГДА Номенклатура.ВидНоменклатуры.НастройкиКлючаЦенПоХарактеристике = ЗНАЧЕНИЕ(Перечисление.ВариантОтбораДляКлючаЦен.НеИспользовать)
		|					ТОГДА ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)
		|				ИНАЧЕ &ПустаяХарактеристика.ХарактеристикаНоменклатурыДляЦенообразования
		|			КОНЕЦ ЕСТЬ NULL
		|			ТОГДА ""NULL""
		|		ИНАЧЕ ""заполнен или пустая ссылка""
		|	КОНЕЦ КАК КлючХарактеристикиРМК
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Номенклатура",
		Новый Структура("Номенклатура, ПустаяХарактеристика", Номенклатура,
			Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()));
	
КонецПроцедуры

&НаСервере
Функция ЦенаУсловийРозничныхПродаж(Номенклатура, Дата, Валюта, ОбъектХранения)
	
	СтрокаТовара = Новый Структура;
	СтрокаТовара.Вставить("Номенклатура", Номенклатура);
	СтрокаТовара.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	СтрокаТовара.Вставить("Серия", Справочники.СерииНоменклатуры.ПустаяСсылка());
	СтрокаТовара.Вставить("Упаковка", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	СтрокаТовара.Вставить("Цена", 0);
	СтрокаТовара.Вставить("ВидЦены", Справочники.ВидыЦен.ПустаяСсылка());
	ПараметрыЦены = Новый Структура;
	ПараметрыЦены.Вставить("Дата", Дата);
	ПараметрыЦены.Вставить("Валюта", Валюта);
	ПараметрыЦены.Вставить("ОбъектХраненияУсловийПродаж", ОбъектХранения);
	Действия = Новый Структура("ЗаполнитьУсловияРозничныхПродаж", ПараметрыЦены);
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТовара, Действия, Неопределено);
	Возврат Новый Структура("Цена, ВидЦены", СтрокаТовара.Цена, СтрокаТовара.ВидЦены);
	
КонецФункции

&НаСервере
Процедура ОписатьВидЦен(Строки, Заголовок, ВидЦены)
	
	Строки.Добавить("--- " + Заголовок + ": " + ПредставлениеСсылки(ВидЦены));
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		Возврат;
	КонецЕсли;
	Имена = "СпособЗаданияЦены, БазовыйВидЦены, Наценка, ВалютаЦены, ЦенаВключаетНДС, ВспомогательнаяЦена, "
		+ "ИспользоватьПриПродаже, ИспользоватьПриРозничнойПродаже, ИспользоватьПриОптовойПродаже, "
		+ "ИспользоватьПриПередачеМеждуОрганизациями, ОграничиватьОтборНоменклатуры, "
		+ "ЗапретитьРедактированиеЦеныЗаПределамиОтбора, Статус, Формула";
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидЦены, Имена);
	Для Каждого Элемент Из Реквизиты Цикл
		Строки.Добавить(Элемент.Ключ + ": " + Строка(Элемент.Значение));
	КонецЦикла;
	Попытка
		Хранилище = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЦены, "ХранилищеНастроекКомпоновкиДанных");
		Настройки = Неопределено;
		Если ТипЗнч(Хранилище) = Тип("ХранилищеЗначения") Тогда
			Настройки = Хранилище.Получить();
		КонецЕсли;
		Строки.Добавить("Отбор номенклатуры задан: " + Строка(Настройки <> Неопределено));
		Если ТипЗнч(Настройки) = Тип("НастройкиКомпоновкиДанных") Тогда
			Строки.Добавить("Отбор: " + Строка(Настройки.Отбор));
		КонецЕсли;
	Исключение
		Строки.Добавить("Ошибка отбора: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ДобавитьЗапрос(Строки, Заголовок + ", ценовые группы",
		"ВЫБРАТЬ
		|	Строки.ЦеноваяГруппа КАК ЦеноваяГруппа,
		|	Строки.БазовыйВидЦены КАК БазовыйВидЦены,
		|	Строки.Наценка КАК Наценка,
		|	Строки.Формула КАК Формула
		|ИЗ
		|	Справочник.ВидыЦен.ЦеновыеГруппы КАК Строки
		|ГДЕ
		|	Строки.Ссылка = &ВидЦены",
		Новый Структура("ВидЦены", ВидЦены));
	ДобавитьЗапрос(Строки, Заголовок + ", влияющие виды",
		"ВЫБРАТЬ
		|	Строки.ВлияющийВидЦен КАК ВлияющийВидЦен
		|ИЗ
		|	Справочник.ВидыЦен.ВлияющиеВидыЦен КАК Строки
		|ГДЕ
		|	Строки.Ссылка = &ВидЦены",
		Новый Структура("ВидЦены", ВидЦены));
	
КонецПроцедуры

&НаСервере
Функция НоменклатураТз()
	
	Имена = Новый Массив;
	Имена.Добавить("Обои Флизелин белые (тз)");
	Имена.Добавить("Обои Винил бежевые (тз)");
	Имена.Добавить("Отходы обойные (тз)");
	Результат = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Результат.Добавить(Справочники.Номенклатура.НайтиПоНаименованию(Имя, Истина));
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьЗапрос(Строки, Заголовок, Текст, Параметры)
	
	Строки.Добавить("-- " + Заголовок);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = Текст;
		Для Каждого Параметр Из Параметры Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
		Таблица = Запрос.Выполнить().Выгрузить();
		Строки.Добавить("Строк: " + Строка(Таблица.Количество()));
		Если Таблица.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		Имена = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Имена.Добавить(Колонка.Имя);
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Имена, " | "));
		Номер = 0;
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Номер = Номер + 1;
			Если Номер > 30 Тогда
				Строки.Добавить("... ещё " + Строка(Таблица.Количество() - 30));
				Прервать;
			КонецЕсли;
			Значения = Новый Массив;
			Для Каждого Имя Из Имена Цикл
				Значения.Добавить(Строка(СтрокаТаблицы[Имя]));
			КонецЦикла;
			Строки.Добавить(СтрСоединить(Значения, " | "));
		КонецЦикла;
	Исключение
		Строки.Добавить("Ошибка запроса: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПредставлениеСсылки(Ссылка)
	
	Если Ссылка = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;
	Возврат Строка(Ссылка) + ", заполнена " + Строка(ЗначениеЗаполнено(Ссылка));
	
КонецФункции
