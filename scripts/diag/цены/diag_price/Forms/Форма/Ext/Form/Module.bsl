Процедура ПриОткрытии(Отказ)
	
	Отказ = Истина;
	ДиагностикаНаСервере();
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ДиагностикаНаСервере()
	
	Строки = Новый Массив;
	Попытка
		СобратьДиагностику(Строки);
	Исключение
		Строки.Добавить("Ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(СтрСоединить(Строки, Символы.ПС));
	Текст.Записать("D:\cursor\TestCoder\scripts\diag_price.txt", КодировкаТекста.UTF8);
	
КонецПроцедуры

&НаСервере
Процедура СобратьДиагностику(Строки)
	
	Дата = ТекущаяДатаСеанса();
	Строки.Добавить("Дата сеанса: " + Строка(Дата));
	Строки.Добавить("ИспользуетсяЦенообразование25: " + Строка(ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25()));
	Строки.Добавить("ИспользуетсяЦенообразование25(дата): " + Строка(ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25(Дата)));
	
	Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию("Обои Флизелин белые (тз)", Истина);
	ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("тз Серебряный", Истина);
	Строки.Добавить("Номенклатура: " + Строка(Номенклатура) + " заполнена " + Строка(ЗначениеЗаполнено(Номенклатура)));
	Строки.Добавить("Вид цен: " + Строка(ВидЦены) + " заполнен " + Строка(ЗначениеЗаполнено(ВидЦены)));
	
	Валюта = ВалютаРубля();
	Организация = Справочники.Организации.ПустаяСсылка();
	ХарактеристикаСтроки = Неопределено;
	УпаковкаСтроки = Неопределено;
	ЦенаВключаетНДСДокумента = "нет заказа";
	ЦенаВключаетНДССоглашения = "нет заказа";
	ЦенаВключаетНДСВидаЦен = "нет вида цен";
	
	Заказ = НайтиЗаказ();
	Если ЗначениеЗаполнено(Заказ) Тогда
		РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Заказ, "Дата, Валюта, Организация, Соглашение, ЦенаВключаетНДС, Партнер");
		Дата = РеквизитыЗаказа.Дата;
		Валюта = РеквизитыЗаказа.Валюта;
		Организация = РеквизитыЗаказа.Организация;
		ЦенаВключаетНДСДокумента = Строка(РеквизитыЗаказа.ЦенаВключаетНДС);
		Строки.Добавить("Заказ: " + Строка(Заказ));
		Строки.Добавить("Дата заказа: " + Строка(Дата));
		Строки.Добавить("Валюта заказа: " + Строка(Валюта));
		Строки.Добавить("Соглашение: " + Строка(РеквизитыЗаказа.Соглашение));
		Строки.Добавить("ЦенаВключаетНДС документа: " + ЦенаВключаетНДСДокумента);
		Если ЗначениеЗаполнено(РеквизитыЗаказа.Соглашение) Тогда
			ЦенаВключаетНДССоглашения = Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				РеквизитыЗаказа.Соглашение, "ЦенаВключаетНДС"));
			Строки.Добавить("ЦенаВключаетНДС соглашения: " + ЦенаВключаетНДССоглашения);
			ВидЦенСоглашения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыЗаказа.Соглашение, "ВидЦен");
			Строки.Добавить("Вид цен соглашения: " + Строка(ВидЦенСоглашения));
			Если ЗначениеЗаполнено(ВидЦенСоглашения) Тогда
				ВидЦены = ВидЦенСоглашения;
			КонецЕсли;
		КонецЕсли;
		СтрокаЗаказа = СтрокаЗаказа(Заказ);
		Если СтрокаЗаказа <> Неопределено Тогда
			Номенклатура = СтрокаЗаказа.Номенклатура;
			ХарактеристикаСтроки = СтрокаЗаказа.Характеристика;
			УпаковкаСтроки = СтрокаЗаказа.Упаковка;
			Строки.Добавить("Строка заказа: " + Строка(СтрокаЗаказа.Номенклатура)
				+ ", цена " + Строка(СтрокаЗаказа.Цена)
				+ ", вид цен строки " + ПредставлениеСсылки(СтрокаЗаказа.ВидЦены));
		КонецЕсли;
	Иначе
		Строки.Добавить("Заказ ТД00-000007 не найден, дата и валюта — текущие.");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидЦены) Тогда
		ЦенаВключаетНДСВидаЦен = Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЦены, "ЦенаВключаетНДС"));
	КонецЕсли;
	Строки.Добавить("ЦенаВключаетНДС вида цен: " + ЦенаВключаетНДСВидаЦен);
	Строки.Добавить("Валюта параметра: " + Строка(Валюта) + ", тип " + Строка(ТипЗнч(Валюта)));
	Строки.Добавить("Характеристика строки: " + ПредставлениеЗначения(ХарактеристикаСтроки));
	Строки.Добавить("Упаковка строки: " + ПредставлениеЗначения(УпаковкаСтроки));
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ВидНоменклатуры");
		Ключи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидНоменклатуры,
			"НастройкиКлючаЦенПоХарактеристике, НастройкиКлючаЦенПоСерии, НастройкиКлючаЦенПоУпаковке");
		Строки.Добавить("Вид номенклатуры: " + Строка(ВидНоменклатуры));
		Строки.Добавить("Ключ характеристики: " + Строка(Ключи.НастройкиКлючаЦенПоХарактеристике));
		Строки.Добавить("Ключ серии: " + Строка(Ключи.НастройкиКлючаЦенПоСерии));
		Строки.Добавить("Ключ упаковки: " + Строка(Ключи.НастройкиКлючаЦенПоУпаковке));
	КонецЕсли;
	
	Строки.Добавить("");
	Строки.Добавить("(а) ПолучитьЦенуПоОтбору, параметры контроля (характеристика и упаковка строки): "
		+ Строка(ЦенаПоОтбору(Дата, Валюта, Номенклатура, ХарактеристикаСтроки, УпаковкаСтроки, ВидЦены)));
	Строки.Добавить("(а-неопределено) ПолучитьЦенуПоОтбору, характеристика и упаковка = Неопределено: "
		+ Строка(ЦенаПоОтбору(Дата, Валюта, Номенклатура, Неопределено, Неопределено, ВидЦены)));
	Строки.Добавить("(б) ПолучитьЦенуПоОтбору, пустые ссылки характеристики и упаковки: "
		+ Строка(ЦенаПоОтбору(Дата, Валюта, Номенклатура,
			Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(),
			Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка(),
			ВидЦены)));
	Строки.Добавить("(в) ЗаполнитьЦены, как форма по виду цен: "
		+ Строка(ЦенаЗаполнитьЦены(Дата, Валюта, Организация, Номенклатура, ХарактеристикаСтроки, УпаковкаСтроки, ВидЦены)));
	
	Строки.Добавить("");
	ДобавитьСрез(Строки, "ЦеныНоменклатуры25", Номенклатура, ВидЦены, Дата);
	ДобавитьСрез(Строки, "ЦеныНоменклатуры", Номенклатура, ВидЦены, Дата);
	
КонецПроцедуры

&НаСервере
Функция НайтиЗаказ()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номер", "ТД00-000007");
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента КАК Заказ
	|ГДЕ
	|	Заказ.Номер = &Номер
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказ.Дата УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Документы.ЗаказКлиента.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция СтрокаЗаказа(Заказ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.ВидЦены КАК ВидЦены,
	|	Товары.Цена КАК Цена
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Номенклатура, Характеристика, Упаковка, ВидЦены, Цена",
		Выборка.Номенклатура, Выборка.Характеристика, Выборка.Упаковка, Выборка.ВидЦены, Выборка.Цена);
	
КонецФункции

&НаСервере
Функция ВалютаРубля()
	
	Валюта = Справочники.Валюты.НайтиПоКоду("643");
	Если ЗначениеЗаполнено(Валюта) Тогда
		Возврат Валюта;
	КонецЕсли;
	Возврат Справочники.Валюты.НайтиПоНаименованию("RUB", Истина);
	
КонецФункции

&НаСервере
Функция ЦенаПоОтбору(Дата, Валюта, Номенклатура, Характеристика, Упаковка, ВидЦены)
	
	ПараметрыОтбора = ЦеныПредприятияЗаполнениеСервер.НовыйПараметрыОтбораПолучитьЦенуПоОтбору();
	ПараметрыОтбора.Дата = Дата;
	ПараметрыОтбора.Валюта = Валюта;
	ПараметрыОтбора.Номенклатура = Номенклатура;
	ПараметрыОтбора.Характеристика = Характеристика;
	ПараметрыОтбора.Упаковка = Упаковка;
	ПараметрыОтбора.ВидЦены = ВидЦены;
	Возврат ЦеныПредприятияЗаполнениеСервер.ПолучитьЦенуПоОтбору(ПараметрыОтбора);
	
КонецФункции

&НаСервере
Функция ЦенаЗаполнитьЦены(Дата, Валюта, Организация, Номенклатура, Характеристика, Упаковка, ВидЦены)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Таблица.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ВидЦены", Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	Таблица.Колонки.Добавить("НоменклатураНабора", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("ХарактеристикаНабора", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	СтрокаТаблицы = Таблица.Добавить();
	СтрокаТаблицы.НомерСтроки = 1;
	СтрокаТаблицы.Номенклатура = Номенклатура;
	СтрокаТаблицы.Характеристика = Характеристика;
	СтрокаТаблицы.Упаковка = Упаковка;
	СтрокаТаблицы.Количество = 9;
	СтрокаТаблицы.КоличествоУпаковок = 9;
	СтрокаТаблицы.Цена = 0;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Дата", Дата);
	ПараметрыЗаполнения.Вставить("Организация", Организация);
	ПараметрыЗаполнения.Вставить("Валюта", Валюта);
	ПараметрыЗаполнения.Вставить("ВидЦены", ВидЦены);
	ПараметрыЗаполнения.Вставить("РассчитыватьНаборы", Ложь);
	ПараметрыЗаполнения.Вставить("ПоляЗаполнения", "Цена, ВидЦены");
	
	ЦеныРассчитаны = ЦеныПредприятияЗаполнениеСервер.ЗаполнитьЦены(Таблица, Неопределено, ПараметрыЗаполнения, Неопределено);
	Возврат "рассчитаны " + Строка(ЦеныРассчитаны) + ", цена " + Строка(Таблица[0].Цена)
		+ ", вид цен строки " + ПредставлениеСсылки(Таблица[0].ВидЦены);
	
КонецФункции

&НаСервере
Процедура ДобавитьСрез(Строки, ИмяРегистра, Номенклатура, ВидЦены, Дата)
	
	Строки.Добавить("Срез " + ИмяРегистра + " по номенклатуре и виду цен:");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений." + ИмяРегистра + ".СрезПоследних(
	|			&Дата,
	|			Номенклатура = &Номенклатура
	|				И ВидЦены = &ВидЦены) КАК Срез";
	Таблица = Запрос.Выполнить().Выгрузить();
	Строки.Добавить("Строк: " + Строка(Таблица.Количество()));
	Номер = 0;
	Для Каждого СтрокаСреза Из Таблица Цикл
		Номер = Номер + 1;
		Строки.Добавить("Запись " + Строка(Номер));
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Строки.Добавить("  " + Колонка.Имя + " = " + Строка(СтрокаСреза[Колонка.Имя]));
		КонецЦикла;
	КонецЦикла;
	Строки.Добавить("");
	
КонецПроцедуры

&НаСервере
Функция ПредставлениеЗначения(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;
	Возврат Строка(ТипЗнч(Значение)) + " [" + Строка(Значение) + "], заполнено " + Строка(ЗначениеЗаполнено(Значение));
	
КонецФункции

&НаСервере
Функция ПредставлениеСсылки(Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "<пустая>";
	КонецЕсли;
	Возврат Строка(Значение);
	
КонецФункции
