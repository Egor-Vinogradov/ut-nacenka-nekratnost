&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Партнер = ПартнерКоманды(ПараметрКоманды);
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите одного партнёра.'"));
		Возврат;
	КонецЕсли;
	
	Состояние = тз_УровниПокупателейВызовСервера.СостояниеУровня(Партнер);
	Список = Новый СписокЗначений;
	Список.Добавить("Бронзовый", НСтр("ru = 'Бронзовый'"));
	Список.Добавить("Серебряный", НСтр("ru = 'Серебряный'"));
	Список.Добавить("Золотой", НСтр("ru = 'Золотой'"));
	Список.Добавить("ПоИНН", НСтр("ru = 'Определять по ИНН (сбросить ручной)'"));
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораУровня", ЭтотОбъект, Партнер);
	Список.ПоказатьВыборЭлемента(Оповещение, Состояние.Представление);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораУровня(ВыбранныйЭлемент, Партнер) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранныйЭлемент.Значение = "ПоИНН" Тогда
		тз_УровниПокупателейВызовСервера.ОпределитьУровеньПоИНН(Партнер);
	Иначе
		тз_УровниПокупателейВызовСервера.УстановитьУровеньПартнера(Партнер, ВыбранныйЭлемент.Значение);
	КонецЕсли;
	
	Состояние = тз_УровниПокупателейВызовСервера.СостояниеУровня(Партнер);
	ПоказатьПредупреждение(, Состояние.Представление);
	ОповеститьОбИзменении(Партнер);
	
КонецПроцедуры

&НаКлиенте
Функция ПартнерКоманды(ПараметрКоманды)
	
	Если ТипЗнч(ПараметрКоманды) = Тип("Массив") Тогда
		Если ПараметрКоманды.Количество() <> 1 Тогда
			Возврат ПредопределенноеЗначение("Справочник.Партнеры.ПустаяСсылка");
		КонецЕсли;
		Возврат ПараметрКоманды[0];
	КонецЕсли;
	
	Возврат ПараметрКоманды;
	
КонецФункции
