// Настройка данных наценки за некратность. Вызывается с клиента общей командой.

#Область ПрограммныйИнтерфейс

// Константа скидок, процент, внешняя обработка, элемент скидки и действие на пустой склад.
// Повторный запуск не создаёт второй элемент. Регистр соглашений уровней только проверяется.
//
// Возвращаемое значение:
//  Строка - протокол шагов
//
Функция ПервоначальнаяНастройка() Экспорт
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Первоначальная настройка доступна только полноправному пользователю.'");
	КонецЕсли;
	
	Протокол = Новый Массив;
	
	НастроитьКонстанты(Протокол);
	Обработка = ЗарегистрироватьВнешнююОбработку(Протокол);
	Скидка = НастроитьСкидку(Обработка, Протокол);
	НастроитьДействиеСкидки(Скидка, Протокол);
	ПроверитьРегистрСоглашенийУровней(Протокол);
	
	Возврат СтрСоединить(Протокол, Символы.ПС);
	
КонецФункции

// Переносит чужие скидки корня в группу «Маркетинговые скидки (тз)»
// и ставит корню совместное применение «Сложение».
// Повторный запуск, если структура уже такая, ничего не пишет.
//
// Возвращаемое значение:
//  Строка - протокол
//
Функция ВключитьНаценкуПоверхСкидок() Экспорт
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Перестройка групп скидок доступна только полноправному пользователю.'");
	КонецЕсли;
	
	Протокол = Новый Массив;
	ПерестроитьГруппыСкидок(Протокол);
	Возврат СтрСоединить(Протокол, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура НастроитьКонстанты(Протокол)
	
	Попытка
		ТекущееЗначение = Константы.ИспользоватьАвтоматическиеСкидкиВПродажах.Получить();
		Если ТекущееЗначение = Истина Тогда
			Протокол.Добавить("Константа ИспользоватьАвтоматическиеСкидкиВПродажах: уже Истина.");
		Иначе
			Константы.ИспользоватьАвтоматическиеСкидкиВПродажах.Установить(Истина);
			Протокол.Добавить("Константа ИспользоватьАвтоматическиеСкидкиВПродажах: установлено Истина.");
		КонецЕсли;
	Исключение
		Протокол.Добавить("Константа ИспользоватьАвтоматическиеСкидкиВПродажах: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		Процент = Константы.тз_ПроцентНаценкиЗаНекратность.Получить();
		Если Не ЗначениеЗаполнено(Процент) Тогда
			Константы.тз_ПроцентНаценкиЗаНекратность.Установить(20);
			Протокол.Добавить("Константа тз_ПроцентНаценкиЗаНекратность: установлено 20.");
		Иначе
			Протокол.Добавить("Константа тз_ПроцентНаценкиЗаНекратность: уже " + Процент + ", без изменений.");
		КонецЕсли;
	Исключение
		Протокол.Добавить("Константа тз_ПроцентНаценкиЗаНекратность: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ЗарегистрироватьВнешнююОбработку(Протокол)
	
	ИмяОбъекта = "тз_РасчетНаценкиЗаНекратность";
	ИмяФайла = ИмяОбъекта + ".epf";
	
	Попытка
		ДвоичныеДанные = ПолучитьОбщийМакет("тз_ВнешняяОбработкаНаценки");
		АдресДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		
		Ссылка = НайтиОбработкуПоИмениОбъекта(ИмяОбъекта);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.ДополнительныеОтчетыИОбработки.СоздатьЭлемент();
			Объект.ИспользоватьДляФормыОбъекта = Истина;
			Объект.ИспользоватьДляФормыСписка = Истина;
			Объект.Ответственный = Пользователи.ТекущийПользователь();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		ПараметрыРегистрации = Новый Структура;
		ПараметрыРегистрации.Вставить("АдресДанныхОбработки", АдресДанных);
		ПараметрыРегистрации.Вставить("ЭтоОтчет", Ложь);
		ПараметрыРегистрации.Вставить("ИмяФайла", ИмяФайла);
		ПараметрыРегистрации.Вставить("ОтключатьКонфликтующие", Ложь);
		ПараметрыРегистрации.Вставить("ОтключатьПубликацию", Ложь);
		
		Объект.Публикация = Перечисления.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется;
		Результат = ДополнительныеОтчетыИОбработки.ЗарегистрироватьОбработку(Объект, ПараметрыРегистрации);
		Если Не Результат.Успех Тогда
			ТекстОшибки = Результат.ТекстОшибки;
			Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
				ТекстОшибки = Результат.КраткоеПредставлениеОшибки;
			КонецЕсли;
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
		Объект.ХранилищеОбработки = Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(9));
		Объект.ИмяОбъекта = ИмяОбъекта;
		Объект.ИмяФайла = ИмяФайла;
		Объект.Записать();
		
		Протокол.Добавить("ДополнительныеОтчетыИОбработки """ + ИмяОбъекта + """: " + ?(ЭтоНовый, "создано", "обновлено") + ".");
		Возврат Объект.Ссылка;
	Исключение
		Протокол.Добавить("ДополнительныеОтчетыИОбработки: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция НайтиОбработкуПоИмениОбъекта(ИмяОбъекта)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обработки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
	|ГДЕ
	|	Обработки.ИмяОбъекта = &ИмяОбъекта
	|	И НЕ Обработки.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	
КонецФункции

Функция НастроитьСкидку(Обработка, Протокол)
	
	Наименование = "Наценка за некратность упаковке";
	
	Если Не ЗначениеЗаполнено(Обработка) Тогда
		Протокол.Добавить("СкидкиНаценки """ + Наименование + """: пропущено, внешняя обработка не зарегистрирована.");
		Возврат Справочники.СкидкиНаценки.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		Ссылка = Константы.тз_СкидкаНаценкаЗаНекратность.Получить();
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Ссылка = НайтиЭлементПоНаименованию("СкидкиНаценки", Наименование);
		КонецЕсли;
		
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.СкидкиНаценки.СоздатьЭлемент();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Объект.Наименование = Наименование;
		Объект.Родитель = Справочники.СкидкиНаценки.КорневаяГруппа;
		Объект.СпособПредоставления = Обработка;
		Объект.Управляемая = Ложь;
		Объект.ВариантОтбораНоменклатуры = Перечисления.ВариантыОтбораНоменклатурыДляРасчетаСкидокНаценок.БезОграничений;
		Объект.ЗначениеСкидкиНаценки = -Константы.тз_ПроцентНаценкиЗаНекратность.Получить();
		Объект.СпособПримененияСкидки = Перечисления.СпособыПримененияСкидокНаценок.ПрименитьВМоментРасчетаСкидокНаценок;
		Объект.Записать();
		
		Константы.тз_СкидкаНаценкаЗаНекратность.Установить(Объект.Ссылка);
		Протокол.Добавить("СкидкиНаценки """ + Наименование + """: " + ?(ЭтоНовый, "создано", "обновлено") + ".");
		Возврат Объект.Ссылка;
	Исключение
		Протокол.Добавить("СкидкиНаценки """ + Наименование + """: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.СкидкиНаценки.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Процедура НастроитьДействиеСкидки(Скидка, Протокол)
	
	Если Не ЗначениеЗаполнено(Скидка) Тогда
		Протокол.Добавить("ДействиеСкидокНаценок: пропущено, элемент скидки не записан.");
		Возврат;
	КонецЕсли;
	
	Попытка
		// Типизированная пустая ссылка. Неопределено в составное измерение не пишем:
		// в представлении записи пустая ссылка склада тоже выглядит пустой строкой.
		ПустойСклад = Справочники.Склады.ПустаяСсылка();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("СкидкаНаценка", Скидка);
		Запрос.УстановитьПараметр("Источник", ПустойСклад);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Срез.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ДействиеСкидокНаценок.СрезПоследних(
		|			&ТекущаяДата,
		|			СкидкаНаценка = &СкидкаНаценка
		|				И Источник = &Источник) КАК Срез";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий()
			И Выборка.Статус = Перечисления.СтатусыДействияСкидок.Действует Тогда
			Протокол.Добавить("ДействиеСкидокНаценок, пустой склад: уже действует.");
			Возврат;
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.ДействиеСкидокНаценок.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = '20000101';
		МенеджерЗаписи.Источник = ПустойСклад;
		МенеджерЗаписи.СкидкаНаценка = Скидка;
		МенеджерЗаписи.Статус = Перечисления.СтатусыДействияСкидок.Действует;
		МенеджерЗаписи.Ответственный = Пользователи.ТекущийПользователь();
		МенеджерЗаписи.Записать(Истина);
		Протокол.Добавить("ДействиеСкидокНаценок, пустой склад: записано, статус Действует, период 01.01.2000.");
	Исключение
		Протокол.Добавить("ДействиеСкидокНаценок: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ПроверитьРегистрСоглашенийУровней(Протокол)
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.тз_СоглашенияУровней КАК СоглашенияУровней
		|ГДЕ
		|	СоглашенияУровней.Соглашение <> ЗНАЧЕНИЕ(Справочник.СоглашенияСКлиентами.ПустаяСсылка)";
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Если Выборка.Количество = 0 Тогда
			Протокол.Добавить("Регистр «тз Соглашения уровней» не заполнен. Для каждого уровня укажите типовое соглашение и вид цен: Бронзовый, Серебряный, Золотой.");
		Иначе
			Протокол.Добавить("Регистр «тз Соглашения уровней»: заполнено записей " + Выборка.Количество + ".");
		КонецЕсли;
	Исключение
		Протокол.Добавить("Регистр «тз Соглашения уровней»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция НайтиЭлементПоНаименованию(ИмяСправочника, Наименование)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Справочник.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Справочник
	|ГДЕ
	|	Справочник.Наименование = &Наименование
	|	И НЕ Справочник.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ПерестроитьГруппыСкидок(Протокол)
	
	ИмяГруппы = "Маркетинговые скидки (тз)";
	Корень = Справочники.СкидкиНаценки.КорневаяГруппа;
	НашаНаценка = Константы.тз_СкидкаНаценкаЗаНекратность.Получить();
	РеквизитыКорня = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Корень, "ВариантСовместногоПрименения, ВариантРасчетаРезультатаСовместногоПрименения");
	ПрежнийВариант = РеквизитыКорня.ВариантСовместногоПрименения;
	ПрежнийРасчет = РеквизитыКорня.ВариантРасчетаРезультатаСовместногоПрименения;
	
	Группа = НайтиГруппуМаркетинговыхСкидок(Корень, ИмяГруппы);
	ДетиКорня = ПрямыеДети(Корень);
	
	Если СтруктураУжеНастроена(ДетиКорня, Группа, НашаНаценка, ПрежнийВариант, ПрежнийРасчет) Тогда
		Протокол.Добавить("уже настроено. Корень: " + ПрежнийВариант + ", " + ПрежнийРасчет
			+ ". Группа """ + ИмяГруппы + """ есть, чужие скидки внутри неё, наценка за некратность осталась в корне.");
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Если Не ЗначениеЗаполнено(Группа) Тогда
			ОбъектГруппы = Справочники.СкидкиНаценки.СоздатьГруппу();
			ОбъектГруппы.Наименование = ИмяГруппы;
			ОбъектГруппы.Родитель = Корень;
			ОбъектГруппы.ВариантСовместногоПрименения = ПрежнийВариант;
			ОбъектГруппы.ВариантРасчетаРезультатаСовместногоПрименения = ПрежнийРасчет;
			ОбъектГруппы.Записать();
			Группа = ОбъектГруппы.Ссылка;
			Протокол.Добавить("Группа """ + ИмяГруппы + """ создана: " + ПрежнийВариант + ", " + ПрежнийРасчет + ".");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НашаНаценка) Тогда
			РодительНаценки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НашаНаценка, "Родитель");
			Если РодительНаценки <> Корень Тогда
				ОбъектНаценки = НашаНаценка.ПолучитьОбъект();
				ОбъектНаценки.Родитель = Корень;
				ОбъектНаценки.Записать();
				Протокол.Добавить("Наценка за некратность возвращена в корень.");
			КонецЕсли;
		Иначе
			Протокол.Добавить("Константа тз_СкидкаНаценкаЗаНекратность пуста: наценку среди детей корня отличить нельзя.");
		КонецЕсли;
		
		Перенесено = 0;
		Для Каждого Ребенок Из ДетиКорня Цикл
			Если Ребенок = Группа Или Ребенок = НашаНаценка Тогда
				Продолжить;
			КонецЕсли;
			ОбъектРебенка = Ребенок.ПолучитьОбъект();
			ОбъектРебенка.Родитель = Группа;
			ОбъектРебенка.Записать();
			Перенесено = Перенесено + 1;
		КонецЦикла;
		
		ОбъектКорня = Корень.ПолучитьОбъект();
		ОбъектКорня.ВариантСовместногоПрименения = Перечисления.ВариантыСовместногоПримененияСкидокНаценок.Сложение;
		ОбъектКорня.Записать();
		
		ЗафиксироватьТранзакцию();
		Протокол.Добавить("Перенесено в """ + ИмяГруппы + """: " + Перенесено + ".");
		Протокол.Добавить("Корень было: " + ПрежнийВариант + ", " + ПрежнийРасчет + ".");
		Протокол.Добавить("Корень стало: "
			+ Перечисления.ВариантыСовместногоПримененияСкидокНаценок.Сложение + ", " + ПрежнийРасчет + ".");
		Протокол.Добавить("Обратной команды нет. Чтобы вернуть структуру, прежний вариант корня: " + ПрежнийВариант + ".");
	Исключение
		ОтменитьТранзакцию();
		Протокол.Добавить("Перестройка групп: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция СтруктураУжеНастроена(ДетиКорня, Группа, НашаНаценка, ВариантКорня, РасчетКорня)
	
	Если Не ЗначениеЗаполнено(Группа) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ВариантКорня <> Перечисления.ВариантыСовместногоПримененияСкидокНаценок.Сложение Тогда
		Возврат Ложь;
	КонецЕсли;
	Если РасчетКорня <> Перечисления.ВариантыРасчетаРезультатаСовместногоПрименения.ПоСтроке Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(НашаНаценка) Тогда
		РодительНаценки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НашаНаценка, "Родитель");
		Если РодительНаценки <> Справочники.СкидкиНаценки.КорневаяГруппа Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Ребенок Из ДетиКорня Цикл
		Если Ребенок <> Группа И Ребенок <> НашаНаценка Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция НайтиГруппуМаркетинговыхСкидок(Корень, ИмяГруппы)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Родитель", Корень);
	Запрос.УстановитьПараметр("Наименование", ИмяГруппы);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Скидки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СкидкиНаценки КАК Скидки
	|ГДЕ
	|	Скидки.Родитель = &Родитель
	|	И Скидки.ЭтоГруппа
	|	И Скидки.Наименование = &Наименование
	|	И НЕ Скидки.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.СкидкиНаценки.ПустаяСсылка();
	
КонецФункции

Функция ПрямыеДети(Корень)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Родитель", Корень);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Скидки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СкидкиНаценки КАК Скидки
	|ГДЕ
	|	Скидки.Родитель = &Родитель
	|	И НЕ Скидки.ПометкаУдаления";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

#КонецОбласти
