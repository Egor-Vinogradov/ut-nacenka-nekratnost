// Уровни покупателей, сегменты, виды цен и соглашения.
// Привилегированный режим включается только на время чтения и записи регистров уровня
// и состава сегментов и сразу выключается. Запись сегмента и регистров недоступна роли
// тз_ОбщиеПрава, а обработчики записи партнёра и контрагента выполняются любым пользователем.

#Область ПрограммныйИнтерфейс

// Уровень партнёра. Нет записи регистра — Бронзовый.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//
// Возвращаемое значение:
//  ПеречислениеСсылка.тз_УровниПокупателей
//
Функция УровеньПартнера(Партнер) Экспорт
	
	Состояние = СостояниеУровня(Партнер);
	Возврат Состояние.Уровень;
	
КонецФункции

// Текущий уровень и признак ручного задания.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//
// Возвращаемое значение:
//  Структура - Уровень, ЗаданВручную, ЕстьЗапись, Представление
//
Функция СостояниеУровня(Партнер) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Уровень", Перечисления.тз_УровниПокупателей.Бронзовый);
	Результат.Вставить("ЗаданВручную", Ложь);
	Результат.Вставить("ЕстьЗапись", Ложь);
	Результат.Вставить("Представление", "");
	
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Результат.Представление = "Партнёр не выбран.";
		Возврат Результат;
	КонецЕсли;
	
	Менеджер = РегистрыСведений.тз_УровниПартнеров.СоздатьМенеджерЗаписи();
	Менеджер.Партнер = Партнер;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() И ЗначениеЗаполнено(Менеджер.Уровень) Тогда
		Результат.Уровень = Менеджер.Уровень;
		Результат.ЗаданВручную = Менеджер.ЗаданВручную;
		Результат.ЕстьЗапись = Истина;
		Если Менеджер.ЗаданВручную Тогда
			Признак = "задан вручную";
		Иначе
			Признак = "по ИНН или по умолчанию";
		КонецЕсли;
		Результат.Представление = "Текущий уровень: " + Строка(Менеджер.Уровень) + ", " + Признак + ".";
	Иначе
		Результат.Представление = "Текущий уровень: Бронзовый, по умолчанию (записи нет).";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записывает уровень и переносит партнёра между тремя сегментами «тз … покупатели».
// Другие сегменты не изменяет. Повторный вызов с теми же данными ничего не пишет.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//  Уровень - ПеречислениеСсылка.тз_УровниПокупателей
//  ЗаданВручную - Булево
//
// Возвращаемое значение:
//  Булево - Истина, если регистр или состав сегментов изменились
//
Функция УстановитьУровеньПартнера(Партнер, Уровень, ЗаданВручную) Экспорт
	
	Если Не ЗначениеЗаполнено(Партнер) Или Не ЗначениеЗаполнено(Уровень) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Привилегированный режим: роль тз_ОбщиеПрава регистры уровней и сегменты не изменяет.
	БылПривилегированный = ПривилегированныйРежим();
	Если Не БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Изменено = ЗаписатьУровеньПартнера(Партнер, Уровень, ЗаданВручную);
		Если ПеренестиМеждуСегментамиУровня(Партнер, Уровень) Тогда
			Изменено = Истина;
		КонецЕсли;
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	Исключение
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Изменено;
	
КонецФункции

// Уровень по ИНН. Нет строки — Неопределено.
//
// Параметры:
//  ИНН - Строка
//
// Возвращаемое значение:
//  ПеречислениеСсылка.тз_УровниПокупателей, Неопределено
//
Функция УровеньПоИНН(ИНН) Экспорт
	
	ИНН = СокрЛП(ИНН);
	Если ПустаяСтрока(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Менеджер = РегистрыСведений.тз_УровниПокупателейПоИНН.СоздатьМенеджерЗаписи();
	Менеджер.ИНН = ИНН;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Или Не ЗначениеЗаполнено(Менеджер.Уровень) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Менеджер.Уровень;
	
КонецФункции

// Если уровень партнёра не задан вручную и ИНН есть в регистре — устанавливает уровень.
// Ручной уровень не перезаписывает.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты, СправочникОбъект.Контрагенты
//
// Возвращаемое значение:
//  Булево - Истина, если уровень изменился
//
Функция ПрименитьУровеньПоИНН(Контрагент) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Контрагент) = Тип("СправочникОбъект.Контрагенты") Тогда
		Партнер = Контрагент.Партнер;
		ИНН = Контрагент.ИНН;
	Иначе
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "Партнер, ИНН");
		Партнер = Реквизиты.Партнер;
		ИНН = Реквизиты.ИНН;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Состояние = СостояниеУровня(Партнер);
	Если Состояние.ЕстьЗапись И Состояние.ЗаданВручную Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Уровень = УровеньПоИНН(ИНН);
	Если Уровень = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат УстановитьУровеньПартнера(Партнер, Уровень, Ложь);
	
КонецФункции

// Сбрасывает ручной признак и ставит уровень по ИНН контрагента, иначе Бронзовый.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//
// Возвращаемое значение:
//  Булево - Истина, если уровень изменился
//
Функция ОпределитьУровеньПоИНН(Партнер) Экспорт
	
	Уровень = Неопределено;
	ИНН = ИННПартнера(Партнер);
	Если ЗначениеЗаполнено(ИНН) Тогда
		Уровень = УровеньПоИНН(ИНН);
	КонецЕсли;
	Если Уровень = Неопределено Тогда
		Уровень = Перечисления.тз_УровниПокупателей.Бронзовый;
	КонецЕсли;
	
	Возврат УстановитьУровеньПартнера(Партнер, Уровень, Ложь);
	
КонецФункции

// Бронзовый для нового партнёра-клиента, у которого ещё нет записи уровня.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//  ЭтоКлиент - Булево
//
Процедура УстановитьБронзовыйНовомуПартнеру(Партнер, ЭтоКлиент) Экспорт
	
	Если Не ЭтоКлиент Или Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат;
	КонецЕсли;
	Если СостояниеУровня(Партнер).ЕстьЗапись Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьУровеньПартнера(Партнер, Перечисления.тз_УровниПокупателей.Бронзовый, Ложь);
	
КонецПроцедуры

// Разбирает CSV «ИНН;Уровень», пишет регистр и применяет уровень контрагентам.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные
//
// Возвращаемое значение:
//  Строка - протокол: загружено / ошибок / применено
//
Функция ЗагрузитьУровниИзДвоичныхДанных(ДвоичныеДанные) Экспорт
	
	Текст = ТекстCSV(ДвоичныеДанные);
	Загружено = 0;
	Ошибок = 0;
	Применено = 0;
	ПропущеноРучных = 0;
	СтрокиТекста = СтрРазделить(Текст, Символы.ПС, Ложь);
	ИННФайла = Новый Массив;
	ПерваяСтрока = Истина;
	
	Для Каждого СтрокаТекста Из СтрокиТекста Цикл
		
		СтрокаТекста = СокрЛП(СтрЗаменить(СтрокаТекста, Символы.ВК, ""));
		Если ПустаяСтрока(СтрокаТекста) Тогда
			Продолжить;
		КонецЕсли;
		
		Части = СтрРазделить(СтрокаТекста, ";");
		Если Части.Количество() < 2 Тогда
			Ошибок = Ошибок + 1;
			Продолжить;
		КонецЕсли;
		
		ИНН = СокрЛП(Части[0]);
		ИмяУровня = СокрЛП(Части[1]);
		Если ПерваяСтрока И Не ЭтоИНН(ИНН) Тогда
			ПерваяСтрока = Ложь;
			Продолжить;
		КонецЕсли;
		ПерваяСтрока = Ложь;
		
		Уровень = УровеньПоПредставлению(ИмяУровня);
		Если Уровень = Неопределено Или Не ЭтоИНН(ИНН) Тогда
			Ошибок = Ошибок + 1;
			Продолжить;
		КонецЕсли;
		
		ЗаписатьУровеньИНН(ИНН, Уровень);
		Загружено = Загружено + 1;
		ИННФайла.Добавить(ИНН);
		
	КонецЦикла;
	
	Если ИННФайла.Количество() > 0 Тогда
		ПрименитьИННККонтрагентам(ИННФайла, Применено, ПропущеноРучных);
	КонецЕсли;
	
	Возврат СтрШаблон(
		"Загружено: %1. Ошибок: %2. Применено: %3. Пропущено из-за ручного уровня: %4.",
		Загружено, Ошибок, Применено, ПропущеноРучных);
	
КонецФункции

// Подменяет результат типового подбора, если вернулось не индивидуальное соглашение этого партнёра.
// Партнёр без записи уровня не меняется. Поля результата берёт ПродажиСервер.ПолучитьУсловияПродаж.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//  ПараметрыОтбора - Структура, Неопределено
//  СоглашенияПрименимы - Булево
//  Результат - Структура, Неопределено - то, что вернула типовая функция
//
// Возвращаемое значение:
//  Структура, Неопределено
//
Функция УсловияПродажПоУровню(Партнер, ПараметрыОтбора, СоглашенияПрименимы, Результат) Экспорт
	
	Если СоглашенияПрименимы = Ложь
		Или Не ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами")
		Или Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЭтоИндивидуальноеСоглашениеПартнера(Результат, Партнер) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Уровень = УровеньЗаписиПартнера(Партнер);
	Если Уровень = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Ссылки = СсылкиУровня(Уровень);
	Если Не ЗначениеЗаполнено(Ссылки.Соглашение) Тогда
		Возврат Результат;
	КонецЕсли;
	
	УчитыватьГруппы = Ложь;
	ИсключитьГруппы = Ложь;
	Если ТипЗнч(ПараметрыОтбора) = Тип("Структура") Тогда
		Если ПараметрыОтбора.Свойство("УчитыватьГруппыСкладов") Тогда
			УчитыватьГруппы = ПараметрыОтбора.УчитыватьГруппыСкладов;
		КонецЕсли;
		Если ПараметрыОтбора.Свойство("ИсключитьГруппыСкладовДоступныеВЗаказах") Тогда
			ИсключитьГруппы = ПараметрыОтбора.ИсключитьГруппыСкладовДоступныеВЗаказах;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПродажиСервер.ПолучитьУсловияПродаж(Ссылки.Соглашение, УчитыватьГруппы, ИсключитьГруппы);
	
КонецФункции

// Вид цен уровня. Нет записи в тз_УровниПартнеров — пустая ссылка.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыЦен
//
Функция ВидЦеныУровняПартнера(Партнер) Экспорт
	
	Уровень = УровеньЗаписиПартнера(Партнер);
	Если Уровень = Неопределено Тогда
		Возврат Справочники.ВидыЦен.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СсылкиУровня(Уровень).ВидЦены;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоИндивидуальноеСоглашениеПартнера(Результат, Партнер)
	
	Если ТипЗнч(Результат) <> Тип("Структура")
		Или Не Результат.Свойство("Соглашение")
		Или Не ЗначениеЗаполнено(Результат.Соглашение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Результат.Соглашение, "Типовое, Партнер");
	Возврат Не Реквизиты.Типовое И Реквизиты.Партнер = Партнер;
	
КонецФункции

Функция УровеньЗаписиПартнера(Партнер)
	
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Привилегированный режим: роль тз_ОбщиеПрава регистры уровней и сегменты не изменяет.
	БылПривилегированный = ПривилегированныйРежим();
	Если Не БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Менеджер = РегистрыСведений.тз_УровниПартнеров.СоздатьМенеджерЗаписи();
		Менеджер.Партнер = Партнер;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() И ЗначениеЗаполнено(Менеджер.Уровень) Тогда
			Уровень = Менеджер.Уровень;
		Иначе
			Уровень = Неопределено;
		КонецЕсли;
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	Исключение
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Уровень;
	
КонецФункции

Функция СсылкиУровня(Уровень)
	
	Результат = Новый Структура("Соглашение, ВидЦены",
		Справочники.СоглашенияСКлиентами.ПустаяСсылка(),
		Справочники.ВидыЦен.ПустаяСсылка());
	Если Не ЗначениеЗаполнено(Уровень) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Привилегированный режим: роль тз_ОбщиеПрава регистры уровней и сегменты не изменяет.
	БылПривилегированный = ПривилегированныйРежим();
	Если Не БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Менеджер = РегистрыСведений.тз_СоглашенияУровней.СоздатьМенеджерЗаписи();
		Менеджер.Уровень = Уровень;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() Тогда
			Результат.Соглашение = Менеджер.Соглашение;
			Результат.ВидЦены = Менеджер.ВидЦены;
		КонецЕсли;
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	Исключение
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаписатьУровеньПартнера(Партнер, Уровень, ЗаданВручную)
	
	Менеджер = РегистрыСведений.тз_УровниПартнеров.СоздатьМенеджерЗаписи();
	Менеджер.Партнер = Партнер;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() И Менеджер.Уровень = Уровень И Менеджер.ЗаданВручную = ЗаданВручную Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Менеджер.Партнер = Партнер;
	Менеджер.Уровень = Уровень;
	Менеджер.ЗаданВручную = ЗаданВручную;
	Менеджер.Записать();
	Возврат Истина;
	
КонецФункции

Функция ПеренестиМеждуСегментамиУровня(Партнер, Уровень)
	
	// Сегмент берётся из соглашения, записанного в тз_СоглашенияУровней.
	// Сегменты по наименованию не создаются.
	СегментыУровней = СегментыСоглашенийУровней();
	ЦелевойСегмент = СегментыУровней.Получить(Уровень);
	Изменено = Ложь;
	Обработанные = Новый Соответствие;
	
	Для Каждого ПараСегмента Из СегментыУровней Цикл
		Сегмент = ПараСегмента.Значение;
		Если Не ЗначениеЗаполнено(Сегмент) Или Обработанные.Получить(Сегмент) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(Сегмент, Истина);
		Если Сегмент = ЦелевойСегмент Тогда
			Если ОбеспечитьЗаписьСегмента(Сегмент, Партнер) Тогда
				Изменено = Истина;
			КонецЕсли;
		Иначе
			Если УдалитьЗаписьСегмента(Сегмент, Партнер) Тогда
				Изменено = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Изменено;
	
КонецФункции

Функция СегментыСоглашенийУровней()
	
	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоглашенияУровней.Уровень КАК Уровень,
	|	СоглашенияУровней.Соглашение.СегментПартнеров КАК Сегмент
	|ИЗ
	|	РегистрСведений.тз_СоглашенияУровней КАК СоглашенияУровней";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Уровень, Выборка.Сегмент);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция ОбеспечитьЗаписьСегмента(Сегмент, Партнер)
	
	Менеджер = РегистрыСведений.ПартнерыСегмента.СоздатьМенеджерЗаписи();
	Менеджер.Сегмент = Сегмент;
	Менеджер.Партнер = Партнер;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;
	Менеджер.Сегмент = Сегмент;
	Менеджер.Партнер = Партнер;
	Менеджер.Записать();
	Возврат Истина;
	
КонецФункции

Функция УдалитьЗаписьСегмента(Сегмент, Партнер)
	
	Менеджер = РегистрыСведений.ПартнерыСегмента.СоздатьМенеджерЗаписи();
	Менеджер.Сегмент = Сегмент;
	Менеджер.Партнер = Партнер;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;
	Менеджер.Удалить();
	Возврат Истина;
	
КонецФункции

Функция ЗаписатьУровеньИНН(ИНН, Уровень)
	
	// Привилегированный режим: роль тз_ОбщиеПрава регистры уровней и сегменты не изменяет.
	БылПривилегированный = ПривилегированныйРежим();
	Если Не БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Менеджер = РегистрыСведений.тз_УровниПокупателейПоИНН.СоздатьМенеджерЗаписи();
		Менеджер.ИНН = ИНН;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() И Менеджер.Уровень = Уровень Тогда
			Изменено = Ложь;
		Иначе
			Менеджер.ИНН = ИНН;
			Менеджер.Уровень = Уровень;
			Менеджер.Записать();
			Изменено = Истина;
		КонецЕсли;
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	Исключение
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Изменено;
	
КонецФункции

Процедура ПрименитьИННККонтрагентам(ИННФайла, Применено, ПропущеноРучных)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.Партнер КАК Партнер,
	|	Контрагенты.ИНН КАК ИНН
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН В (&ИНН)
	|	И НЕ Контрагенты.ПометкаУдаления
	|	И Контрагенты.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ИНН", ИННФайла);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Состояние = СостояниеУровня(Выборка.Партнер);
		Если Состояние.ЕстьЗапись И Состояние.ЗаданВручную Тогда
			ПропущеноРучных = ПропущеноРучных + 1;
			Продолжить;
		КонецЕсли;
		Если ПрименитьУровеньПоИНН(Выборка.Ссылка) Тогда
			Применено = Применено + 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстCSV(ДвоичныеДанные)
	
	ТекстUTF8 = ТекстВКодировке(ДвоичныеДанные, КодировкаТекста.UTF8);
	Текст1251 = ТекстВКодировке(ДвоичныеДанные, "windows-1251");
	Если КоличествоРаспознанныхУровней(Текст1251) > КоличествоРаспознанныхУровней(ТекстUTF8) Тогда
		Возврат Текст1251;
	КонецЕсли;
	Возврат ТекстUTF8;
	
КонецФункции

Функция ТекстВКодировке(ДвоичныеДанные, Кодировка)
	
	Попытка
		Возврат ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, Кодировка);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция КоличествоРаспознанныхУровней(Текст)
	
	Количество = 0;
	Для Каждого СтрокаТекста Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Части = СтрРазделить(СокрЛП(СтрЗаменить(СтрокаТекста, Символы.ВК, "")), ";");
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Если УровеньПоПредставлению(СокрЛП(Части[1])) <> Неопределено Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
	
КонецФункции

Функция ЭтоИНН(ИНН)
	
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(ИНН) Цикл
		Символ = Сред(ИНН, Индекс, 1);
		Если Символ < "0" Или Символ > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция УровеньПоПредставлению(ИмяУровня)
	
	Ключ = НРег(СокрЛП(ИмяУровня));
	Если Ключ = "1" Или Ключ = "бронзовый" Тогда
		Возврат Перечисления.тз_УровниПокупателей.Бронзовый;
	ИначеЕсли Ключ = "2" Или Ключ = "серебряный" Тогда
		Возврат Перечисления.тз_УровниПокупателей.Серебряный;
	ИначеЕсли Ключ = "3" Или Ключ = "золотой" Тогда
		Возврат Перечисления.тз_УровниПокупателей.Золотой;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ИННПартнера(Партнер)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.ИНН КАК ИНН
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Партнер = &Партнер
	|	И НЕ Контрагенты.ПометкаУдаления
	|	И Контрагенты.ИНН <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагенты.ИНН";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.ИНН);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти
