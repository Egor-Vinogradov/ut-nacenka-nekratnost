// Вызовы сервера для команд уровней. Серверный модуль с клиента недоступен.

#Область ПрограммныйИнтерфейс

Функция СостояниеУровня(Партнер) Экспорт
	
	Возврат тз_УровниПокупателейСервер.СостояниеУровня(Партнер);
	
КонецФункции

Процедура УстановитьУровеньПартнера(Партнер, ИмяУровня) Экспорт
	
	Уровень = УровеньПоИмени(ИмяУровня);
	Если Уровень = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестный уровень покупателя.'");
	КонецЕсли;
	тз_УровниПокупателейСервер.УстановитьУровеньПартнера(Партнер, Уровень, Истина);
	
КонецПроцедуры

Процедура ОпределитьУровеньПоИНН(Партнер) Экспорт
	
	тз_УровниПокупателейСервер.ОпределитьУровеньПоИНН(Партнер);
	
КонецПроцедуры

Функция ЗагрузитьУровниИзФайла(Адрес) Экспорт
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Возврат НСтр("ru = 'Файл не получен.'");
	КонецЕсли;
	Возврат тз_УровниПокупателейСервер.ЗагрузитьУровниИзДвоичныхДанных(ДвоичныеДанные);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УровеньПоИмени(ИмяУровня)
	
	Если ИмяУровня = "Бронзовый" Тогда
		Возврат Перечисления.тз_УровниПокупателей.Бронзовый;
	ИначеЕсли ИмяУровня = "Серебряный" Тогда
		Возврат Перечисления.тз_УровниПокупателей.Серебряный;
	ИначеЕсли ИмяУровня = "Золотой" Тогда
		Возврат Перечисления.тз_УровниПокупателей.Золотой;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти
