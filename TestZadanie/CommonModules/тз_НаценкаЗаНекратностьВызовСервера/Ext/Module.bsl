	|	Упаковки.Владелец = &Владелец
	|	И Упаковки.Наименование = &Наименование
	|	И НЕ Упаковки.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
