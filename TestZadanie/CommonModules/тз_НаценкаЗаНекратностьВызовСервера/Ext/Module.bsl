Процедура ПерестроитьГруппыСкидок(Протокол)
	
	ИмяГруппы = "Маркетинговые скидки (тз)";
	Корень = Справочники.СкидкиНаценки.КорневаяГруппа;
	НашаНаценка = Константы.тз_СкидкаНаценкаЗаНекратность.Получить();
	РеквизитыКорня = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Корень, "ВариантСовместногоПрименения, ВариантРасчетаРезультатаСовместногоПрименения");
	ПрежнийВариант = РеквизитыКорня.ВариантСовместногоПрименения;
	ПрежнийРасчет = РеквизитыКорня.ВариантРасчетаРезультатаСовместногоПрименения;
	
	Группа = НайтиГруппуМаркетинговыхСкидок(Корень, ИмяГруппы);
	ДетиКорня = ПрямыеДети(Корень);
	
	Если СтруктураУжеНастроена(ДетиКорня, Группа, НашаНаценка, ПрежнийВариант, ПрежнийРасчет) Тогда
		Протокол.Добавить("уже настроено. Корень: " + ПрежнийВариант + ", " + ПрежнийРасчет
			+ ". Группа """ + ИмяГруппы + """ есть, чужие скидки внутри неё, наценка за некратность осталась в корне.");
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Если Не ЗначениеЗаполнено(Группа) Тогда
			ОбъектГруппы = Справочники.СкидкиНаценки.СоздатьГруппу();
			ОбъектГруппы.Наименование = ИмяГруппы;
			ОбъектГруппы.Родитель = Корень;
			ОбъектГруппы.ВариантСовместногоПрименения = ПрежнийВариант;
			ОбъектГруппы.ВариантРасчетаРезультатаСовместногоПрименения = ПрежнийРасчет;
			ОбъектГруппы.Записать();
			Группа = ОбъектГруппы.Ссылка;
			Протокол.Добавить("Группа """ + ИмяГруппы + """ создана: " + ПрежнийВариант + ", " + ПрежнийРасчет + ".");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НашаНаценка) Тогда
			РодительНаценки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НашаНаценка, "Родитель");
			Если РодительНаценки <> Корень Тогда
				ОбъектНаценки = НашаНаценка.ПолучитьОбъект();
				ОбъектНаценки.Родитель = Корень;
				ОбъектНаценки.Записать();
				Протокол.Добавить("Наценка за некратность возвращена в корень.");
			КонецЕсли;
		Иначе
			Протокол.Добавить("Константа тз_СкидкаНаценкаЗаНекратность пуста: наценку среди детей корня отличить нельзя.");
		КонецЕсли;
		
		Перенесено = 0;
		Для Каждого Ребенок Из ДетиКорня Цикл
			Если Ребенок = Группа Или Ребенок = НашаНаценка Тогда
				Продолжить;
			КонецЕсли;
			ОбъектРебенка = Ребенок.ПолучитьОбъект();
			ОбъектРебенка.Родитель = Группа;
			ОбъектРебенка.Записать();
			Перенесено = Перенесено + 1;
		КонецЦикла;
		
		ОбъектКорня = Корень.ПолучитьОбъект();
		ОбъектКорня.ВариантСовместногоПрименения = Перечисления.ВариантыСовместногоПримененияСкидокНаценок.Сложение;
		ОбъектКорня.Записать();
		
		ЗафиксироватьТранзакцию();
		Протокол.Добавить("Перенесено в """ + ИмяГруппы + """: " + Перенесено + ".");
		Протокол.Добавить("Корень было: " + ПрежнийВариант + ", " + ПрежнийРасчет + ".");
		Протокол.Добавить("Корень стало: "
			+ Перечисления.ВариантыСовместногоПримененияСкидокНаценок.Сложение + ", " + ПрежнийРасчет + ".");
		Протокол.Добавить("Обратной команды нет. Чтобы вернуть структуру, прежний вариант корня: " + ПрежнийВариант + ".");
	Исключение
		ОтменитьТранзакцию();
		Протокол.Добавить("Перестройка групп: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция СтруктураУжеНастроена(ДетиКорня, Группа, НашаНаценка, ВариантКорня, РасчетКорня)
	
	Если Не ЗначениеЗаполнено(Группа) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ВариантКорня <> Перечисления.ВариантыСовместногоПримененияСкидокНаценок.Сложение Тогда
		Возврат Ложь;
	КонецЕсли;
	Если РасчетКорня <> Перечисления.ВариантыРасчетаРезультатаСовместногоПрименения.ПоСтроке Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(НашаНаценка) Тогда
		РодительНаценки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НашаНаценка, "Родитель");
		Если РодительНаценки <> Справочники.СкидкиНаценки.КорневаяГруппа Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Ребенок Из ДетиКорня Цикл
		Если Ребенок <> Группа И Ребенок <> НашаНаценка Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция НайтиГруппуМаркетинговыхСкидок(Корень, ИмяГруппы)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Родитель", Корень);
	Запрос.УстановитьПараметр("Наименование", ИмяГруппы);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Скидки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СкидкиНаценки КАК Скидки
	|ГДЕ
	|	Скидки.Родитель = &Родитель
	|	И Скидки.ЭтоГруппа
	|	И Скидки.Наименование = &Наименование
	|	И НЕ Скидки.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.СкидкиНаценки.ПустаяСсылка();
	
КонецФункции

Функция ПрямыеДети(Корень)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Родитель", Корень);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Скидки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СкидкиНаценки КАК Скидки
	|ГДЕ
	|	Скидки.Родитель = &Родитель
	|	И НЕ Скидки.ПометкаУдаления";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

