КонецФункции

Функция ОбеспечитьВидНоменклатуры(Наименование, Единица, ИспользоватьУпаковки, Набор, Протокол)
	
	Если Не ЗначениеЗаполнено(Единица) Тогда
		Протокол.Добавить("Вид номенклатуры «" + Наименование + "»: пропущено, нет единицы измерения.");
		Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	Если ИспользоватьУпаковки И Не ЗначениеЗаполнено(Набор) Тогда
		Протокол.Добавить("Вид номенклатуры «" + Наименование + "»: пропущено, нет набора упаковок.");
		Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		Ссылка = НайтиЭлементПоНаименованию("ВидыНоменклатуры", Наименование);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Объект.Наименование = Наименование;
		Объект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
		Объект.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
		Объект.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
		Объект.ЕдиницаИзмерения = Единица;
		Объект.ЕдиницаДляОтчетов = Единица;
		Объект.КоэффициентЕдиницыДляОтчетов = 1;
		Объект.ИспользоватьУпаковки = ИспользоватьУпаковки;
		Если ИспользоватьУпаковки Тогда
			Объект.НаборУпаковок = Набор;
		КонецЕсли;
		Объект.СтавкаНДС = УчетНДСУП.СтавкаНДСОсновнойСтраны();
		Если Справочники.ГруппыДоступаНоменклатуры.ИспользуютсяГруппыДоступа()
			И Не ЗначениеЗаполнено(Объект.ГруппаДоступа) Тогда
			Объект.ГруппаДоступа = Справочники.ГруппыДоступаНоменклатуры.ПолучитьГруппуДоступаПоУмолчанию(Объект);
		КонецЕсли;
		Объект.Записать();
		Протокол.Добавить("Вид номенклатуры «" + Наименование + "»: " + ?(ЭтоНовый, "создано", "обновлено") + ".");
		Возврат Объект.Ссылка;
	Исключение
		Протокол.Добавить("Вид номенклатуры «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Процедура ОбеспечитьНоменклатуру(Наименование, Вид, Протокол)
	
	Попытка
		Ссылка = НайтиЭлементПоНаименованию("Номенклатура", Наименование);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.Номенклатура.СоздатьЭлемент();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		Объект.Наименование = Наименование;
		Объект.НаименованиеПолное = Наименование;
		Объект.ВидНоменклатуры = Вид;
		Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Объект);
		Объект.Записать();
		Протокол.Добавить("Номенклатура «" + Наименование + "»: " + ?(ЭтоНовый, "создано", "обновлено") + ".");
	Исключение
		Протокол.Добавить("Номенклатура «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьКратность(Вид, Кратность, Протокол)
	
	Попытка
		Менеджер = РегистрыСведений.тз_КратностьПродажи.СоздатьМенеджерЗаписи();
		Менеджер.ВидНоменклатуры = Вид;
		Менеджер.Прочитать();
		УжеБыла = Менеджер.Выбран() И Менеджер.Кратность = Кратность;
		Менеджер.ВидНоменклатуры = Вид;
		Менеджер.Кратность = Кратность;
		Менеджер.Записать();
		Протокол.Добавить("тз_КратностьПродажи для «" + Вид + "»: " + ?(УжеБыла, "уже " + Кратность, "записано " + Кратность) + ".");
	Исключение
		Протокол.Добавить("тз_КратностьПродажи: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьКратность(Вид, Протокол)
	
	Попытка
		Менеджер = РегистрыСведений.тз_КратностьПродажи.СоздатьМенеджерЗаписи();
		Менеджер.ВидНоменклатуры = Вид;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() Тогда
			Менеджер.Удалить();
			Протокол.Добавить("тз_КратностьПродажи для «" + Вид + "»: запись удалена.");
		Иначе
			Протокол.Добавить("тз_КратностьПродажи для «" + Вид + "»: записи нет.");
		КонецЕсли;
	Исключение
		Протокол.Добавить("тз_КратностьПродажи для «" + Вид + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

