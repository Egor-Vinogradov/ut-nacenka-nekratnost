// Настройка данных наценки за некратность. Вызывается с клиента общей командой.

#Область ПрограммныйИнтерфейс

// Создаёт или обновляет константы, внешнюю обработку, скидку, её действие и тестовую НСИ.
// Повторный запуск не плодит элементы: поиск по сохранённой ссылке или по наименованию «(тз)».
//
// Возвращаемое значение:
//  Строка - протокол шагов
//
Функция НастроитьНаценкуЗаНекратность() Экспорт
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Настройка наценки за некратность доступна только полноправному пользователю.'");
	КонецЕсли;
	
	Протокол = Новый Массив;
	
	НастроитьКонстанты(Протокол);
	Обработка = ЗарегистрироватьВнешнююОбработку(Протокол);
	Скидка = НастроитьСкидку(Обработка, Протокол);
	НастроитьДействиеСкидки(Скидка, Протокол);
	НастроитьНСИ(Протокол);
	
	Возврат СтрСоединить(Протокол, Символы.ПС);
	
КонецФункции

// Переносит чужие скидки корня в группу «Маркетинговые скидки (тз)»
// и ставит корню совместное применение «Сложение».
// Повторный запуск, если структура уже такая, ничего не пишет.
//
// Возвращаемое значение:
//  Строка - протокол
//
Функция ВключитьНаценкуПоверхСкидок() Экспорт
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Перестройка групп скидок доступна только полноправному пользователю.'");
	КонецЕсли;
	
	Протокол = Новый Массив;
	ПерестроитьГруппыСкидок(Протокол);
	Возврат СтрСоединить(Протокол, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура НастроитьКонстанты(Протокол)
	
	Попытка
		ТекущееЗначение = Константы.ИспользоватьАвтоматическиеСкидкиВПродажах.Получить();
		Если ТекущееЗначение = Истина Тогда
			Протокол.Добавить("Константа ИспользоватьАвтоматическиеСкидкиВПродажах: уже Истина.");
		Иначе
			Константы.ИспользоватьАвтоматическиеСкидкиВПродажах.Установить(Истина);
			Протокол.Добавить("Константа ИспользоватьАвтоматическиеСкидкиВПродажах: установлено Истина.");
		КонецЕсли;
	Исключение
		Протокол.Добавить("Константа ИспользоватьАвтоматическиеСкидкиВПродажах: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		Процент = Константы.тз_ПроцентНаценкиЗаНекратность.Получить();
		Если Не ЗначениеЗаполнено(Процент) Тогда
			Константы.тз_ПроцентНаценкиЗаНекратность.Установить(20);
			Протокол.Добавить("Константа тз_ПроцентНаценкиЗаНекратность: установлено 20.");
		Иначе
			Протокол.Добавить("Константа тз_ПроцентНаценкиЗаНекратность: уже " + Процент + ", без изменений.");
		КонецЕсли;
	Исключение
		Протокол.Добавить("Константа тз_ПроцентНаценкиЗаНекратность: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ЗарегистрироватьВнешнююОбработку(Протокол)
	
	ИмяОбъекта = "тз_РасчетНаценкиЗаНекратность";
	ИмяФайла = ИмяОбъекта + ".epf";
	
	Попытка
		ДвоичныеДанные = ПолучитьОбщийМакет("тз_ВнешняяОбработкаНаценки");
		АдресДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		
		Ссылка = НайтиОбработкуПоИмениОбъекта(ИмяОбъекта);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.ДополнительныеОтчетыИОбработки.СоздатьЭлемент();
			Объект.ИспользоватьДляФормыОбъекта = Истина;
			Объект.ИспользоватьДляФормыСписка = Истина;
			Объект.Ответственный = Пользователи.ТекущийПользователь();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		ПараметрыРегистрации = Новый Структура;
		ПараметрыРегистрации.Вставить("АдресДанныхОбработки", АдресДанных);
		ПараметрыРегистрации.Вставить("ЭтоОтчет", Ложь);
		ПараметрыРегистрации.Вставить("ИмяФайла", ИмяФайла);
		ПараметрыРегистрации.Вставить("ОтключатьКонфликтующие", Ложь);
		ПараметрыРегистрации.Вставить("ОтключатьПубликацию", Ложь);
		
		Объект.Публикация = Перечисления.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется;
		Результат = ДополнительныеОтчетыИОбработки.ЗарегистрироватьОбработку(Объект, ПараметрыРегистрации);
		Если Не Результат.Успех Тогда
			ТекстОшибки = Результат.ТекстОшибки;
			Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
				ТекстОшибки = Результат.КраткоеПредставлениеОшибки;
			КонецЕсли;
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
		Объект.ХранилищеОбработки = Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(9));
		Объект.ИмяОбъекта = ИмяОбъекта;
		Объект.ИмяФайла = ИмяФайла;
		Объект.Записать();
		
		Протокол.Добавить("ДополнительныеОтчетыИОбработки """ + ИмяОбъекта + """: " + ?(ЭтоНовый, "создано", "обновлено") + ".");
		Возврат Объект.Ссылка;
	Исключение
		Протокол.Добавить("ДополнительныеОтчетыИОбработки: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция НайтиОбработкуПоИмениОбъекта(ИмяОбъекта)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обработки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
	|ГДЕ
	|	Обработки.ИмяОбъекта = &ИмяОбъекта
	|	И НЕ Обработки.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	
КонецФункции

Функция НастроитьСкидку(Обработка, Протокол)
	
	Наименование = "Наценка за некратность упаковке (тз)";
	
	Если Не ЗначениеЗаполнено(Обработка) Тогда
		Протокол.Добавить("СкидкиНаценки """ + Наименование + """: пропущено, внешняя обработка не зарегистрирована.");
		Возврат Справочники.СкидкиНаценки.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		Ссылка = Константы.тз_СкидкаНаценкаЗаНекратность.Получить();
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Ссылка = НайтиЭлементПоНаименованию("СкидкиНаценки", Наименование);
		КонецЕсли;
		
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.СкидкиНаценки.СоздатьЭлемент();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Объект.Наименование = Наименование;
		Объект.Родитель = Справочники.СкидкиНаценки.КорневаяГруппа;
		Объект.СпособПредоставления = Обработка;
		Объект.Управляемая = Ложь;
		Объект.ВариантОтбораНоменклатуры = Перечисления.ВариантыОтбораНоменклатурыДляРасчетаСкидокНаценок.БезОграничений;
		Объект.ЗначениеСкидкиНаценки = -20;
		Объект.СпособПримененияСкидки = Перечисления.СпособыПримененияСкидокНаценок.ПрименитьВМоментРасчетаСкидокНаценок;
		Объект.Записать();
		
		Константы.тз_СкидкаНаценкаЗаНекратность.Установить(Объект.Ссылка);
		Протокол.Добавить("СкидкиНаценки """ + Наименование + """: " + ?(ЭтоНовый, "создано", "обновлено") + ".");
		Возврат Объект.Ссылка;
	Исключение
		Протокол.Добавить("СкидкиНаценки """ + Наименование + """: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.СкидкиНаценки.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Процедура НастроитьДействиеСкидки(Скидка, Протокол)
	
	Если Не ЗначениеЗаполнено(Скидка) Тогда
		Протокол.Добавить("ДействиеСкидокНаценок: пропущено, элемент скидки не записан.");
		Возврат;
	КонецЕсли;
	
	Попытка
		// Типизированная пустая ссылка. Неопределено в составное измерение не пишем:
		// в представлении записи пустая ссылка склада тоже выглядит пустой строкой.
		ПустойСклад = Справочники.Склады.ПустаяСсылка();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("СкидкаНаценка", Скидка);
		Запрос.УстановитьПараметр("Источник", ПустойСклад);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Срез.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ДействиеСкидокНаценок.СрезПоследних(
		|			&ТекущаяДата,
		|			СкидкаНаценка = &СкидкаНаценка
		|				И Источник = &Источник) КАК Срез";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий()
			И Выборка.Статус = Перечисления.СтатусыДействияСкидок.Действует Тогда
			Протокол.Добавить("ДействиеСкидокНаценок, пустой склад: уже действует.");
			Возврат;
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.ДействиеСкидокНаценок.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = '20000101';
		МенеджерЗаписи.Источник = ПустойСклад;
		МенеджерЗаписи.СкидкаНаценка = Скидка;
		МенеджерЗаписи.Статус = Перечисления.СтатусыДействияСкидок.Действует;
		МенеджерЗаписи.Ответственный = Пользователи.ТекущийПользователь();
		МенеджерЗаписи.Записать(Истина);
		Протокол.Добавить("ДействиеСкидокНаценок, пустой склад: записано, статус Действует, период 01.01.2000.");
	Исключение
		Протокол.Добавить("ДействиеСкидокНаценок: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура НастроитьНСИ(Протокол)
	
	Рулон = ОбеспечитьЕдиницуИзмерения("рулон", Протокол);
	Штука = НайтиШтуку();
	Если Не ЗначениеЗаполнено(Штука) Тогда
		Штука = ОбеспечитьЕдиницуИзмерения("шт", Протокол);
	Иначе
		Протокол.Добавить("Единица «шт»: уже есть.");
	КонецЕсли;
	
	Набор = Неопределено;
	Упаковка = Неопределено;
	Если ЗначениеЗаполнено(Рулон) Тогда
		Набор = ОбеспечитьНаборУпаковок(Рулон, Протокол);
		Если ЗначениеЗаполнено(Набор) Тогда
			Упаковка = ОбеспечитьУпаковку(Набор, Рулон, Протокол);
		КонецЕсли;
	КонецЕсли;
	
	ВидОбои = ОбеспечитьВидНоменклатуры("Обои (тз)", Рулон, Истина, Набор, Протокол);
	ВидОтходы = ОбеспечитьВидНоменклатуры("Брак и отходы (тз)", Штука, Ложь, Неопределено, Протокол);
	
	Если ЗначениеЗаполнено(ВидОбои) Тогда
		ЗаписатьКратность(ВидОбои, 4, Протокол);
		Если ЗначениеЗаполнено(Рулон) Тогда
			ОбеспечитьНоменклатуру("Обои Флизелин белые (тз)", ВидОбои, Протокол);
			ОбеспечитьНоменклатуру("Обои Винил бежевые (тз)", ВидОбои, Протокол);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидОтходы) Тогда
		УдалитьКратность(ВидОтходы, Протокол);
		ОбеспечитьНоменклатуру("Отходы обойные (тз)", ВидОтходы, Протокол);
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиШтуку()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Единицы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК Единицы
	|ГДЕ
	|	Единицы.Владелец = &Владелец
	|	И НЕ Единицы.ПометкаУдаления
	|	И Единицы.ТипИзмеряемойВеличины <> ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Упаковка)
	|	И (Единицы.Наименование = ""шт""
	|		ИЛИ Единицы.Наименование = ""Штука"")";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	
КонецФункции

Функция ОбеспечитьЕдиницуИзмерения(Наименование, Протокол)
	
	Попытка
		Ссылка = НайтиЕдиницу(Наименование);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Протокол.Добавить("Единица «" + Наименование + "»: уже есть.");
			Возврат Ссылка;
		КонецЕсли;
		
		Объект = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
		Объект.Владелец = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения;
		Объект.Наименование = Наименование;
		Объект.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
		Объект.Записать();
		Протокол.Добавить("Единица «" + Наименование + "»: создано.");
		Возврат Объект.Ссылка;
	Исключение
		Протокол.Добавить("Единица «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция НайтиЕдиницу(Наименование)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Единицы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК Единицы
	|ГДЕ
	|	Единицы.Владелец = &Владелец
	|	И Единицы.Наименование = &Наименование
	|	И НЕ Единицы.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	
КонецФункции

Функция ОбеспечитьНаборУпаковок(Рулон, Протокол)
	
	Наименование = "Обои (тз)";
	Попытка
		Ссылка = НайтиЭлементПоНаименованию("НаборыУпаковок", Наименование);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.НаборыУпаковок.СоздатьЭлемент();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		Объект.Наименование = Наименование;
		Объект.ЕдиницаИзмерения = Рулон;
		Объект.ЕдиницаДляОтчетов = Рулон;
		Объект.КоэффициентЕдиницыДляОтчетов = 1;
		Объект.Записать();
		Протокол.Добавить("Набор упаковок «" + Наименование + "»: " + ?(ЭтоНовый, "создано", "обновлено") + ".");
		Возврат Объект.Ссылка;
	Исключение
		Протокол.Добавить("Набор упаковок «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.НаборыУпаковок.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция ОбеспечитьУпаковку(Набор, Рулон, Протокол)
	
	Наименование = "Упаковка 4 рул.";
	Попытка
		Ссылка = НайтиУпаковку(Набор, Наименование);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
			Объект.Владелец = Набор;
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		Объект.Наименование = Наименование;
		Объект.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Упаковка;
		Объект.ТипУпаковки = Перечисления.ТипыУпаковокНоменклатуры.Конечная;
		Объект.Числитель = 4;
		Объект.Знаменатель = 1;
		Объект.ЕдиницаИзмерения = Рулон;
		Объект.Записать();
		Протокол.Добавить("Упаковка «" + Наименование + "»: " + ?(ЭтоНовый, "создано", "обновлено") + ".");
		Возврат Объект.Ссылка;
	Исключение
		Протокол.Добавить("Упаковка «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

