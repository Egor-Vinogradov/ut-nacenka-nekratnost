// Расчёт наценки за некратность. Модуль вызывается из внешней обработки
// в безопасном режиме, поэтому привилегированный режим здесь не включается.

#Область ПрограммныйИнтерфейс

// Процент наценки из константы. Пустое значение и ноль заменяются на 20.
//
// Возвращаемое значение:
//  Число
//
Функция ПроцентНаценки() Экспорт
	
	Процент = Константы.тз_ПроцентНаценкиЗаНекратность.Получить();
	Если Не ЗначениеЗаполнено(Процент) Тогда
		Возврат 20;
	КонецЕсли;
	
	Возврат Процент;
	
КонецФункции

// Кратность продажи по виду номенклатуры. В соответствие попадают только значения больше 1.
//
// Параметры:
//  МассивНоменклатуры - Массив из СправочникСсылка.Номенклатура
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ номенклатура, значение кратность
//
Функция КратностиНоменклатуры(МассивНоменклатуры) Экспорт
	
	Результат = Новый Соответствие;
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	КратностьПродажи.Кратность КАК Кратность
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.тз_КратностьПродажи КАК КратностьПродажи
	|		ПО Номенклатура.ВидНоменклатуры = КратностьПродажи.ВидНоменклатуры
	|ГДЕ
	|	Номенклатура.Ссылка В (&МассивНоменклатуры)
	|	И КратностьПродажи.Кратность > 1";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.Кратность);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Суммы наценки по строкам. Количество сворачивается по номенклатуре и характеристике.
// Наценка пишется на каждую строку группы, если суммарное количество группе не кратно.
//
// Параметры:
//  Товары - ТаблицаЗначений, Массив - поля Номенклатура, Характеристика, Количество, Сумма, КлючСвязи.
//           Сумма — база до скидок, Цена * КоличествоУпаковок. Из внешней обработки это уже
//           поле ПараметрыРасчета.Товары.Сумма. Контроль подставляет ту же базу сам.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки КлючСвязи, СуммаНаценки (положительное число)
//
Функция СуммыНаценки(Товары) Экспорт
	
	ТаблицаТоваров = ТаблицаСтрокТоваров(Товары);
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КлючСвязи", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СуммаНаценки", Новый ОписаниеТипов("Число"));
	
	Если ТаблицаТоваров.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	СвернутыеКоличества = ТаблицаТоваров.Скопировать();
	СвернутыеКоличества.Свернуть("Номенклатура, Характеристика", "Количество");
	
	МассивНоменклатуры = Новый Массив;
	Для Каждого СтрокаГруппы Из СвернутыеКоличества Цикл
		МассивНоменклатуры.Добавить(СтрокаГруппы.Номенклатура);
	КонецЦикла;
	Кратности = КратностиНоменклатуры(МассивНоменклатуры);
	
	НекратныеГруппы = Новый Соответствие;
	Для Каждого СтрокаГруппы Из СвернутыеКоличества Цикл
		Кратность = Кратности.Получить(СтрокаГруппы.Номенклатура);
		Если Кратность = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Оператор % в конфигурации встречается на целых количествах.
		// Для дробного количества остаток считаем через Цел.
		Остаток = СтрокаГруппы.Количество - Цел(СтрокаГруппы.Количество / Кратность) * Кратность;
		Если Остаток <> 0 Тогда
			НекратныеГруппы.Вставить(КлючГруппы(СтрокаГруппы.Номенклатура, СтрокаГруппы.Характеристика), Истина);
		КонецЕсли;
	КонецЦикла;
	
	Процент = ПроцентНаценки();
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		Ключ = КлючГруппы(СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика);
		Если НекратныеГруппы.Получить(Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.КлючСвязи = СтрокаТовара.КлючСвязи;
		НоваяСтрока.СуммаНаценки = Окр(СтрокаТовара.Сумма * Процент / 100, 2);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Таблица результата для движка скидок. Сумма наценки передаётся с минусом:
// положительная сумма в расшифровке уменьшает строку документа.
//
// Параметры:
//  СтрокаДерева - СтрокаДереваЗначений - строка дерева скидок, поле Ссылка
//  Товары - ТаблицаЗначений, Массив
//  ПараметрыРасчета - Структура - пустые таблицы результата, если движок их передал
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция РезультатРасчетаДляСкидок(СтрокаДерева, Товары, ПараметрыРасчета) Экспорт
	
	Результат = ПустаяТаблицаСкидок(ПараметрыРасчета);
	Суммы = СуммыНаценки(Товары);
	
	Для Каждого СтрокаНаценки Из Суммы Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.КлючСвязи = СтрокаНаценки.КлючСвязи;
		НоваяСтрока.Сумма = -СтрокаНаценки.СуммаНаценки;
		НоваяСтрока.Действует = Истина;
		
		Расшифровка = ПустаяТаблицаРасшифровки(ПараметрыРасчета);
		СтрокаРасшифровки = Расшифровка.Добавить();
		СтрокаРасшифровки.СкидкаНаценка = СтрокаДерева.Ссылка;
		СтрокаРасшифровки.Сумма = -СтрокаНаценки.СуммаНаценки;
		СтрокаРасшифровки.ЭтоСообщение = Ложь;
		НоваяСтрока.Расшифровка = Расшифровка;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Роль обхода контроля. Полноправный пользователь без этой роли контроль не обходит.
//
// Возвращаемое значение:
//  Булево
//
Функция ДоступенОбходКонтроля() Экспорт
	
	// РольДоступна смотрит роли пользователя ИБ и не включает обход из-за ПолныеПрава.
	// Пользователи.РолиДоступны для пользователя с ПолныеПрава и АдминистраторСистемы
	// возвращает Истина, не проверяя имя роли (Пользователи, строки 180–182).
	Возврат РольДоступна("тз_ИзменениеНаценкиЗаНекратность");
	
КонецФункции

// Контроль заказа, реализации и чека ККМ при проведении.
// Для уже пробитого чека отказ не ставится: предупреждение пишется в журнал регистрации.
//
// Параметры:
//  Объект - ДокументОбъект.ЗаказКлиента, ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.ЧекККМ
//  Отказ - Булево
//
Процедура ПроверитьДокументПродажи(Объект, Отказ) Экспорт
	
	Сообщения = Новый Массив;
	ПроверитьСтрокиПродажи(Объект, Сообщения);
	
	Если ЭтоПробитыйЧек(Объект) Тогда
		Если Сообщения.Количество() > 0 Тогда
			ЗаписатьПредупреждениеПробитогоЧека(Объект, Сообщения);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ВывестиСообщения(Объект, Сообщения, Отказ);
	
КонецПроцедуры

// Отчёт о розничных продажах: только цена строк с кратностью больше 1.
// Кратность по количеству не проверяется: строки отчёта агрегированы за смену,
// исходные чеки в них уже свёрнуты.
//
// Параметры:
//  Объект - ДокументОбъект.ОтчетОРозничныхПродажах
//  Отказ - Булево
//
Процедура ПроверитьОтчетОРозничныхПродажах(Объект, Отказ) Экспорт
	
	Кратности = КратностиНоменклатуры(НоменклатураДокумента(Объект));
	ВидЦеныШапки = Объект.ВидЦены;
	Сообщения = Новый Массив;
	
	Для Индекс = 0 По Объект.Товары.Количество() - 1 Цикл
		СтрокаТовара = Объект.Товары[Индекс];
		Если Кратности.Получить(СтрокаТовара.Номенклатура) = Неопределено Тогда
			ЗаписатьРешениеКонтроля(Объект, СтрокаТовара, Справочники.ВидыЦен.ПустаяСсылка(),
				"не определён", "не запрашивалась", "пропуск: нет кратности продажи");
			Продолжить;
		КонецЕсли;
		ПроверитьЦенуСтроки(Объект, СтрокаТовара, ВидЦеныШапки, "шапка", Сообщения);
	КонецЦикла;
	
	ВывестиСообщения(Объект, Сообщения, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТаблицаСтрокТоваров(Товары)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Характеристика");
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("КлючСвязи", Новый ОписаниеТипов("Число"));
	
	Для Каждого СтрокаИсточника Из Товары Цикл
		Если СтрокаИсточника.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Номенклатура = СтрокаИсточника.Номенклатура;
		НоваяСтрока.Характеристика = СтрокаИсточника.Характеристика;
		НоваяСтрока.Количество = СтрокаИсточника.Количество;
		НоваяСтрока.Сумма = СтрокаИсточника.Сумма;
		НоваяСтрока.КлючСвязи = СтрокаИсточника.КлючСвязи;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция КлючГруппы(Номенклатура, Характеристика)
	
	Возврат Строка(Номенклатура.УникальныйИдентификатор()) + "|" + Строка(Характеристика.УникальныйИдентификатор());
	
КонецФункции

Функция ПустаяТаблицаСкидок(ПараметрыРасчета)
	
	ИмяПоля = "ПустаяТаблицаСкидокСРасшифровкой";
	Если ТипЗнч(ПараметрыРасчета) = Тип("Структура")
		И ПараметрыРасчета.Свойство(ИмяПоля)
		И ТипЗнч(ПараметрыРасчета[ИмяПоля]) = Тип("ТаблицаЗначений") Тогда
		Возврат ПараметрыРасчета[ИмяПоля].СкопироватьКолонки();
	КонецЕсли;
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("КлючСвязи", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Расшифровка", Новый ОписаниеТипов("ТаблицаЗначений"));
	Таблица.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Действует", Новый ОписаниеТипов("Булево"));
	Возврат Таблица;
	
КонецФункции

Функция ПустаяТаблицаРасшифровки(ПараметрыРасчета)
	
	ИмяПоля = "ПустаяТаблицаРасшифровка";
	Если ТипЗнч(ПараметрыРасчета) = Тип("Структура")
		И ПараметрыРасчета.Свойство(ИмяПоля)
		И ТипЗнч(ПараметрыРасчета[ИмяПоля]) = Тип("ТаблицаЗначений") Тогда
		Возврат ПараметрыРасчета[ИмяПоля].СкопироватьКолонки();
	КонецЕсли;
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("СкидкаНаценка", Новый ОписаниеТипов("СправочникСсылка.СкидкиНаценки"));
	Таблица.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ЭтоСообщение", Новый ОписаниеТипов("Булево"));
	Возврат Таблица;
	
КонецФункции

Процедура ПроверитьСтрокиПродажи(Объект, Сообщения)
	
	Кратности = КратностиНоменклатуры(НоменклатураДокумента(Объект));
	Ожидаемые = ОжидаемыеНаценки(Объект, Кратности);
	Фактические = ФактическиеНаценки(Объект);
	ВидЦенСоглашения = ВидЦенСоглашенияДокумента(Объект);
	
	Для Индекс = 0 По Объект.Товары.Количество() - 1 Цикл
		
		СтрокаТовара = Объект.Товары[Индекс];
		Если Кратности.Получить(СтрокаТовара.Номенклатура) = Неопределено Тогда
			ЗаписатьРешениеКонтроля(Объект, СтрокаТовара, Справочники.ВидыЦен.ПустаяСсылка(),
				"не определён", "не запрашивалась", "пропуск: нет кратности продажи");
			Продолжить;
		КонецЕсли;
		
		Ожидаемая = Ожидаемые.Получить(СтрокаТовара.НомерСтроки);
		Если Ожидаемая = Неопределено Тогда
			Ожидаемая = 0;
		КонецЕсли;
		
		Фактическая = Фактические.Получить(СтрокаТовара.КлючСвязи);
		Если Фактическая = Неопределено Тогда
			Фактическая = 0;
		КонецЕсли;
		
		Если Макс(Ожидаемая - Фактическая, Фактическая - Ожидаемая) > 0.01 Тогда
			Текст = СтрШаблон(
				"Строка %1: наценка за некратность упаковке должна быть %2, в документе %3. Рассчитайте скидки (наценки).",
				СтрокаТовара.НомерСтроки,
				ФорматСуммы(Ожидаемая),
				ФорматСуммы(Фактическая));
			ДобавитьСообщение(Сообщения, Текст, СтрокаТовара.НомерСтроки, "Сумма");
		КонецЕсли;
		
		Если Ожидаемая > 0
			И (СтрокаТовара.ПроцентРучнойСкидки <> 0 Или СтрокаТовара.СуммаРучнойСкидки <> 0) Тогда
			Текст = СтрШаблон(
				"Строка %1: на строку с наценкой за некратность ручная скидка не допускается.",
				СтрокаТовара.НомерСтроки);
			ИмяПоля = ?(СтрокаТовара.ПроцентРучнойСкидки <> 0, "ПроцентРучнойСкидки", "СуммаРучнойСкидки");
			ДобавитьСообщение(Сообщения, Текст, СтрокаТовара.НомерСтроки, ИмяПоля);
		КонецЕсли;
		
		ОписаниеВидаЦены = ОписаниеВидаЦеныСтроки(Объект, СтрокаТовара, ВидЦенСоглашения);
		ПроверитьЦенуСтроки(Объект, СтрокаТовара, ОписаниеВидаЦены.ВидЦены, ОписаниеВидаЦены.Источник, Сообщения);
		
	КонецЦикла;
	
КонецПроцедуры

Функция БазаСуммыСтроки(СтрокаТовара)
	
	// Товары.Сумма документа — сумма после скидок. Движок и контроль считают наценку до них.
	Возврат СтрокаТовара.Цена * СтрокаТовара.КоличествоУпаковок;
	
КонецФункции

Функция НоваяТаблицаБазыНаценки()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Характеристика");
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("КлючСвязи", Новый ОписаниеТипов("Число"));
	Возврат Таблица;
	
КонецФункции

Функция ОжидаемыеНаценки(Объект, Кратности)
	
	Результат = Новый Соответствие;
	ЭтоРеализация = ТипЗнч(Объект) = Тип("ДокументОбъект.РеализацияТоваровУслуг");
	КоличестваЗаказов = ?(ЭтоРеализация, КоличестваЗаказовПоНоменклатуре(Объект), Новый Соответствие);
	Процент = ПроцентНаценки();
	ТаблицаБазы = НоваяТаблицаБазыНаценки();
	
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		
		Если Кратности.Получить(СтрокаТовара.Номенклатура) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоРеализация И ЗначениеЗаполнено(СтрокаТовара.ЗаказКлиента) Тогда
			КоличествоЗаказа = КоличестваЗаказов.Получить(КлючСтрокиЗаказа(СтрокаТовара));
			Если КоличествоЗаказа = Неопределено Тогда
				КоличествоЗаказа = 0;
			КонецЕсли;
			Кратность = Кратности.Получить(СтрокаТовара.Номенклатура);
			Остаток = КоличествоЗаказа - Цел(КоличествоЗаказа / Кратность) * Кратность;
			Если Остаток <> 0 Тогда
				Результат.Вставить(
					СтрокаТовара.НомерСтроки,
					Окр(БазаСуммыСтроки(СтрокаТовара) * Процент / 100, 2));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		СтрокаБазы = ТаблицаБазы.Добавить();
		СтрокаБазы.Номенклатура = СтрокаТовара.Номенклатура;
		СтрокаБазы.Характеристика = СтрокаТовара.Характеристика;
		СтрокаБазы.Количество = СтрокаТовара.Количество;
		СтрокаБазы.Сумма = БазаСуммыСтроки(СтрокаТовара);
		// СуммыНаценки отдаёт сумму по КлючСвязи. Здесь это номер строки:
		// у нескольких строк документа ключ связи ещё может быть нулём.
		СтрокаБазы.КлючСвязи = СтрокаТовара.НомерСтроки;
		
	КонецЦикла;
	
	Суммы = СуммыНаценки(ТаблицаБазы);
	Для Каждого СтрокаНаценки Из Суммы Цикл
		Результат.Вставить(СтрокаНаценки.КлючСвязи, СтрокаНаценки.СуммаНаценки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция КоличестваЗаказовПоНоменклатуре(Объект)
	
	Результат = Новый Соответствие;
	Заказы = Новый Массив;
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.ЗаказКлиента) И Заказы.Найти(СтрокаТовара.ЗаказКлиента) = Неопределено Тогда
			Заказы.Добавить(СтрокаТовара.ЗаказКлиента);
		КонецЕсли;
	КонецЦикла;
	Если Заказы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК ЗаказКлиента,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	СУММА(Товары.Количество) КАК Количество
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка В (&Заказы)
	|СГРУППИРОВАТЬ ПО
	|	Товары.Ссылка,
	|	Товары.Номенклатура,
	|	Товары.Характеристика";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(КлючСтрокиЗаказа(Выборка), Выборка.Количество);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция КлючСтрокиЗаказа(СтрокаТовара)
	
	Возврат Строка(СтрокаТовара.ЗаказКлиента.УникальныйИдентификатор())
		+ "|" + КлючГруппы(СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика);
	
КонецФункции

Функция ФактическиеНаценки(Объект)
	
	Результат = Новый Соответствие;
	НашаСкидка = Константы.тз_СкидкаНаценкаЗаНекратность.Получить();
	Если Не ЗначениеЗаполнено(НашаСкидка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого СтрокаСкидки Из Объект.СкидкиНаценки Цикл
		Если СтрокаСкидки.СкидкаНаценка <> НашаСкидка Тогда
			Продолжить;
		КонецЕсли;
		УжеЕсть = Результат.Получить(СтрокаСкидки.КлючСвязи);
		Если УжеЕсть = Неопределено Тогда
			УжеЕсть = 0;
		КонецЕсли;
		// В табличной части наценка хранится отрицательной суммой.
		Результат.Вставить(СтрокаСкидки.КлючСвязи, УжеЕсть - СтрокаСкидки.Сумма);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НоменклатураДокумента(Объект)
	
	МассивНоменклатуры = Новый Массив;
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
			И МассивНоменклатуры.Найти(СтрокаТовара.Номенклатура) = Неопределено Тогда
			МассивНоменклатуры.Добавить(СтрокаТовара.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Возврат МассивНоменклатуры;
	
КонецФункции

Функция ВидЦенСоглашенияДокумента(Объект)
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Соглашение")
		Или Не ЗначениеЗаполнено(Объект.Соглашение) Тогда
		Возврат Справочники.ВидыЦен.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Соглашение, "ВидЦен");
	
КонецФункции

Функция ОписаниеВидаЦеныСтроки(Объект, СтрокаТовара, ВидЦенСоглашения)
	
	Описание = Новый Структура("ВидЦены, Источник", Справочники.ВидыЦен.ПустаяСсылка(), "не определён");
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовара, "ВидЦены")
		И ЗначениеЗаполнено(СтрокаТовара.ВидЦены) Тогда
		Описание.ВидЦены = СтрокаТовара.ВидЦены;
		Описание.Источник = "строка";
		Возврат Описание;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидЦенСоглашения) Тогда
		Описание.ВидЦены = ВидЦенСоглашения;
		Описание.Источник = "соглашение";
		Возврат Описание;
	КонецЕсли;
	
	// Чек и отчёт о розничных продажах вид цен уровня не используют: у них остаётся вид цен шапки.
	Если ТипЗнч(Объект) <> Тип("ДокументОбъект.ЧекККМ")
		И ТипЗнч(Объект) <> Тип("ДокументОбъект.ОтчетОРозничныхПродажах")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Партнер") Тогда
		ВидЦенУровня = тз_УровниПокупателейСервер.ВидЦеныУровняПартнера(Объект.Партнер);
		Если ЗначениеЗаполнено(ВидЦенУровня) Тогда
			Описание.ВидЦены = ВидЦенУровня;
			Описание.Источник = "уровень";
			Возврат Описание;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ВидЦены")
		И ЗначениеЗаполнено(Объект.ВидЦены) Тогда
		Описание.ВидЦены = Объект.ВидЦены;
		Описание.Источник = "шапка";
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Процедура ПроверитьЦенуСтроки(Объект, СтрокаТовара, ВидЦены, Источник, Сообщения)
	
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		ЗаписатьРешениеКонтроля(Объект, СтрокаТовара, ВидЦены, Источник, "не запрашивалась",
			"пропуск: вид цен не определён");
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = ЦеныПредприятияЗаполнениеСервер.НовыйПараметрыОтбораПолучитьЦенуПоОтбору();
	ПараметрыОтбора.Дата = Объект.Дата;
	ПараметрыОтбора.Валюта = Объект.Валюта;
	ПараметрыОтбора.Номенклатура = СтрокаТовара.Номенклатура;
	ПараметрыОтбора.Характеристика = СтрокаТовара.Характеристика;
	ПараметрыОтбора.Упаковка = СтрокаТовара.Упаковка;
	ПараметрыОтбора.ВидЦены = ВидЦены;
	
	БазоваяЦена = ЦеныПредприятияЗаполнениеСервер.ПолучитьЦенуПоОтбору(ПараметрыОтбора);
	Если БазоваяЦена <= 0 И ЗначениеЗаполнено(СтрокаТовара.Упаковка) Тогда
		ПараметрыОтбора.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
		ЦенаБезУпаковки = ЦеныПредприятияЗаполнениеСервер.ПолучитьЦенуПоОтбору(ПараметрыОтбора);
		Если ЦенаБезУпаковки > 0 Тогда
			БазоваяЦена = Окр(ЦенаБезУпаковки * КоэффициентУпаковки(СтрокаТовара.Упаковка), 2);
		КонецЕсли;
		ПараметрыОтбора.Упаковка = СтрокаТовара.Упаковка;
	КонецЕсли;
	Если БазоваяЦена <= 0 Тогда
		ЗаписатьПропускЦены(Объект, СтрокаТовара, ВидЦены);
		ЗаписатьРешениеКонтроля(Объект, СтрокаТовара, ВидЦены, Источник, БазоваяЦена,
			"пропуск: базовая цена не найдена");
		Возврат;
	КонецЕсли;
	
	Если СтрокаТовара.Цена < БазоваяЦена - 0.01 Тогда
		Текст = СтрШаблон(
			"Строка %1: цена ниже цены по виду цен %2: %3.",
			СтрокаТовара.НомерСтроки,
			Строка(ВидЦены),
			ФорматСуммы(БазоваяЦена));
		ДобавитьСообщение(Сообщения, Текст, СтрокаТовара.НомерСтроки, "Цена");
		ЗаписатьРешениеКонтроля(Объект, СтрокаТовара, ВидЦены, Источник, БазоваяЦена, "ошибка");
	Иначе
		ЗаписатьРешениеКонтроля(Объект, СтрокаТовара, ВидЦены, Источник, БазоваяЦена, "ок");
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоПробитыйЧек(Объект)
	
	Если ТипЗнч(Объект) <> Тип("ДокументОбъект.ЧекККМ") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Объект.Статус = Перечисления.СтатусыЧековККМ.Пробит Или Объект.НомерЧекаККМ <> 0;
	
КонецФункции

Процедура ЗаписатьПредупреждениеПробитогоЧека(Объект, Сообщения)
	
	Тексты = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	
	ТекстЖурнала = СтрШаблон(
		"Чек %1, номер чека ККМ %2, уже пробит. Контроль наценки запись не останавливает. %3",
		Объект.Номер,
		Объект.НомерЧекаККМ,
		СтрСоединить(Тексты, " "));
	
	ЗаписьЖурналаРегистрации(
		"тз.НаценкаЗаНекратность",
		УровеньЖурналаРегистрации.Предупреждение,
		Объект.Метаданные(),
		Объект.Ссылка,
		ТекстЖурнала);
	
КонецПроцедуры

Процедура ДобавитьСообщение(Сообщения, Текст, НомерСтроки, ИмяПоля)
	
	Сообщение = Новый Структура("Текст, НомерСтроки, ИмяПоля", Текст, НомерСтроки, ИмяПоля);
	Сообщения.Добавить(Сообщение);
	
КонецПроцедуры

Процедура ВывестиСообщения(Объект, Сообщения, Отказ)
	
	Для Каждого Сообщение Из Сообщения Цикл
		ОбщегоНазначения.СообщитьПользователю(
			Сообщение.Текст,
			Объект,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Товары", Сообщение.НомерСтроки, Сообщение.ИмяПоля),
			,
			Отказ);
	КонецЦикла;
	
КонецПроцедуры

Функция КоэффициентУпаковки(Упаковка)
	
	Если Не ЗначениеЗаполнено(Упаковка) Тогда
		Возврат 1;
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Упаковка, "Числитель, Знаменатель");
	Если Не ЗначениеЗаполнено(Реквизиты.Числитель) Или Не ЗначениеЗаполнено(Реквизиты.Знаменатель)
		Или Реквизиты.Знаменатель = 0 Тогда
		Возврат 1;
	КонецЕсли;
	
	Возврат Реквизиты.Числитель / Реквизиты.Знаменатель;
	
КонецФункции

Процедура ЗаписатьПропускЦены(Объект, СтрокаТовара, ВидЦены)
	
	ТекстЖурнала = СтрШаблон(
		"Цена по виду цен не найдена, контроль цены строки пропущен. Документ %1, строка %2, номенклатура %3, вид цен %4, дата %5, упаковка %6, валюта %7.",
		Объект.Ссылка,
		СтрокаТовара.НомерСтроки,
		СтрокаТовара.Номенклатура,
		ВидЦены,
		Объект.Дата,
		СтрокаТовара.Упаковка,
		Объект.Валюта);
	
	ЗаписьЖурналаРегистрации(
		"тз.НаценкаЗаНекратность",
		УровеньЖурналаРегистрации.Информация,
		Объект.Метаданные(),
		Объект.Ссылка,
		ТекстЖурнала);
	
КонецПроцедуры

Функция ОтладкаКонтроляВключена()
	
	Попытка
		Возврат Константы.тз_ОтладкаКонтроля.Получить() = Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Процедура ЗаписатьПропускОбходом(Объект) Экспорт
	
	Если Не ОтладкаКонтроляВключена() Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЖурнала = СтрШаблон(
		"Контроль пропущен: доступна роль тз_ИзменениеНаценкиЗаНекратность. Документ %1.",
		Объект.Ссылка);
	ЗаписьЖурналаРегистрации(
		"тз.НаценкаЗаНекратность",
		УровеньЖурналаРегистрации.Информация,
		Объект.Метаданные(),
		Объект.Ссылка,
		ТекстЖурнала);
	
КонецПроцедуры

Процедура ЗаписатьРешениеКонтроля(Объект, СтрокаТовара, ВидЦены, Источник, БазоваяЦена, Итог)
	
	Если Не ОтладкаКонтроляВключена() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВидаЦен = "не определён";
	Если ЗначениеЗаполнено(ВидЦены) Тогда
		ИмяВидаЦен = Строка(ВидЦены);
	КонецЕсли;
	
	ТекстЖурнала = СтрШаблон(
		"Документ %1, строка %2, номенклатура %3. Вид цен: %4, источник: %5. Базовая цена: %6. Цена строки: %7. Итог: %8.",
		Объект.Ссылка,
		СтрокаТовара.НомерСтроки,
		СтрокаТовара.Номенклатура,
		ИмяВидаЦен,
		Источник,
		БазоваяЦена,
		СтрокаТовара.Цена,
		Итог);
	ЗаписьЖурналаРегистрации(
		"тз.НаценкаЗаНекратность",
		УровеньЖурналаРегистрации.Информация,
		Объект.Метаданные(),
		Объект.Ссылка,
		ТекстЖурнала);
	
КонецПроцедуры

Функция ФорматСуммы(Сумма)
	
	Возврат Формат(Сумма, "ЧДЦ=2; ЧН=0; ЧГ=0");
	
КонецФункции

#КонецОбласти
