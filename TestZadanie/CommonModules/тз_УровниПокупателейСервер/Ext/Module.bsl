// Уровни покупателей, сегменты, виды цен и соглашения.
// Привилегированный режим включается только на время записи регистров уровня и состава
// сегментов «тз … покупатели» и сразу выключается: обработчики &После("ПриЗаписи")
// выполняются при записи партнёра и контрагента любым пользователем.

#Область ПрограммныйИнтерфейс

// Уровень партнёра. Нет записи регистра — Бронзовый.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//
// Возвращаемое значение:
//  ПеречислениеСсылка.тз_УровниПокупателей
//
Функция УровеньПартнера(Партнер) Экспорт
	
	Состояние = СостояниеУровня(Партнер);
	Возврат Состояние.Уровень;
	
КонецФункции

// Текущий уровень и признак ручного задания.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//
// Возвращаемое значение:
//  Структура - Уровень, ЗаданВручную, ЕстьЗапись, Представление
//
Функция СостояниеУровня(Партнер) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Уровень", Перечисления.тз_УровниПокупателей.Бронзовый);
	Результат.Вставить("ЗаданВручную", Ложь);
	Результат.Вставить("ЕстьЗапись", Ложь);
	Результат.Вставить("Представление", "");
	
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Результат.Представление = "Партнёр не выбран.";
		Возврат Результат;
	КонецЕсли;
	
	Менеджер = РегистрыСведений.тз_УровниПартнеров.СоздатьМенеджерЗаписи();
	Менеджер.Партнер = Партнер;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() И ЗначениеЗаполнено(Менеджер.Уровень) Тогда
		Результат.Уровень = Менеджер.Уровень;
		Результат.ЗаданВручную = Менеджер.ЗаданВручную;
		Результат.ЕстьЗапись = Истина;
		Если Менеджер.ЗаданВручную Тогда
			Признак = "задан вручную";
		Иначе
			Признак = "по ИНН или по умолчанию";
		КонецЕсли;
		Результат.Представление = "Текущий уровень: " + Строка(Менеджер.Уровень) + ", " + Признак + ".";
	Иначе
		Результат.Представление = "Текущий уровень: Бронзовый, по умолчанию (записи нет).";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записывает уровень и переносит партнёра между тремя сегментами «тз … покупатели».
// Другие сегменты не изменяет. Повторный вызов с теми же данными ничего не пишет.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//  Уровень - ПеречислениеСсылка.тз_УровниПокупателей
//  ЗаданВручную - Булево
//
// Возвращаемое значение:
//  Булево - Истина, если регистр или состав сегментов изменились
//
Функция УстановитьУровеньПартнера(Партнер, Уровень, ЗаданВручную) Экспорт
	
	Если Не ЗначениеЗаполнено(Партнер) Или Не ЗначениеЗаполнено(Уровень) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	БылПривилегированный = ПривилегированныйРежим();
	Если Не БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Изменено = ЗаписатьУровеньПартнера(Партнер, Уровень, ЗаданВручную);
		Если ПеренестиМеждуСегментамиУровня(Партнер, Уровень) Тогда
			Изменено = Истина;
		КонецЕсли;
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	Исключение
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Изменено;
	
КонецФункции

// Уровень по ИНН. Нет строки — Неопределено.
//
// Параметры:
//  ИНН - Строка
//
// Возвращаемое значение:
//  ПеречислениеСсылка.тз_УровниПокупателей, Неопределено
//
Функция УровеньПоИНН(ИНН) Экспорт
	
	ИНН = СокрЛП(ИНН);
	Если ПустаяСтрока(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Менеджер = РегистрыСведений.тз_УровниПокупателейПоИНН.СоздатьМенеджерЗаписи();
	Менеджер.ИНН = ИНН;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Или Не ЗначениеЗаполнено(Менеджер.Уровень) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Менеджер.Уровень;
	
КонецФункции

// Если уровень партнёра не задан вручную и ИНН есть в регистре — устанавливает уровень.
// Ручной уровень не перезаписывает.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты, СправочникОбъект.Контрагенты
//
// Возвращаемое значение:
//  Булево - Истина, если уровень изменился
//
Функция ПрименитьУровеньПоИНН(Контрагент) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Контрагент) = Тип("СправочникОбъект.Контрагенты") Тогда
		Партнер = Контрагент.Партнер;
		ИНН = Контрагент.ИНН;
	Иначе
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "Партнер, ИНН");
		Партнер = Реквизиты.Партнер;
		ИНН = Реквизиты.ИНН;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Состояние = СостояниеУровня(Партнер);
	Если Состояние.ЕстьЗапись И Состояние.ЗаданВручную Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Уровень = УровеньПоИНН(ИНН);
	Если Уровень = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат УстановитьУровеньПартнера(Партнер, Уровень, Ложь);
	
КонецФункции

// Сбрасывает ручной признак и ставит уровень по ИНН контрагента, иначе Бронзовый.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//
// Возвращаемое значение:
//  Булево - Истина, если уровень изменился
//
Функция ОпределитьУровеньПоИНН(Партнер) Экспорт
	
	Уровень = Неопределено;
	ИНН = ИННПартнера(Партнер);
	Если ЗначениеЗаполнено(ИНН) Тогда
		Уровень = УровеньПоИНН(ИНН);
	КонецЕсли;
	Если Уровень = Неопределено Тогда
		Уровень = Перечисления.тз_УровниПокупателей.Бронзовый;
	КонецЕсли;
	
	Возврат УстановитьУровеньПартнера(Партнер, Уровень, Ложь);
	
КонецФункции

// Бронзовый для нового партнёра-клиента, у которого ещё нет записи уровня.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//  ЭтоКлиент - Булево
//
Процедура УстановитьБронзовыйНовомуПартнеру(Партнер, ЭтоКлиент) Экспорт
	
	Если Не ЭтоКлиент Или Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат;
	КонецЕсли;
	Если СостояниеУровня(Партнер).ЕстьЗапись Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьУровеньПартнера(Партнер, Перечисления.тз_УровниПокупателей.Бронзовый, Ложь);
	
КонецПроцедуры

// Разбирает CSV «ИНН;Уровень», пишет регистр и применяет уровень контрагентам.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные
//
// Возвращаемое значение:
//  Строка - протокол: загружено / ошибок / применено
//
Функция ЗагрузитьУровниИзДвоичныхДанных(ДвоичныеДанные) Экспорт
	
	Текст = ТекстCSV(ДвоичныеДанные);
	Загружено = 0;
	Ошибок = 0;
	Применено = 0;
	ПропущеноРучных = 0;
	СтрокиТекста = СтрРазделить(Текст, Символы.ПС, Ложь);
	ИННФайла = Новый Массив;
	ПерваяСтрока = Истина;
	
	Для Каждого СтрокаТекста Из СтрокиТекста Цикл
		
		СтрокаТекста = СокрЛП(СтрЗаменить(СтрокаТекста, Символы.ВК, ""));
		Если ПустаяСтрока(СтрокаТекста) Тогда
			Продолжить;
		КонецЕсли;
		
		Части = СтрРазделить(СтрокаТекста, ";");
		Если Части.Количество() < 2 Тогда
			Ошибок = Ошибок + 1;
			Продолжить;
		КонецЕсли;
		
		ИНН = СокрЛП(Части[0]);
		ИмяУровня = СокрЛП(Части[1]);
		Если ПерваяСтрока И Не ЭтоИНН(ИНН) Тогда
			ПерваяСтрока = Ложь;
			Продолжить;
		КонецЕсли;
		ПерваяСтрока = Ложь;
		
		Уровень = УровеньПоПредставлению(ИмяУровня);
		Если Уровень = Неопределено Или Не ЭтоИНН(ИНН) Тогда
			Ошибок = Ошибок + 1;
			Продолжить;
		КонецЕсли;
		
		ЗаписатьУровеньИНН(ИНН, Уровень);
		Загружено = Загружено + 1;
		ИННФайла.Добавить(ИНН);
		
	КонецЦикла;
	
	Если ИННФайла.Количество() > 0 Тогда
		ПрименитьИННККонтрагентам(ИННФайла, Применено, ПропущеноРучных);
	КонецЕсли;
	
	Возврат СтрШаблон(
		"Загружено: %1. Ошибок: %2. Применено: %3. Пропущено из-за ручного уровня: %4.",
		Загружено, Ошибок, Применено, ПропущеноРучных);
	
КонецФункции

// Идемпотентно создаёт виды цен, цены, сегменты, соглашения и тестовых покупателей.
//
// Возвращаемое значение:
//  Строка - протокол. «Обновлено» только при фактической записи.
//
Функция ЗаполнитьУровниИЦены() Экспорт
	
	Протокол = Новый Массив;
	
	Валюта = ДоходыИРасходыСервер.ПолучитьВалютуУправленческогоУчета();
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Справочники.Валюты.ПолучитьВалютуПоУмолчанию();
	КонецЕсли;
	
	Бронза = Перечисления.тз_УровниПокупателей.Бронзовый;
	Серебро = Перечисления.тз_УровниПокупателей.Серебряный;
	Золото = Перечисления.тз_УровниПокупателей.Золотой;
	
	ВидБронза = ОбеспечитьВидЦены("тз Бронзовый", "tzBronze", Истина, 0, Неопределено, Валюта, Протокол);
	ВидСеребро = ОбеспечитьВидЦены("тз Серебряный", "tzSilver", Ложь, -7, ВидБронза, Валюта, Протокол);
	ВидЗолото = ОбеспечитьВидЦены("тз Золотой", "tzGold", Ложь, -15, ВидБронза, Валюта, Протокол);
	
	УстановитьЦены(ВидБронза, ВидСеребро, ВидЗолото, Валюта, Протокол);
	
	СегментБронза = ОбеспечитьСегмент("тз Бронзовые покупатели", Протокол);
	СегментСеребро = ОбеспечитьСегмент("тз Серебряные покупатели", Протокол);
	СегментЗолото = ОбеспечитьСегмент("тз Золотые покупатели", Протокол);
	
	СоглашениеБронза = ОбеспечитьСоглашение("тз Бронзовый", ВидБронза, СегментБронза, Валюта, Протокол);
	СоглашениеСеребро = ОбеспечитьСоглашение("тз Серебряный", ВидСеребро, СегментСеребро, Валюта, Протокол);
	СоглашениеЗолото = ОбеспечитьСоглашение("тз Золотой", ВидЗолото, СегментЗолото, Валюта, Протокол);
	ЗаписатьСсылкиУровня(Бронза, СоглашениеБронза, ВидБронза, Протокол);
	ЗаписатьСсылкиУровня(Серебро, СоглашениеСеребро, ВидСеребро, Протокол);
	ЗаписатьСсылкиУровня(Золото, СоглашениеЗолото, ВидЗолото, Протокол);
	
	ЗаписатьУровеньИНН("7701000026", Серебро);
	ЗаписатьУровеньИНН("7701000033", Золото);
	Протокол.Добавить("Регистр ИНН: 7701000026 — Серебряный, 7701000033 — Золотой. 7701000019 в регистре нет.");
	
	ОбеспечитьПокупателя("тз Покупатель Бронза", "7701000019", Бронза, Протокол);
	ОбеспечитьПокупателя("тз Покупатель Серебро", "7701000026", Серебро, Протокол);
	ОбеспечитьПокупателя("тз Покупатель Золото", "7701000033", Золото, Протокол);
	
	Возврат СтрСоединить(Протокол, Символы.ПС);
	
КонецФункции

// Подменяет результат типового подбора, если вернулось не индивидуальное соглашение этого партнёра.
// Партнёр без записи уровня не меняется. Поля результата берёт ПродажиСервер.ПолучитьУсловияПродаж.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//  ПараметрыОтбора - Структура, Неопределено
//  СоглашенияПрименимы - Булево
//  Результат - Структура, Неопределено - то, что вернула типовая функция
//
// Возвращаемое значение:
//  Структура, Неопределено
//
Функция УсловияПродажПоУровню(Партнер, ПараметрыОтбора, СоглашенияПрименимы, Результат) Экспорт
	
	Если СоглашенияПрименимы = Ложь
		Или Не ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами")
		Или Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЭтоИндивидуальноеСоглашениеПартнера(Результат, Партнер) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Уровень = УровеньЗаписиПартнера(Партнер);
	Если Уровень = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Ссылки = СсылкиУровня(Уровень);
	Если Не ЗначениеЗаполнено(Ссылки.Соглашение) Тогда
		Возврат Результат;
	КонецЕсли;
	
	УчитыватьГруппы = Ложь;
	ИсключитьГруппы = Ложь;
	Если ТипЗнч(ПараметрыОтбора) = Тип("Структура") Тогда
		Если ПараметрыОтбора.Свойство("УчитыватьГруппыСкладов") Тогда
			УчитыватьГруппы = ПараметрыОтбора.УчитыватьГруппыСкладов;
		КонецЕсли;
		Если ПараметрыОтбора.Свойство("ИсключитьГруппыСкладовДоступныеВЗаказах") Тогда
			ИсключитьГруппы = ПараметрыОтбора.ИсключитьГруппыСкладовДоступныеВЗаказах;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПродажиСервер.ПолучитьУсловияПродаж(Ссылки.Соглашение, УчитыватьГруппы, ИсключитьГруппы);
	
КонецФункции

// Вид цен уровня. Нет записи в тз_УровниПартнеров — пустая ссылка.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыЦен
//
Функция ВидЦеныУровняПартнера(Партнер) Экспорт
	
	Уровень = УровеньЗаписиПартнера(Партнер);
	Если Уровень = Неопределено Тогда
		Возврат Справочники.ВидыЦен.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СсылкиУровня(Уровень).ВидЦены;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоИндивидуальноеСоглашениеПартнера(Результат, Партнер)
	
	Если ТипЗнч(Результат) <> Тип("Структура")
		Или Не Результат.Свойство("Соглашение")
		Или Не ЗначениеЗаполнено(Результат.Соглашение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Результат.Соглашение, "Типовое, Партнер");
	Возврат Не Реквизиты.Типовое И Реквизиты.Партнер = Партнер;
	
КонецФункции

Функция УровеньЗаписиПартнера(Партнер)
	
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	БылПривилегированный = ПривилегированныйРежим();
	Если Не БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Менеджер = РегистрыСведений.тз_УровниПартнеров.СоздатьМенеджерЗаписи();
		Менеджер.Партнер = Партнер;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() И ЗначениеЗаполнено(Менеджер.Уровень) Тогда
			Уровень = Менеджер.Уровень;
		Иначе
			Уровень = Неопределено;
		КонецЕсли;
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	Исключение
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Уровень;
	
КонецФункции

Функция СсылкиУровня(Уровень)
	
	Результат = Новый Структура("Соглашение, ВидЦены",
		Справочники.СоглашенияСКлиентами.ПустаяСсылка(),
		Справочники.ВидыЦен.ПустаяСсылка());
	Если Не ЗначениеЗаполнено(Уровень) Тогда
		Возврат Результат;
	КонецЕсли;
	
	БылПривилегированный = ПривилегированныйРежим();
	Если Не БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Менеджер = РегистрыСведений.тз_СоглашенияУровней.СоздатьМенеджерЗаписи();
		Менеджер.Уровень = Уровень;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() Тогда
			Результат.Соглашение = Менеджер.Соглашение;
			Результат.ВидЦены = Менеджер.ВидЦены;
		КонецЕсли;
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	Исключение
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьСсылкиУровня(Уровень, Соглашение, ВидЦены, Протокол)
	
	Если Не ЗначениеЗаполнено(Уровень) Или Не ЗначениеЗаполнено(Соглашение) Или Не ЗначениеЗаполнено(ВидЦены) Тогда
		Протокол.Добавить("Соглашение уровня «" + Строка(Уровень) + "»: пропуск, нет ссылки.");
		Возврат;
	КонецЕсли;
	
	БылПривилегированный = ПривилегированныйРежим();
	Если Не БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Менеджер = РегистрыСведений.тз_СоглашенияУровней.СоздатьМенеджерЗаписи();
		Менеджер.Уровень = Уровень;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() И Менеджер.Соглашение = Соглашение И Менеджер.ВидЦены = ВидЦены Тогда
			Протокол.Добавить("Соглашение уровня «" + Строка(Уровень) + "»: без изменений.");
		Иначе
			Менеджер.Уровень = Уровень;
			Менеджер.Соглашение = Соглашение;
			Менеджер.ВидЦены = ВидЦены;
			Менеджер.Записать();
			Протокол.Добавить("Соглашение уровня «" + Строка(Уровень) + "»: обновлено.");
		КонецЕсли;
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	Исключение
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		Протокол.Добавить("Соглашение уровня «" + Строка(Уровень) + "»: ошибка: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ЗаписатьУровеньПартнера(Партнер, Уровень, ЗаданВручную)
	
	Менеджер = РегистрыСведений.тз_УровниПартнеров.СоздатьМенеджерЗаписи();
	Менеджер.Партнер = Партнер;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() И Менеджер.Уровень = Уровень И Менеджер.ЗаданВручную = ЗаданВручную Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Менеджер.Партнер = Партнер;
	Менеджер.Уровень = Уровень;
	Менеджер.ЗаданВручную = ЗаданВручную;
	Менеджер.Записать();
	Возврат Истина;
	
КонецФункции

Функция ПеренестиМеждуСегментамиУровня(Партнер, Уровень)
	
	Имена = Новый Соответствие;
	Имена.Вставить(Перечисления.тз_УровниПокупателей.Бронзовый, "тз Бронзовые покупатели");
	Имена.Вставить(Перечисления.тз_УровниПокупателей.Серебряный, "тз Серебряные покупатели");
	Имена.Вставить(Перечисления.тз_УровниПокупателей.Золотой, "тз Золотые покупатели");
	
	НужноеИмя = Имена.Получить(Уровень);
	Изменено = Ложь;
	
	Для Каждого ПараИмени Из Имена Цикл
		Сегмент = Справочники.СегментыПартнеров.НайтиПоНаименованию(ПараИмени.Значение, Истина);
		Если Не ЗначениеЗаполнено(Сегмент) Тогда
			Продолжить;
		КонецЕсли;
		Если ПараИмени.Значение = НужноеИмя Тогда
			Если ОбеспечитьЗаписьСегмента(Сегмент, Партнер) Тогда
				Изменено = Истина;
			КонецЕсли;
		Иначе
			Если УдалитьЗаписьСегмента(Сегмент, Партнер) Тогда
				Изменено = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Изменено;
	
КонецФункции

Функция ОбеспечитьЗаписьСегмента(Сегмент, Партнер)
	
	Менеджер = РегистрыСведений.ПартнерыСегмента.СоздатьМенеджерЗаписи();
	Менеджер.Сегмент = Сегмент;
	Менеджер.Партнер = Партнер;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;
	Менеджер.Сегмент = Сегмент;
	Менеджер.Партнер = Партнер;
	Менеджер.Записать();
	Возврат Истина;
	
КонецФункции

Функция УдалитьЗаписьСегмента(Сегмент, Партнер)
	
	Менеджер = РегистрыСведений.ПартнерыСегмента.СоздатьМенеджерЗаписи();
	Менеджер.Сегмент = Сегмент;
	Менеджер.Партнер = Партнер;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;
	Менеджер.Удалить();
	Возврат Истина;
	
КонецФункции

Функция ЗаписатьУровеньИНН(ИНН, Уровень)
	
	БылПривилегированный = ПривилегированныйРежим();
	Если Не БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Менеджер = РегистрыСведений.тз_УровниПокупателейПоИНН.СоздатьМенеджерЗаписи();
		Менеджер.ИНН = ИНН;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() И Менеджер.Уровень = Уровень Тогда
			Изменено = Ложь;
		Иначе
			Менеджер.ИНН = ИНН;
			Менеджер.Уровень = Уровень;
			Менеджер.Записать();
			Изменено = Истина;
		КонецЕсли;
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	Исключение
		Если Не БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Изменено;
	
КонецФункции

Процедура ПрименитьИННККонтрагентам(ИННФайла, Применено, ПропущеноРучных)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.Партнер КАК Партнер,
	|	Контрагенты.ИНН КАК ИНН
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН В (&ИНН)
	|	И НЕ Контрагенты.ПометкаУдаления
	|	И Контрагенты.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ИНН", ИННФайла);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Состояние = СостояниеУровня(Выборка.Партнер);
		Если Состояние.ЕстьЗапись И Состояние.ЗаданВручную Тогда
			ПропущеноРучных = ПропущеноРучных + 1;
			Продолжить;
		КонецЕсли;
		Если ПрименитьУровеньПоИНН(Выборка.Ссылка) Тогда
			Применено = Применено + 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстCSV(ДвоичныеДанные)
	
	ТекстUTF8 = ТекстВКодировке(ДвоичныеДанные, КодировкаТекста.UTF8);
	Текст1251 = ТекстВКодировке(ДвоичныеДанные, "windows-1251");
	Если КоличествоРаспознанныхУровней(Текст1251) > КоличествоРаспознанныхУровней(ТекстUTF8) Тогда
		Возврат Текст1251;
	КонецЕсли;
	Возврат ТекстUTF8;
	
КонецФункции

Функция ТекстВКодировке(ДвоичныеДанные, Кодировка)
	
	Попытка
		Возврат ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, Кодировка);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция КоличествоРаспознанныхУровней(Текст)
	
	Количество = 0;
	Для Каждого СтрокаТекста Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Части = СтрРазделить(СокрЛП(СтрЗаменить(СтрокаТекста, Символы.ВК, "")), ";");
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Если УровеньПоПредставлению(СокрЛП(Части[1])) <> Неопределено Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
	
КонецФункции

Функция ЭтоИНН(ИНН)
	
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(ИНН) Цикл
		Символ = Сред(ИНН, Индекс, 1);
		Если Символ < "0" Или Символ > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция УровеньПоПредставлению(ИмяУровня)
	
	Ключ = НРег(СокрЛП(ИмяУровня));
	Если Ключ = "1" Или Ключ = "бронзовый" Тогда
		Возврат Перечисления.тз_УровниПокупателей.Бронзовый;
	ИначеЕсли Ключ = "2" Или Ключ = "серебряный" Тогда
		Возврат Перечисления.тз_УровниПокупателей.Серебряный;
	ИначеЕсли Ключ = "3" Или Ключ = "золотой" Тогда
		Возврат Перечисления.тз_УровниПокупателей.Золотой;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ИННПартнера(Партнер)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.ИНН КАК ИНН
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Партнер = &Партнер
	|	И НЕ Контрагенты.ПометкаУдаления
	|	И Контрагенты.ИНН <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагенты.ИНН";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.ИНН);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ОбеспечитьВидЦены(Наименование, Идентификатор, Вручную, Наценка, БазовыйВид, Валюта, Протокол)
	
	Попытка
		Ссылка = Справочники.ВидыЦен.НайтиПоНаименованию(Наименование, Истина);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.ВидыЦен.СоздатьЭлемент();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Изменено = ЭтоНовый;
		Изменено = УстановитьРеквизит(Объект, "Наименование", Наименование) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Идентификатор", Идентификатор) Или Изменено;
		Если Вручную Тогда
			Способ = Перечисления.СпособыЗаданияЦен.Вручную;
			База = Справочники.ВидыЦен.ПустаяСсылка();
		Иначе
			Способ = Перечисления.СпособыЗаданияЦен.НаценкаНаДругойВидЦен;
			База = БазовыйВид;
		КонецЕсли;
		Изменено = УстановитьРеквизит(Объект, "СпособЗаданияЦены", Способ) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "БазовыйВидЦены", База) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Наценка", Наценка) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Статус", Перечисления.СтатусыДействияВидовЦен.Действует) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВалютаЦены", Валюта) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ИспользоватьПриПродаже", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ИспользоватьПриОптовойПродаже", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ИспользоватьПриРозничнойПродаже", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВспомогательнаяЦена", Ложь) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "УстанавливатьЦенуПриВводеНаОсновании", Ложь) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Округлять", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВариантОкругления", Перечисления.ВариантыОкругления.ПоАрифметическимПравилам) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ТочностьОкругления", 0.01) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ЦенаВключаетНДС", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "СхемаКомпоновкиДанных", "Типовой") Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВариантУказанияСтавокНДС",
			Перечисления.ВариантыУказанияСтавокНДСВПрайсЛисте.НеУказыватьСтавкиНДС) Или Изменено;
		
		Если ПравилаОкругленияОтличаются(Объект) Тогда
			Объект.ПравилаОкругленияЦены.Очистить();
			Правило = Объект.ПравилаОкругленияЦены.Добавить();
			Правило.НижняяГраницаДиапазонаЦен = 0;
			Правило.ТочностьОкругления = 0.01;
			Правило.ПсихологическоеОкругление = 0;
			Изменено = Истина;
		КонецЕсли;
		
		Если Не Вручную И ЗначениеЗаполнено(БазовыйВид) Тогда
			Если ВлияющийВидОтличается(Объект, БазовыйВид) Тогда
				Объект.ВлияющиеВидыЦен.Очистить();
				СтрокаВлияния = Объект.ВлияющиеВидыЦен.Добавить();
				СтрокаВлияния.ВлияющийВидЦен = БазовыйВид;
				Изменено = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если Изменено Тогда
			Объект.Записать();
			Протокол.Добавить("Вид цен «" + Наименование + "»: обновлено.");
			Возврат Объект.Ссылка;
		КонецЕсли;
		
		Протокол.Добавить("Вид цен «" + Наименование + "»: без изменений.");
		Возврат Ссылка;
	Исключение
		Протокол.Добавить("Вид цен «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.ВидыЦен.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция ПравилаОкругленияОтличаются(Объект)
	
	Если Объект.ПравилаОкругленияЦены.Количество() <> 1 Тогда
		Возврат Истина;
	КонецЕсли;
	Правило = Объект.ПравилаОкругленияЦены[0];
	Возврат Правило.НижняяГраницаДиапазонаЦен <> 0
		Или Правило.ТочностьОкругления <> 0.01
		Или Правило.ПсихологическоеОкругление <> 0;
	
КонецФункции

Функция ВлияющийВидОтличается(Объект, БазовыйВид)
	
	Если Объект.ВлияющиеВидыЦен.Количество() <> 1 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Объект.ВлияющиеВидыЦен[0].ВлияющийВидЦен <> БазовыйВид;
	
КонецФункции

Функция УстановитьРеквизит(Объект, Имя, Значение)
	
	Если Объект[Имя] <> Значение Тогда
		Объект[Имя] = Значение;
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

Процедура УстановитьЦены(ВидБронза, ВидСеребро, ВидЗолото, Валюта, Протокол)
	
	Если Не ЗначениеЗаполнено(ВидБронза) Или Не ЗначениеЗаполнено(ВидСеребро) Или Не ЗначениеЗаполнено(ВидЗолото) Тогда
		Протокол.Добавить("Цены: пропуск, вид цен не создан.");
		Возврат;
	КонецЕсли;
	
	Имена = Новый Массив;
	Имена.Добавить("Обои Флизелин белые (тз)");
	Имена.Добавить("Обои Винил бежевые (тз)");
	Имена.Добавить("Отходы обойные (тз)");
	
	Номенклатура = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Ссылка = Справочники.Номенклатура.НайтиПоНаименованию(Имя, Истина);
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Протокол.Добавить("Цены: нет номенклатуры «" + Имя + "». Сначала выполните «тз Настроить наценку за некратность».");
			Возврат;
		КонецЕсли;
		Номенклатура.Добавить(Ссылка);
	КонецЦикла;
	
	ЦенаБронза = ОкруглитьЦенуВида(1000, ВидБронза);
	ЦенаСеребро = ОкруглитьЦенуВида(1000 * (1 - 7 / 100), ВидСеребро);
	ЦенаЗолото = ОкруглитьЦенуВида(1000 * (1 - 15 / 100), ВидЗолото);
	
	Цены = Новый Массив;
	ДобавитьЦену(Цены, Номенклатура, ВидБронза, ЦенаБронза);
	ДобавитьЦену(Цены, Номенклатура, ВидСеребро, ЦенаСеребро);
	ДобавитьЦену(Цены, Номенклатура, ВидЗолото, ЦенаЗолото);
	
	Для Каждого РозничныйВид Из РозничныеВидыЦенРМК(Протокол) Цикл
		Если РозничныйВид <> ВидБронза И РозничныйВид <> ВидСеребро И РозничныйВид <> ВидЗолото Тогда
			ДобавитьЦену(Цены, Номенклатура, РозничныйВид, 1000);
		КонецЕсли;
	КонецЦикла;
	
	Если ЦеныУжеУстановлены(Цены) Тогда
		Протокол.Добавить(СтрШаблон(
			"Цены: без изменений. тз Бронзовый %1, тз Серебряный %2, тз Золотой %3.",
			Формат(ЦенаБронза, "ЧДЦ=2; ЧГ=0"),
			Формат(ЦенаСеребро, "ЧДЦ=2; ЧГ=0"),
			Формат(ЦенаЗолото, "ЧДЦ=2; ЧГ=0")));
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗаписатьДокументЦен(Цены, Валюта);
		Протокол.Добавить(СтрШаблон(
			"Цены: обновлено. тз Бронзовый %1, тз Серебряный %2, тз Золотой %3.",
			Формат(ЦенаБронза, "ЧДЦ=2; ЧГ=0"),
			Формат(ЦенаСеребро, "ЧДЦ=2; ЧГ=0"),
			Формат(ЦенаЗолото, "ЧДЦ=2; ЧГ=0")));
	Исключение
		Протокол.Добавить("Цены: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ОкруглитьЦенуВида(Цена, ВидЦены)
	
	Цена = Окр(Цена, 2);
	ОбъектВида = ВидЦены.ПолучитьОбъект();
	Возврат УстановкаЦенКлиентСервер.ОкруглитьЦену(Цена, ОбъектВида);
	
КонецФункции

Процедура ДобавитьЦену(Цены, Номенклатура, ВидЦены, Цена)
	
	Для Каждого Элемент Из Номенклатура Цикл
		СтрокаЦены = Новый Структура("Номенклатура, ВидЦены, Цена", Элемент, ВидЦены, Цена);
		Цены.Добавить(СтрокаЦены);
	КонецЦикла;
	
КонецПроцедуры

Функция РозничныеВидыЦенРМК(Протокол)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Кассы.Наименование КАК Касса,
	|	Кассы.Склад.Наименование КАК Склад,
	|	Кассы.Склад.РозничныйВидЦены КАК ВидЦены,
	|	Кассы.Склад.РозничныйВидЦены.Наименование КАК ИмяВида,
	|	Кассы.Склад.РозничныйВидЦены.СпособЗаданияЦены КАК Способ
	|ИЗ
	|	Справочник.НастройкиРМК.КассыККМ КАК СтрокиНастроек
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КассыККМ КАК Кассы
	|		ПО СтрокиНастроек.КассаККМ = Кассы.Ссылка
	|ГДЕ
	|	НЕ СтрокиНастроек.Ссылка.ПометкаУдаления
	|	И НЕ Кассы.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Виды = Новый Массив;
	УжеДобавленные = Новый Соответствие;
	Если Выборка.Количество() = 0 Тогда
		Протокол.Добавить("РМК: касса в настройках РМК не найдена, розничная цена не записывается.");
		Возврат Виды;
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.ВидЦены) Тогда
			Протокол.Добавить("РМК: у склада «" + Выборка.Склад + "» кассы «" + Выборка.Касса
				+ "» розничный вид цен не заполнен, цена не записывается.");
			Продолжить;
		КонецЕсли;
		Если УжеДобавленные.Получить(Выборка.ВидЦены) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеДобавленные.Вставить(Выборка.ВидЦены, Истина);
		Виды.Добавить(Выборка.ВидЦены);
		Если Выборка.Способ = Перечисления.СпособыЗаданияЦен.Вручную Тогда
			Протокол.Добавить("РМК: розничный вид цен «" + Выборка.ИмяВида + "» кассы «" + Выборка.Касса
				+ "» задаётся вручную, для номенклатуры (тз) ставится 1000.");
		Иначе
			Протокол.Добавить("РМК, вид цен «" + Выборка.ИмяВида + "» склада «" + Выборка.Склад
				+ "»: записано в вычисляемый вид цен напрямую; регламент ОбновлениеЦен может пересчитать её от базового вида.");
		КонецЕсли;
	КонецЦикла;
	
	Возврат Виды;
	
КонецФункции

Функция ЦеныУжеУстановлены(Цены)
	
	Ценообразование25 = ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25();
	Для Каждого СтрокаЦены Из Цены Цикл
		Текущая = ТекущаяЦена(СтрокаЦены.Номенклатура, СтрокаЦены.ВидЦены, Ценообразование25);
		Если Текущая = Неопределено Или Окр(Текущая - СтрокаЦены.Цена, 2) <> 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

Функция ТекущаяЦена(Номенклатура, ВидЦены, Ценообразование25)
	
	Запрос = Новый Запрос;
	Если Ценообразование25 Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Цены.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(
		|			,
		|			Номенклатура = &Номенклатура
		|				И ВидЦены = &ВидЦены
		|				И ХарактеристикаЦО = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)
		|				И СерияЦО = ЗНАЧЕНИЕ(Справочник.СерииНоменклатурыДляЦенообразования.ПустаяСсылка)
		|				И УпаковкаЦО = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК Цены";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Цены.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			,
		|			Номенклатура = &Номенклатура
		|				И ВидЦены = &ВидЦены
		|				И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Цены";
	КонецЕсли;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаписатьДокументЦен(Цены, Валюта)
	
	Документ = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Статус = Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован;
	Документ.Согласован = Истина;
	Документ.Комментарий = "тз Заполнить уровни и цены";
	Если Метаданные.Документы.УстановкаЦенНоменклатуры.Реквизиты.Найти("Ответственный") <> Неопределено Тогда
		Документ.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	Виды = Новый Массив;
	Ценообразование25 = ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25();
	Для Каждого СтрокаЦены Из Цены Цикл
		Если Виды.Найти(СтрокаЦены.ВидЦены) = Неопределено Тогда
			Виды.Добавить(СтрокаЦены.ВидЦены);
			СтрокаВида = Документ.ВидыЦен.Добавить();
			СтрокаВида.ВидЦены = СтрокаЦены.ВидЦены;
		КонецЕсли;
		Если Ценообразование25 Тогда
			СтрокаТовара = Документ.Товары2_5.Добавить();
			СтрокаТовара.Номенклатура = СтрокаЦены.Номенклатура;
			СтрокаТовара.ВидЦены = СтрокаЦены.ВидЦены;
			СтрокаТовара.Цена = СтрокаЦены.Цена;
			СтрокаТовара.Валюта = Валюта;
			СтрокаТовара.ЦенаИзмененаВручную = Истина;
		Иначе
			СтрокаТовара = Документ.Товары.Добавить();
			СтрокаТовара.Номенклатура = СтрокаЦены.Номенклатура;
			СтрокаТовара.ВидЦены = СтрокаЦены.ВидЦены;
			СтрокаТовара.Цена = СтрокаЦены.Цена;
			СтрокаТовара.Валюта = Валюта;
			СтрокаТовара.ЦенаИзмененаВручную = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Функция ОбеспечитьСегмент(Наименование, Протокол)
	
	Попытка
		Ссылка = Справочники.СегментыПартнеров.НайтиПоНаименованию(Наименование, Истина);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.СегментыПартнеров.СоздатьЭлемент();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		Изменено = ЭтоНовый;
		Изменено = УстановитьРеквизит(Объект, "Наименование", Наименование) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "СпособФормирования",
			Перечисления.СпособыФормированияСегментов.ФормироватьВручную) Или Изменено;
		Если Изменено Тогда
			Объект.Записать();
			Протокол.Добавить("Сегмент «" + Наименование + "»: обновлено.");
			Возврат Объект.Ссылка;
		КонецЕсли;
		Протокол.Добавить("Сегмент «" + Наименование + "»: без изменений.");
		Возврат Ссылка;
	Исключение
		Протокол.Добавить("Сегмент «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.СегментыПартнеров.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция ОбеспечитьСоглашение(Наименование, ВидЦен, Сегмент, Валюта, Протокол)
	
	Если Не ЗначениеЗаполнено(ВидЦен) Или Не ЗначениеЗаполнено(Сегмент) Тогда
		Протокол.Добавить("Соглашение «" + Наименование + "»: пропуск, нет вида цен или сегмента.");
		Возврат Справочники.СоглашенияСКлиентами.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		Ссылка = Справочники.СоглашенияСКлиентами.НайтиПоНаименованию(Наименование, Истина);
		ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
		Если ЭтоНовый Тогда
			Объект = Справочники.СоглашенияСКлиентами.СоздатьЭлемент();
		Иначе
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Изменено = ЭтоНовый;
		Изменено = УстановитьРеквизит(Объект, "Наименование", Наименование) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Типовое", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ХозяйственнаяОперация",
			Перечисления.ХозяйственныеОперации.РеализацияКлиенту) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Статус", Перечисления.СтатусыСоглашенийСКлиентами.Действует) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Валюта", Валюта) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВалютаВзаиморасчетов", Валюта) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ИспользуютсяДоговорыКонтрагентов", Ложь) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ПорядокРасчетов", Перечисления.ПорядокРасчетов.ПоЗаказамНакладным) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ВидЦен", ВидЦен) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ИндивидуальныйВидЦены", Справочники.ВидыЦен.ПустаяСсылка()) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "СегментПартнеров", Сегмент) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "ЦенаВключаетНДС", Истина) Или Изменено;
		Изменено = УстановитьРеквизит(Объект, "Согласован", Истина) Или Изменено;
		
		График = ГрафикОплатыПоУмолчанию();
		Если ЗначениеЗаполнено(График) Тогда
			Изменено = УстановитьРеквизит(Объект, "ГрафикОплаты", График) Или Изменено;
		КонецЕсли;
		Организация = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию();
		Если ЗначениеЗаполнено(Организация) И Не ЗначениеЗаполнено(Объект.Организация) Тогда
			Объект.Организация = Организация;
			Изменено = Истина;
		КонецЕсли;
		
		Если Изменено Тогда
			Объект.ЗаполнитьСлужебныеРеквизитыДляОграниченияДоступа();
			Объект.Записать();
			Протокол.Добавить("Соглашение «" + Наименование + "»: обновлено.");
			Возврат Объект.Ссылка;
		КонецЕсли;
		Протокол.Добавить("Соглашение «" + Наименование + "»: без изменений.");
		Возврат Ссылка;
	Исключение
		Протокол.Добавить("Соглашение «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.СоглашенияСКлиентами.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция ГрафикОплатыПоУмолчанию()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Графики.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГрафикиОплаты КАК Графики
	|ГДЕ
	|	НЕ Графики.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ГрафикиОплаты.ПустаяСсылка();
	
КонецФункции

Процедура ОбеспечитьПокупателя(Наименование, ИНН, ОжидаемыйУровень, Протокол)
	
	Попытка
		Партнер = Справочники.Партнеры.НайтиПоНаименованию(Наименование, Истина);
		ПартнерНовый = Не ЗначениеЗаполнено(Партнер);
		Если ПартнерНовый Тогда
			Объект = Справочники.Партнеры.СоздатьЭлемент();
			Объект.Наименование = Наименование;
			Объект.НаименованиеПолное = Наименование;
			Объект.Клиент = Истина;
			Объект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
			Объект.ДатаРегистрации = ТекущаяДатаСеанса();
			Объект.ОсновнойМенеджер = Пользователи.ТекущийПользователь();
			ЗаполнитьГруппуДоступаПартнера(Объект);
			Объект.Записать();
			Партнер = Объект.Ссылка;
			Протокол.Добавить("Партнёр «" + Наименование + "»: обновлено.");
		Иначе
			Протокол.Добавить("Партнёр «" + Наименование + "»: без изменений.");
		КонецЕсли;
		
		Контрагент = НайтиКонтрагентаПартнера(Партнер);
		КонтрагентНовый = Не ЗначениеЗаполнено(Контрагент);
		Если КонтрагентНовый Тогда
			ОбъектКонтрагента = Справочники.Контрагенты.СоздатьЭлемент();
		Иначе
			ОбъектКонтрагента = Контрагент.ПолучитьОбъект();
		КонецЕсли;
		
		Изменено = КонтрагентНовый;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "Наименование", Наименование) Или Изменено;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "НаименованиеПолное", Наименование) Или Изменено;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "Партнер", Партнер) Или Изменено;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "ЮрФизЛицо", Перечисления.ЮрФизЛицо.ЮрЛицо) Или Изменено;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "ИНН", ИНН) Или Изменено;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "КПП", "770101001") Или Изменено;
		Изменено = УстановитьРеквизит(ОбъектКонтрагента, "ОбособленноеПодразделение", Ложь) Или Изменено;
		Если Не ЗначениеЗаполнено(ОбъектКонтрагента.СтранаРегистрации) Тогда
			ОбъектКонтрагента.СтранаРегистрации = ЗначениеНастроекКлиентСерверПовтИсп.ОсновнаяСтрана();
			Изменено = Истина;
		КонецЕсли;
		
		Если Изменено Тогда
			ОбъектКонтрагента.Записать();
			Контрагент = ОбъектКонтрагента.Ссылка;
			Протокол.Добавить("Контрагент «" + Наименование + "»: обновлено. ИНН " + ИНН + ".");
		Иначе
			Протокол.Добавить("Контрагент «" + Наименование + "»: без изменений.");
		КонецЕсли;
		
		Если Не СостояниеУровня(Партнер).ЕстьЗапись Тогда
			УстановитьУровеньПартнера(Партнер, Перечисления.тз_УровниПокупателей.Бронзовый, Ложь);
		КонецЕсли;
		ПрименитьУровеньПоИНН(Контрагент);
		
		Факт = СостояниеУровня(Партнер);
		Если Факт.Уровень = ОжидаемыйУровень И Не Факт.ЗаданВручную Тогда
			Протокол.Добавить("Уровень «" + Наименование + "»: " + Строка(Факт.Уровень) + ", не вручную.");
		ИначеЕсли Факт.ЗаданВручную Тогда
			Протокол.Добавить("Уровень «" + Наименование + "»: оставлен ручной " + Строка(Факт.Уровень) + ".");
		Иначе
			Протокол.Добавить("Уровень «" + Наименование + "»: ожидался " + Строка(ОжидаемыйУровень)
				+ ", фактически " + Строка(Факт.Уровень) + ".");
		КонецЕсли;
	Исключение
		Протокол.Добавить("Покупатель «" + Наименование + "»: ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьГруппуДоступаПартнера(Объект)
	
	Если Не Справочники.ГруппыДоступаПартнеров.ИспользуютсяГруппыДоступа() Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ГруппаДоступа) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Группы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГруппыДоступаПартнеров КАК Группы
	|ГДЕ
	|	НЕ Группы.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.ГруппаДоступа = Выборка.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиКонтрагентаПартнера(Партнер)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Партнер = &Партнер
	|	И НЕ Контрагенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

#КонецОбласти
